        "insertions": [],
        "deletions": [],
        "modifications": [
          {
            "line_number": 0,
            "modified_line": "import java.io.FilterInputStream;\nimport java.io.IOException;\nimport java.io.InputStream;\n\n/**\n * Input stream for decoding binary data using a Base-N codec.\n */\npublic class BaseNCodecInputStream extends FilterInputStream {\n\n    /**\n     * Codec used for decoding.\n     */\n    private final BaseNCodec codec;\n\n    /**\n     * Constructs a new input stream for decoding binary data using the specified codec.\n     *\n     * @param in    the InputStream to read from\n     * @param codec the BaseNCodec used for decoding\n     */\n    public BaseNCodecInputStream(InputStream in, BaseNCodec codec) {\n        super(in);\n        this.codec = codec;\n    }\n\n    /**\n     * Reads decoded data into a byte array.\n     *\n     * @param b the buffer into which the data is read\n     * @param off the start offset in the destination array {@code b}\n     * @param len the maximum number of bytes to read\n     * @return the total number of bytes read into the buffer, or -1 if there is no more data because the end of the stream has been reached\n     * @throws IOException if an I/O error occurs\n     */\n    @Override\n    public int read(byte[] b, int off, int len) throws IOException {\n        if (b == null) {\n            throw new NullPointerException(\"Byte array must not be null\");\n        } else if (off < 0 || len < 0 || off + len > b.length) {\n            throw new IndexOutOfBoundsException(\"Offset and length must be non-negative and not exceed the buffer length\");\n        } else if (len == 0) {\n            return 0;\n        }\n\n        int bytesRead = in.read(b, off, len);\n        if (bytesRead == -1) {\n            return -1;\n        }\n\n        try {\n            return codec.processInput(b, off, bytesRead);\n        } catch (Exception e) {\n            throw new IOException(\"Error processing input\", e);\n        }\n    }\n}"
          }
        ]
      }
    ]
  }
}
