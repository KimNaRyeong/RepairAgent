              "    protected void _appendLongName(int quadLen)",
              "    {",
              "        /* First things first: size of hash area. For maximum efficiency (speed-wise)",
              "         * we will be using at most 50% of space available; and for maximum",
              "         * size, at most 80% of space.",
              "         */",
              "        int newSize;",
              "        if (quadLen < 64) { // we'll never add more than half of the primary hash size",
              "            newSize = quadLen + quadLen; // 2 * size",
              "        } else if (quadLen < 256) { // nor more than 1/4 of secondary",
              "            newSize = quadLen + (quadLen >> 1); // 1.5 * size",
              "        } else {",
              "            // but if really big, try to contain overhead",
              "            newSize = quadLen + (quadLen >> 2); // 1.25 * size",
              "        }",
              "",
              "        // And then ensure we have at least minimum size as well",
              "        if (newSize < MIN_HASH_SIZE) {",
              "            newSize = MIN_HASH_SIZE;",
              "        } else if (newSize > MAX_T_SIZE) {",
              "            newSize = MAX_T_SIZE;",
              "        }",
              "    }"
            ]
          }
        ]
      }
    ]
  }
}
