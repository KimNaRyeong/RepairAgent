    public void parsePaxHeaders(String paxHeaders) {
        Map<String, String> parsedHeaders = new HashMap<>();

        // Check if paxHeaders is null or empty
        if (paxHeaders == null || paxHeaders.isEmpty()) {
            System.out.println("No PAX headers to parse.");
            return;
        }

        // Split the paxHeaders string by newline character
        String[] headerLines = paxHeaders.split("\n");

        // Iterate through each header line
        for (String headerLine : headerLines) {
            // Split each header line by ':' to separate key and value
            String[] parts = headerLine.split(":");

            if (parts.length == 2) {
                String key = parts[0].trim();
                String value = parts[1].trim();
                parsedHeaders.put(key, value);
