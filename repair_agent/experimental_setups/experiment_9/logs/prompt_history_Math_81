     * The Gershgorin circles are a geometric representation of the matrix eigenvalues.
     * @param matrix The square matrix for which Gershgorin circles are to be computed
     * @return An array of GershgorinCircle objects representing the circles
     */
    public static GershgorinCircle[] computeGershgorinCircles(double[][] matrix) {
        int n = matrix.length;
        GershgorinCircle[] circles = new GershgorinCircle[n];

        for (int i = 0; i < n; i++) {
            double radius = 0;
            double centerX = matrix[i][i];

            for (int j = 0; j < n; j++) {
                if (j != i) {
                    radius += Math.abs(matrix[i][j]);
                }
            }

            circles[i] = new GershgorinCircle(centerX, radius);
        }

        return circles;
    }
