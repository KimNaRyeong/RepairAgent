  "arguments": {
    "project_name": "Jsoup",
    "bug_index": "21",
    "changes_dicts": [
      {
        "file_name": "org/jsoup/select/QueryParser.java",
        "insertions": [
          {
            "line_number": 67,
            "new_lines": [
              "private Evaluator parseOr() {",
              "    Evaluator left = parseAnd();",
              "    while (tq.matchesAny(\",\")) {",
              "        tq.consume();",
              "        Evaluator right = parseAnd();",
              "        left = new CombiningEvaluator.Or(left, right);",
              "    }",
              "    return left;",
              "}",
              "",
              "private Evaluator parseAnd() {",
              "    Evaluator left = parseCondition();",
              "    while (!tq.isEmpty() && !tq.matchesAny(combinators)) {",
              "        Evaluator right = parseCondition();",
              "        left = new CombiningEvaluator.And(left, right);",
              "    }",
              "    return left;",
              "}",
              "",
              "private Evaluator parseCondition() {",
              "    if (tq.matchChomp(\"(\")) {",
              "        Evaluator sub = parse();",
              "        tq.chomp(\")\");",
              "        return sub;",
              "    } else {",
              "        if (tq.matchChomp(\":not\")) {",
              "            return new StructuralEvaluator.Not(parseCondition());",
              "        } else {",
              "            return parseSimple();",
              "        }",
              "    }",
              "}",
              "",
              "private Evaluator parseSimple() {",
              "    if (tq.matchChomp(\"*\")) {",
              "        return new Evaluator.AllElements();",
              "    } else if (tq.matchChomp(\"#\")) {",
              "        return new Evaluator.Id(tq.consumeIdentifier());",
              "    } else if (tq.matchesWord() || tq.matchesAny(combinators)) {",
              "        return new Evaluator.Tag(tq.consumeElementSelector());",
              "    } else if (tq.matches(\"[\") || tq.matchChomp(\":lt\") || tq.matchChomp(\":gt\")) {",
              "        return parseIndex();",
              "    } else if (tq.matchChomp(\":contains\")) {",
              "        return new Evaluator.ContainsText(tq.consumeText());",
              "    } else if (tq.matchChomp(\":containsOwn\")) {",
              "        return new Evaluator.ContainsOwnText(tq.consumeText());",
              "    } else if (tq.matchChomp(\":matches\")) {",
              "        return new Evaluator.Matches(Pattern.compile(tq.consumeRemainder()));",
              "    } else if (tq.matchChomp(\":matchesOwn\")) {",
              "        return new Evaluator.MatchesOwn(Pattern.compile(tq.consumeRemainder()));",
              "    }",
              "    throw new Selector.SelectorParseException(\"Could not parse query '%s': unexpected token at '%s'\", query, tq.remainder());",
              "}",
              "",
              "private Evaluator parseIndex() {",
              "    if (tq.matchChomp(\":lt\")) {",
              "        return new Evaluator.IndexLessThan(tq.consumeInt());",
              "    } else if (tq.matchChomp(\":gt\")) {",
              "        return new Evaluator.IndexGreaterThan(tq.consumeInt());",
              "    } else if (tq.matchChomp(\":eq\")) {",
              "        return new Evaluator.IndexEquals(tq.consumeInt());",
              "    } else {",
              "        Validate.isTrue(false, \"Child index out of bounds: %s\", query);",
              "        return null;",
              "    }",
              "}"
            ]
          }
        ],
        "deletions": [],
        "modifications": [
          {
            "line_number": 64,
            "modified_line": "or.add(parseOr()); // Refactored to use parseOr for handling commas"
          }
        ]
      }
    ]
