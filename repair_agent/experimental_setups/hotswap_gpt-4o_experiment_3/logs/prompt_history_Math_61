import org.apache.commons.math3.exception.NotStrictlyPositiveException;

/**
 * Implementation of the Poisson distribution.
 */
public class PoissonDistributionImpl extends AbstractIntegerDistribution {

    /** Mean of the distribution. */
    private final double mean;

    /**
     * Creates a new Poisson distribution with the specified mean.
     *
     * @param mean the mean of the distribution
     * @throws NotStrictlyPositiveException if mean is not strictly positive
     */
    public PoissonDistributionImpl(double mean) throws NotStrictlyPositiveException {
        if (mean <= 0.0) {
            throw new NotStrictlyPositiveException(mean);
        }
        this.mean = mean;
    }

    /**
     * Access the mean.
     *
     * @return the mean for this distribution.
     */
    public double getMean() {
        return mean;
    }

    @Override
    public double probability(int x) {
        if (x < 0) {
            return 0.0;
        }
        return Math.exp(-mean) * Math.pow(mean, x) / factorial(x);
    }

    /**
     * Computes the factorial of a non-negative integer.
     *
     * @param n the integer to compute the factorial of
     * @return n!
     */
    private static double factorial(int n) {
        if (n == 0) {
            return 1.0;
        }
        double result = 1.0;
        for (int i = 1; i <= n; i++) {
            result *= i;
        }
        return result;
    }

    @Override
    public double cumulativeProbability(int x) {
        if (x < 0) {
            return 0.0;
        }
        return Gamma.regularizedGammaQ(x + 1, mean, 1.0e-12, Integer.MAX_VALUE);
    }

    @Override
    public int inverseCumulativeProbability(double p) {
        if (p < 0.0 || p > 1.0) {
            throw new OutOfRangeException(p, 0, 1);
        }
        return (int) Math.floor(Gamma.regularizedGammaQInv(p, mean, 1.0e-12, Integer.MAX_VALUE));
    }

}
