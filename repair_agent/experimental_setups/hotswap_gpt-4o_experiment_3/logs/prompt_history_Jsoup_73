class NamespaceHelper {

    // Method to preserve namespaces of elements in a given HTML document
    public void namespacePreservation(Element element, Document document) {
        // Recursively add elements with namespaces to the given document
        addNamespacedElement(element, document);
    }

    // Helper method to recursively add elements with namespaces to the given document
    private void addNamespacedElement(Element element, Document document) {
        // Create a new element with the same tag name and namespace URI
        org.w3c.dom.Element newElement = document.createElementNS(element.namespaceURI(), element.tagName());

        // Copy attributes from the original element to the new element
        element.attributes().asList().forEach(attr -> newElement.setAttribute(attr.getKey(), attr.getValue()));

        // Append the new element to the document
        Node importedNode = document.importNode(newElement, true);
        document.getDocumentElement().appendChild(importedNode);

        // Recursively process child elements
        element.children().forEach(child -> addNamespacedElement(child, document));
    }
}
