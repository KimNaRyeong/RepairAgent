    public static String parseByteData(byte[] byteData) {
        ByteBuffer byteBuffer = ByteBuffer.wrap(byteData);
        byte[] bom = new byte[4]; // BOM is maximum 4 bytes
        int bomLength = Math.min(byteData.length, bom.length);
        byteBuffer.get(bom, 0, bomLength);
        
        Charset charset = Charset.forName(defaultCharset); // default to UTF-8
        if (bomLength >= 2 && ((bom[0] & 0xFF) == 0xFF) && ((bom[1] & 0xFF) == 0xFE)) {
            charset = Charset.forName("UTF-16LE");
        } else if (bomLength >= 2 && ((bom[0] & 0xFF) == 0xFE) && ((bom[1] & 0xFF) == 0xFF)) {
            charset = Charset.forName("UTF-16BE");
        } else if (bomLength == 3 && ((bom[0] & 0xFF) == 0xEF) && ((bom[1] & 0xFF) == 0xBB) && ((bom[2] & 0xFF) == 0xBF)) {
            charset = Charset.forName("UTF-8");
        }

        byte[] dataWithoutBom = new byte[byteData.length - bomLength];
        byteBuffer.get(dataWithoutBom, 0, byteData.length - bomLength);

        return new String(dataWithoutBom, charset);
    }
