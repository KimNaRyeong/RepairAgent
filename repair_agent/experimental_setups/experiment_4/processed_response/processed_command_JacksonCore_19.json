                                "    /**\n",
                                "     * Test method for {@link JsonParser#nextToken()} for long floating-point numbers\n",
                                "     * @throws IOException\n",
                                "     */\n",
                                "    public void testLongerFloatingPoint() throws IOException {\n",
                                "        final String input = \"12345678901234567890.12345678901234567890\";\n",
                                "        try (JsonParser p = JSON_FACTORY.createParser(new StringReader(input))) {\n",
                                "            assertToken(JsonToken.VALUE_NUMBER_FLOAT, p.nextToken());\n",
                                "            assertEquals(new BigDecimal(\"12345678901234567890.12345678901234567890\"), p.getDecimalValue());\n",
                                "        }\n",
                                "    }"
                            ]
