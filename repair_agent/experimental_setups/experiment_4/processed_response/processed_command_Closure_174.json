                                "    // Method to push a new scope onto the stack",
                                "    public void pushScope() {",
                                "        // Create a new HashMap to represent the new scope",
                                "        Map<String, Integer> newScope = new HashMap<>();",
                                "        // Add the new scope to the stack",
                                "        scopes.put(\"scope\" + scopes.size(), newScope);",
                                "    }"
                            ]
                        }
