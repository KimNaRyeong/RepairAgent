              "    // Update the namespaces of the given XML document",
              "    public static void updateNamespaces(Document document) throws TransformerException {",
              "        Element root = document.getDocumentElement();",
              "        updateNamespacesRecursive(root, null);",
              "    }",
              "",
              "    // Recursively update the namespaces of the elements in the XML document",
              "    private static void updateNamespacesRecursive(Element element, String namespace) {",
              "        if (element.getNamespaceURI() == null) {",
              "            element.setPrefix(null);",
              "        } else {",
              "            String currentNamespace = element.getNamespaceURI();",
              "            if (!currentNamespace.equals(namespace)) {",
              "                element.setPrefix(getPrefixForNamespace(element, currentNamespace));",
              "            }",
              "        }",
              "",
              "        for (int i = 0; i < element.getChildNodes().getLength(); i++) {",
              "            if (element.getChildNodes().item(i) instanceof Element) {",
              "                updateNamespacesRecursive((Element) element.getChildNodes().item(i), element.getNamespaceURI());",
              "            }",
              "        }",
              "    }",
              "",
              "    // Get the prefix for a given namespace",
              "    private static String getPrefixForNamespace(Element element, String namespace) {",
              "        String prefix = element.lookupPrefix(namespace);",
              "        if (prefix == null) {",
              "            prefix = \"ns\" + element.getAttributes().getLength(); // Generate a unique prefix",
              "        }",
              "        return prefix;",
              "    }"
            ]
          }
        ],
        "deletions": [],
        "modifications": []
      }
    ]
  }
