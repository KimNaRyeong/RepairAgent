        "modifications": [
          {
            "line_number": 580,
            "modified_line": "    public char[] expandCurrentSegment()\n    {\n        if (_segments == null) {\n            // Can expand in place since we own the buffer\n            char[] curr = _currentSegment;\n            if (curr == null) {\n                _currentSegment = findBuffer(0);\n            } else {\n                _currentSegment = findBuffer(curr.length);\n            }\n        } else {\n            // Otherwise, append segment to the segment list\n            _hasSegments = true;\n            _segmentSize += _currentSize;\n            int oldLen = _currentSegment.length;\n            int newLen = oldLen + (oldLen >> 1); // Double the size\n            char[] old = _currentSegment;\n            _currentSegment = findBuffer(newLen);\n            System.arraycopy(old, 0, _currentSegment, 0, oldLen);\n        }\n        _currentSize = 0;\n    }"
          }
        ]
      }
    ]
  }
}
