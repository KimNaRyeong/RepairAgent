              "    /**",
              "     * Copies safe nodes from source node to destination node while ensuring only allowed elements and attributes are copied.",
              "     *",
              "     * @param sourceNode      the source node containing the HTML to copy from",
              "     * @param destinationNode the destination node to copy the safe nodes to",
              "     * @param whitelist       the whitelist defining the allowed elements and attributes",
              "     */",
              "    public void copySafeNodes(Node sourceNode, Node destinationNode, Whitelist whitelist) {",
              "        Validate.notNull(sourceNode);",
              "        Validate.notNull(destinationNode);",
              "        Validate.notNull(whitelist);",
              "",
              "        List<Node> sourceChildren = sourceNode.childNodes();",
              "        for (Node sourceChild : sourceChildren) {",
              "            if (sourceChild instanceof Element) {",
              "                Element sourceElement = (Element) sourceChild;",
              "                if (whitelist.isSafeTag(sourceElement.tagName())) {",
              "                    Element destinationElement = new Element(Tag.valueOf(sourceElement.tagName()), sourceElement.baseUri(), sourceElement.attributes());",
              "                    destinationNode.appendChild(destinationElement);",
              "                    copySafeNodes(sourceElement, destinationElement, whitelist); // Recursively copy child nodes",
              "                } else {",
              "                    copySafeNodes(sourceElement, destinationNode, whitelist); // Skip element but copy its children",
              "                }",
              "            } else if (sourceChild instanceof TextNode) {",
              "                TextNode sourceText = (TextNode) sourceChild;",
              "                TextNode destinationText = new TextNode(sourceText.getWholeText(), sourceText.baseUri());",
              "                destinationNode.appendChild(destinationText);",
              "            }",
              "        }",
              "    }",
              "}"
