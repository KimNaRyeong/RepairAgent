              "    public static String unescape(String text) {",
              "        // Define the pattern for HTML entities",
              "        Pattern pattern = Pattern.compile(\"&(\\w+?);\");",
              "        // Define the map of HTML entities to special characters",
              "        Map<String, String> htmlEntities = new HashMap<>();",
              "        htmlEntities.put(\"amp\", \"&\");",
              "        htmlEntities.put(\"quot\", \"\\\"\");",
              "        htmlEntities.put(\"apos\", \"'\");",
              "        htmlEntities.put(\"lt\", \"<\");",
              "        htmlEntities.put(\"gt\", \">\");",
              "        // Create a matcher for the input text",
              "        Matcher matcher = pattern.matcher(text);",
              "        // Loop through each HTML entity and replace it with the corresponding special character",
              "        StringBuffer unescapedText = new StringBuffer();",
              "        while (matcher.find()) {",
              "            String entity = matcher.group(1);",
              "            String replacement = htmlEntities.get(entity);",
              "            if (replacement != null) {",
              "                matcher.appendReplacement(unescapedText, replacement);",
              "            }",
              "        }",
              "        matcher.appendTail(unescapedText);",
              "        return unescapedText.toString();",
              "    }"
            ]
          }
        ]
      }
    ]
  }
}
