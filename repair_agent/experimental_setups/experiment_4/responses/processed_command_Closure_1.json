        "modifications": [
          {
            "line_number": 379,
            "modified_line": "public void removeUnreferencedFunctionArgs(Node root) {\n    NodeTraversal.traversePostOrder(root, new AbstractPostOrderCallback() {\n        @Override\n        public void visit(NodeTraversal t, Node n, Node parent) {\n            if (n.isFunction()) {\n                Scope functionScope = t.getScope();\n                Set<String> referencedArgs = new HashSet<>();\n                for (Node arg : n.getParams()) {\n                    referencedArgs.add(arg.getString());\n                }\n                for (Node child : n.children()) {\n                    if (child.isName() && !referencedArgs.contains(child.getString())) {\n                        NodeUtil.removeChild(parent, child);\n                    }\n                }\n            }\n        }\n    });\n}"
          }
        ]
      }
    ]
  }
