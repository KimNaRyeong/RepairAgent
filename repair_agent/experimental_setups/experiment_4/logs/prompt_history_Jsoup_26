    private Set<String> tags;
    private Map<String, Set<String>> attributes;

    public Whitelist() {
        tags = new HashSet<>();
        attributes = new HashMap<>();
    }

    public Whitelist addTags(String... tagNames) {
        for (String tagName : tagNames) {
            tags.add(tagName);
        }
        return this;
    }

    public Whitelist addAttributes(String tag, String... attributeNames) {
        Set<String> tagAttributes = attributes.get(tag);
        if (tagAttributes == null) {
            tagAttributes = new HashSet<>();
            attributes.put(tag, tagAttributes);
        }
        for (String attributeName : attributeNames) {
            tagAttributes.add(attributeName);
        }
