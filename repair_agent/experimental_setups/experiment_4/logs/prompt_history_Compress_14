    /**
     * Parses a string representing an octal number and returns the decimal equivalent.
     *
     * @param octalNum the string representing an octal number
     * @return the decimal equivalent of the octal number
     */
    public static int parseOctal(String octalNum) {
        // Check if the input is null or empty
        if (octalNum == null || octalNum.isEmpty()) {
            throw new IllegalArgumentException("Input cannot be null or empty");
        }

        int decimalNum = 0;
        int length = octalNum.length();

        // Iterate through the octal number string from right to left
        for (int i = length - 1; i >= 0; i--) {
            char digitChar = octalNum.charAt(i);

            // Check if the character is a valid octal digit
            if (digitChar < '0' || digitChar > '7') {
                throw new IllegalArgumentException("Invalid octal digit: " + digitChar);
            }

            int digit = digitChar - '0';
            decimalNum += digit * Math.pow(8, length - 1 - i);
        }

        return decimalNum;
    }
