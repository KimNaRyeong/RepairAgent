    public <T> T foldSame(List<T> list, BiPredicate<T, T> eq, BinaryOperator<T> op) {
        Map<T, T> foldedMap = new HashMap<>();
        
        for (T element : list) {
            boolean foundEqual = false;
            for (Map.Entry<T, T> entry : foldedMap.entrySet()) {
                if (eq.test(entry.getKey(), element)) {
                    entry.setValue(op.apply(entry.getValue(), element));
                    foundEqual = true;
                    break;
                }
            }
            if (!foundEqual) {
                foldedMap.put(element, element);
            }
        }

        return foldedMap.values().stream().reduce(op).orElse(null);
