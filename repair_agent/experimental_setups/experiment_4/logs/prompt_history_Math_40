/**
 * Computes the growth or shrink factor based on the current and target values.
 * If current value is greater than target value, shrink factor is computed. 
 * If current value is less than target value, growth factor is computed.
 * 
 * @param currentValue the current value
 * @param targetValue the target value
 * @return the computed growth or shrink factor
 */
public double computeStepGrowShrinkFactor(double currentValue, double targetValue) {
    if (currentValue > targetValue) {
        return targetValue / currentValue;
    } else {
        return currentValue / targetValue;
    }
