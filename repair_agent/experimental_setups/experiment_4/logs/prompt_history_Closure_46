public class TypeUtils {
    
    // Define a method to get the least common supertype of two given types
    public static Class<?> getLeastSupertype(Class<?> type1, Class<?> type2) {
        Set<Class<?>> ancestors = new HashSet<>();
        
        // Add all ancestors of type1 to the set
        Class<?> current = type1;
        while (current != null) {
            ancestors.add(current);
            current = current.getSuperclass();
        }
        
        // Check ancestors of type2 to find the least common supertype
        current = type2;
        while (current != null) {
            if (ancestors.contains(current)) {
                return current;
            }
            current = current.getSuperclass();
        }
        
        // No common supertype found, return Object class
        return Object.class;
    }
}
