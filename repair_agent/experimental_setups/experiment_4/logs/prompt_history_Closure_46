public class TypeUtils {
    // Returns the least common supertype of the given set of types
    public static Class<?> getLeastSupertype(Set<Class<?>> types) {
        // Initialize the least common supertype to Object class
        Class<?> leastCommonSupertype = Object.class;

        // Iterate through each type in the set
        for (Class<?> type : types) {
            // Check if the current type is assignable to the current least common supertype
            if (leastCommonSupertype.isAssignableFrom(type)) {
                // Update the least common supertype if necessary
                if (!leastCommonSupertype.equals(Object.class) && !leastCommonSupertype.equals(type)) {
                    leastCommonSupertype = leastCommonSupertype.getSuperclass();
                }
            } else {
                // Find the common superclass between the current type and the current least common supertype
                while (!leastCommonSupertype.isAssignableFrom(type)) {
                    leastCommonSupertype = leastCommonSupertype.getSuperclass();
                }
            }
        }

        return leastCommonSupertype;
