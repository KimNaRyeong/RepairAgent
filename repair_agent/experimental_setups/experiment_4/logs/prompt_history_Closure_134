  private void computeRelatedTypes(JSType type) {
    if (type instanceof UnionType) {
      type = type.restrictByNotNullOrUndefined();
      if (type instanceof UnionType) {
        for (JSType alt : ((UnionType) type).getAlternates()) {
          computeRelatedTypes(alt);
