import org.apache.commons.math3.exception.DimensionMismatchException;
import org.apache.commons.math3.linear.RealVector;

public class JennrichSampsonFunction implements MultivariateFunction {

    /**
     * Computes the value of the Jennrich and Sampson function at the given point.
     *
     * @param point Point at which to evaluate the function.
     * @return The value of the Jennrich and Sampson function at the given point.
     * @throws DimensionMismatchException if the length of the input point is not 2.
     */
    @Override
    public double value(RealVector point) {
        if (point.getDimension() != 2) {
            throw new DimensionMismatchException(point.getDimension(), 2);
        }

        double x = point.getEntry(0);
        double y = point.getEntry(1);

        return 2 + Math.pow(2 - Math.exp(x) - Math.exp(y), 2);
