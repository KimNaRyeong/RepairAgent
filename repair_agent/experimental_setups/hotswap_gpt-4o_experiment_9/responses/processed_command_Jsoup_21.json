              "private Evaluator parseOr() {",
              "    List<Evaluator> evaluators = new ArrayList<Evaluator>();",
              "    while (true) {",
              "        Evaluator evaluator = parseAnd();",
              "        evaluators.add(evaluator);",
              "        if (!tq.matchChomp(\",\")) {",
              "            break;",
              "        }",
              "    }",
              "    if (evaluators.size() == 1) {",
              "        return evaluators.get(0);",
              "    } else {",
              "        return new CombiningEvaluator.Or(evaluators);",
              "    }",
              "}",
              "",
              "private Evaluator parseAnd() {",
              "    List<Evaluator> evaluators = new ArrayList<Evaluator>();",
              "    while (true) {",
              "        Evaluator evaluator = parseSelector();",
              "        if (evaluator == null) {",
              "            break;",
              "        }",
              "        evaluators.add(evaluator);",
              "    }",
              "    if (evaluators.size() == 1) {",
              "        return evaluators.get(0);",
              "    } else {",
              "        return new CombiningEvaluator.And(evaluators);",
              "    }",
              "}",
              "",
              "private Evaluator parseSelector() {",
              "    Evaluator evaluator;",
              "    if (tq.matches(\"(\")) {",
              "        tq.consume();",
              "        evaluator = parseOr();",
              "        tq.chomp(\")\");",
              "    } else {",
              "        evaluator = parseSimpleSelector();",
              "    }",
              "    return evaluator;",
              "}",
              "",
              "private Evaluator parseSimpleSelector() {",
              "    if (tq.matchChomp(\"*\")) {",
              "        return new Evaluator.AllElements();",
              "    } else if (tq.matchesWord()) {",
              "        return parseByTag();",
              "    } else if (tq.matches(\"[\") || tq.matches(\":lt(\")) {",
              "        return parseIndex();",
              "    } else if (tq.matches(\":matches(\")) {",
              "        return parseMatches(false);",
              "    } else if (tq.matches(\":matchesOwn(\")) {",
              "        return parseMatches(true);",
              "    } else if (tq.matches(\":contains(\")) {",
              "        return parseContains(false);",
              "    } else if (tq.matches(\":containsOwn(\")) {",
              "        return parseContains(true);",
              "    } else if (tq.matches(\":containsData(\")) {",
              "        return parseContainsData(false);",
              "    } else if (tq.matches(\":containsOwnData(\")) {",
              "        return parseContainsData(true);",
              "    } else if (tq.matches(\":containsKey(\")) {",
              "        return parseContainsKey(false);",
              "    } else if (tq.matches(\":containsOwnKey(\")) {",
              "        return parseContainsKey(true);",
              "    } else if (tq.matches(\":containsValue(\")) {",
              "        return parseContainsValue(false);",
              "    } else if (tq.matches(\":containsOwnValue(\")) {",
              "        return parseContainsValue(true);",
              "    } else if (tq.matches(\":matchesKey(\")) {",
              "        return parseMatchesKey(false);",
              "    } else if (tq.matches(\":matchesOwnKey(\")) {",
              "        return parseMatchesKey(true);",
              "    } else if (tq.matches(\":matchesValue(\")) {",
              "        return parseMatchesValue(false);",
              "    } else if (tq.matches(\":matchesOwnValue(\")) {",
