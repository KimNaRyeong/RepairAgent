    /**
     * Parses the Pax headers and returns a map of key-value pairs.
     * 
     * @param headers the Pax headers to parse
     * @return a map containing the key-value pairs parsed from the Pax headers
     */
    public Map<String, String> parsePaxHeaders(String headers) {
        Map<String, String> parsedHeaders = new HashMap<>();
        
        if (headers == null || headers.isEmpty()) {
            return parsedHeaders;
        }
        
        String[] headerPairs = headers.split(",");
