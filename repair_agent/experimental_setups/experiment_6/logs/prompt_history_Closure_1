public void removeUnreferencedFunctionArgs(AbstractCompiler compiler, Node fnNode) {
    Node paramList = fnNode.getSecondChild();
    Set<String> referencedArgs = new HashSet<>();
    
    // Traverse the function body to find referenced arguments
    NodeTraversal.traverse(compiler, fnNode.getLastChild(), new NodeTraversal.Callback() {
        @Override
        public boolean shouldTraverse(NodeTraversal nodeTraversal, Node n, Node parent) {
