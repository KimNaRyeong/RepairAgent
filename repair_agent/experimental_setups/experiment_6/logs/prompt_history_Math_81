    /**
     * Computes the Gershgorin circles for a given square matrix.
     * Gershgorin circles are used to determine the location of the eigenvalues of a matrix.
     * Reference: https://en.wikipedia.org/wiki/Gershgorin_circle_theorem
     *
     * @param matrix the square matrix for which Gershgorin circles need to be computed
     * @return an array of GershgorinCircle objects representing the circles
     */
    public static GershgorinCircle[] computeGershgorinCircles(double[][] matrix) {
        int n = matrix.length;
        GershgorinCircle[] circles = new GershgorinCircle[n];

        for (int i = 0; i < n; i++) {
            double centerX = matrix[i][i];
            double radius = 0.0;
            for (int j = 0; j < n; j++) {
                if (j != i) {
                    radius += Math.abs(matrix[i][j]);
                }
            }
            circles[i] = new GershgorinCircle(centerX, radius);
        }

        return circles;
    }
