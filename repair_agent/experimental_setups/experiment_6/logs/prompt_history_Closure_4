public void detectImplicitPrototypeCycle() {
    // Implementing a depth-first search algorithm to detect implicit prototype cycle
    Set<Object> visited = new HashSet<>();
    for (Object obj : prototypes.keySet()) {
        if (!visited.contains(obj)) {
            if (hasCycle(obj, visited, new HashSet<>())) {
                throw new IllegalStateException("Prototype cycle detected for object: " + obj);
            }
        }
    }
}

private boolean hasCycle(Object current, Set<Object> visited, Set<Object> recursionStack) {
    if (recursionStack.contains(current)) {
        return true;
    }
    if (!prototypes.containsKey(current)) {
        return false;
    }
    visited.add(current);
    recursionStack.add(current);
    for (Object neighbor : prototypes.get(current)) {
        if (hasCycle(neighbor, visited, recursionStack)) {
            return true;
        }
    }
    recursionStack.remove(current);
    return false;
}
