public class ArrayUtils {

    /**
     * Joins the elements of the given array into a single string using the specified delimiter.
     * If any element is null, it is treated as an empty string.
     *
     * @param array the array to join
     * @param delimiter the delimiter to use
     * @return a string that is the result of joining the elements of the array
