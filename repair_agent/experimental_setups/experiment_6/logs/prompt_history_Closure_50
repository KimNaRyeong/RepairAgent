    public static String tryFoldArrayJoin(Object[] array, String delimiter) {
        if (array == null) {
            return null;
        }

        return Arrays.stream(array)
                .map(e -> e == null ? "" : e.toString())
                .reduce((acc, elem) -> acc + delimiter + elem)
                .orElse("");
    }
