    public static Document parseInputStream(InputStream input, String charset, String baseUri) throws IOException {
        ConstrainableInputStream constrInput = ConstrainableInputStream.wrap(input, bufferSize, 0);
        constrInput.requestCapacity(firstReadBufferSize);

        ByteBuffer byteBuf = ByteBuffer.allocate(bufferSize);
        constrInput.read(byteBuf);

