    public void guessAOmega(double[] displacement, double[] timeIntervals) {
        // Calculate the average time interval
        double avgTimeInterval = 0;
        for (double time : timeIntervals) {
            avgTimeInterval += time;
        }
        avgTimeInterval /= timeIntervals.length;

        // Calculate the average displacement
        double avgDisplacement = 0;
        for (double disp : displacement) {
            avgDisplacement += disp;
