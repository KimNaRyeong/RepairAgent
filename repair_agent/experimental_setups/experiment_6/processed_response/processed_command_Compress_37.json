                                "// Adapted logic for parsing headers from input stream\n",
                                "Map<String, String> parsePaxHeaders(final InputStream i) throws IOException {\n",
                                "final Map<String, String> headers = new HashMap<>();\n",
                                "ByteArrayOutputStream headerLine = new ByteArrayOutputStream();\n",
                                "int ch;\n",
                                "while ((ch = i.read()) != -1) {\n",
                                "if (ch == '\\n') {\n",
                                "String header = headerLine.toString(CharsetNames.UTF_8);\n",
                                "int colonIndex = header.indexOf(':');\n",
                                "if (colonIndex != -1) {\n",
                                "String key = header.substring(0, colonIndex).trim();\n",
                                "String value = header.substring(colonIndex + 1).trim();\n",
                                "headers.put(key, value);\n",
                                "}\n",
                                "headerLine.reset();\n",
                                "} else {\n",
                                "headerLine.write(ch);\n",
                                "}\n",
                                "}\n",
                                "return headers;\n",
                                "}"
                            ]
                        }
                    ]
