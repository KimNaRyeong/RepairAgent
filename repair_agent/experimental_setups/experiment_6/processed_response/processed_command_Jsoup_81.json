                                "    private static Charset detectCharsetFromMeta(String charset, ByteBuffer byteBuf) {",
                                "        Charset docCharset = Charset.forName(charset);",
                                "        if (docCharset == null) {",
                                "            Matcher metaCharsetMatcher = charsetPattern.matcher(byteBuf.asCharBuffer());",
                                "            if (metaCharsetMatcher.find() && metaCharsetMatcher.group(1).length() > 0) {",
                                "                try {",
                                "                    docCharset = Charset.forName(validateCharset(metaCharsetMatcher.group(1)));",
                                "                } catch (IllegalCharsetNameException e) {",
                                "                    // use default charset if the charset extracted from meta is invalid",
                                "                    docCharset = Charset.forName(defaultCharset);",
                                "                }",
                                "            }",
                                "        }",
                                "        return docCharset;",
                                "    }",
                                "",
                                "    private static String validateCharset(String csName) {",
                                "        if (Charset.isSupported(csName)) {",
                                "            return csName;",
                                "        }",
                                "        // default to UTF-8 if the charset is not supported",
                                "        return defaultCharset;",
                                "    }"
                            ]
                        }
                    ]
                }
            ]
        }
