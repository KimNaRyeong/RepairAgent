                    "modifications": [
                        {
                            "line_number": 295,
                            "modified_line": "public static BigDecimal parseBigDecimal(char[] digitChars, int offset, int len) {\n        int scale = 0;\n        int end = offset + len;\n        int point = -1;\n        for (int i = offset; i < end; i++) {\n            if (digitChars[i] == '.') {\n                point = i;\n                break;\n            }\n        }\n        if (point != -1) {\n            scale = end - point - 1;\n        }\n        StringBuilder unscaledValue = new StringBuilder();\n        for (int i = offset; i < end; i++) {\n            if (i != point) {\n                unscaledValue.append(digitChars[i]);\n            }\n        }\n        return new BigDecimal(unscaledValue.toString()).scaleByPowerOfTen(-scale);\n    }"
                        }
                    ]
                }
            ]
        }
