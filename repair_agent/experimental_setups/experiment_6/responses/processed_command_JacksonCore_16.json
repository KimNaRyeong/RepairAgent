          {
            "line_number": 104,
            "modified_line": "    @Override\n    public JsonToken nextToken() throws IOException\n    {\n        // If current parser already has a token, don't call nextToken\n        if (_currToken == null) {\n            while (_nextParser < _parsers.length) {\n                JsonParser p = _parsers[_nextParser];\n                _currToken = p.nextToken();\n                if (_currToken != null) {\n                    return _currToken;\n                }\n                ++_nextParser;\n            }\n        }\n        return (_currToken = delegate.nextToken());\n    }"
          }
        ]
      }
    ]
  }
