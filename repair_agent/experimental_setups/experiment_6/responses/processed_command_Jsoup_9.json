              "    public static String unescape(String text) {",
              "        Map<String, Character> escapeMap = new HashMap<>();",
              "        escapeMap.put(\"amp\", '&');",
              "        escapeMap.put(\"lt\", '<');",
              "        escapeMap.put(\"gt\", '>');",
              "        escapeMap.put(\"quot\", '\"');",
              "        escapeMap.put(\"apos\", \"'\");",
              "",
              "        Pattern pattern = Pattern.compile(\"&(amp|lt|gt|quot|apos);\");",
              "        Matcher matcher = pattern.matcher(text);",
              "",
              "        StringBuffer unescapedString = new StringBuffer();",
              "        while (matcher.find()) {",
              "            String entity = matcher.group(1);",
              "            char value = escapeMap.get(entity);",
              "            matcher.appendReplacement(unescapedString, String.valueOf(value));",
              "        }",
              "        matcher.appendTail(unescapedString);",
              "",
              "        return unescapedString.toString();",
              "    }"
            ]
          }
        ]
      }
    ]
  }
}
