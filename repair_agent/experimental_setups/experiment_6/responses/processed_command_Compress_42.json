          {
            "line_number": 35,
            "new_lines": [
              "    /**",
              "     * Get Unix mode of a file.",
              "     *",
              "     * @param isReadable true if the file is readable, false otherwise",
              "     * @param isWritable true if the file is writable, false otherwise",
              "     * @param isExecutable true if the file is executable, false otherwise",
              "     * @return the Unix mode represented as an integer",
              "     */",
              "    public int getUnixMode(boolean isReadable, boolean isWritable, boolean isExecutable) {",
              "        int unixMode = 0;",
              "        ",
              "        // Add read permission",
              "        if (isReadable) {",
              "            unixMode |= 4; // 100 in binary",
              "        }",
              "        ",
              "        // Add write permission",
              "        if (isWritable) {",
              "            unixMode |= 2; // 010 in binary",
              "        }",
              "        ",
              "        // Add execute permission",
              "        if (isExecutable) {",
              "            unixMode |= 1; // 001 in binary",
              "        }",
              "        ",
              "        return unixMode;",
              "    }"
            ]
          }
        ],
        "deletions": [],
        "modifications": []
      }
    ]
  }
