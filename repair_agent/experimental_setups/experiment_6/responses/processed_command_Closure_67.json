        "file_name": "/workspaces/RepairAgent2/repair_agent/auto_gpt_workspace/closure_67_buggy/src/com/google/javascript/jscomp/AnalyzePrototypeProperties.java",
        "modifications": [
          {
            "line_number": 318,
            "modified_line": "// Checks if the given property is set directly on the object and not inherited from the prototype\npublic static boolean isPrototypePropertyAssign(Object obj, String propertyName) {\n    // Get the object's prototype\n    Object prototype = Object.getPrototypeOf(obj);\n    \n    // Check if the property is directly assigned on the object or on its prototype\n    return Object.hasOwnProperty(obj, propertyName) && !Object.hasOwnProperty(prototype, propertyName);\n}"
          }
        ]
      }
    ]
  }
}
