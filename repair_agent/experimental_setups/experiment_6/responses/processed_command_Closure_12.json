              "public boolean hasExceptionHandler(Class<?> clazz) {",
              "try {",
              "// Get all the methods declared in the class",
              "Method[] methods = clazz.getDeclaredMethods();",
              "// Iterate through all the methods",
              "for (Method method : methods) {",
              "// Check if the method has 'handleException' in its name and takes Exception as parameter",
