            "new_lines": [
              "    public static String unescape(String string) {",
              "        // define the regex pattern to match HTML entities",
              "        Pattern pattern = Pattern.compile(\"&(#[0-9]+|[a-zA-Z]+);\");",
              "        // create a matcher for the input string",
              "        Matcher matcher = pattern.matcher(string);",
              "        // use a StringBuilder to build the unescaped string",
              "        StringBuilder sb = new StringBuilder(string.length());",
              "        // iterate through the matches and replace them with their corresponding characters",
              "        while (matcher.find()) {",
              "            String group = matcher.group(1);",
              "            if (group.startsWith(\"#\")) {",
              "                // handle numeric entities",
              "                int codepoint = Integer.parseInt(group.substring(1));",
              "                sb.append((char) codepoint);",
              "            } else {",
              "                // handle named entities",
              "                String entityName = group;",
              "                if (Entities.isBaseNamedEntity(entityName)) {",
              "                    sb.append(Entities.getCharacterByName(entityName));",
              "                } else {",
              "                    // if the named entity is not a base entity, keep it unchanged",
              "                    sb.append(\"&\").append(entityName).append(\";\");",
              "                }",
              "            }",
              "        }",
              "        return sb.toString();",
              "    }"
            ]
          }
        ]
      }
    ]
  }
