              "// Fixing the issue related to handling text after script tag in parseStartTag method",
              "        // Returns true if the text node comes after a data node (not a comment or empty tag) in the given element.",
              "        // @param element the element to check for text node",
              "        // @return true if text node comes after data node, false otherwise",
              "        public boolean handlesTextAfterData(Element element) {",
              "            List<Node> children = element.childNodes();",
              "            boolean dataPassed = false;",
              "",
              "            for (Node child : children) {",
              "                if (child instanceof DataNode) {",
              "                    dataPassed = true;",
              "                } else if (child instanceof TextNode && dataPassed) {",
              "                    return true;",
              "                }",
              "            }",
              "",
              "            return false;",
              "        }"
            ]
          }
        ],
