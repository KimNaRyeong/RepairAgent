    public double[] getCorrelationPValues(double[][] correlationMatrix, int sampleSize) {
        int numVariables = correlationMatrix.length;
        double[] pValues = new double[numVariables * (numVariables - 1) / 2];
        PearsonsCorrelation pearsonsCorrelation = new PearsonsCorrelation();
