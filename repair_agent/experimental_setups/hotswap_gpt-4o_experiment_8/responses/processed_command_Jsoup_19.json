              "    public void preserveRelativeLinks(Element element, String baseUri) {",
              "        Validate.notNull(element);",
              "        Validate.notNull(baseUri);",
              "",
              "        // Find all elements with href attribute",
              "        Elements elementsWithHref = element.select(\"[href]\");",
              "",
              "        for (Element elem : elementsWithHref) {",
              "            String href = elem.attr(\"href\");",
              "",
              "            // Check if the link is relative",
              "            if (!href.startsWith(\"http\") && !href.startsWith(\"https\") && !href.startsWith(\"//\")) {",
              "                // Reconstruct the absolute path",
              "                String absoluteUrl = new URL(new URL(baseUri), href).toString();",
              "                elem.attr(\"href\", absoluteUrl);",
              "            }",
              "        }",
              "",
              "        // Find all elements with src attribute",
              "        Elements elementsWithSrc = element.select(\"[src]\");",
              "",
              "        for (Element elem : elementsWithSrc) {",
              "            String src = elem.attr(\"src\");",
              "",
              "            // Check if the link is relative",
              "            if (!src.startsWith(\"http\") && !src.startsWith(\"https\") && !src.startsWith(\"//\")) {",
              "                // Reconstruct the absolute path",
              "                String absoluteUrl = new URL(new URL(baseUri), src).toString();",
              "                elem.attr(\"src\", absoluteUrl);",
              "            }",
              "        }",
              "    }"
            ]
          }
        ]
      }
