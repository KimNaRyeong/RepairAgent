            "line_number": 215,
            "new_lines": [
              "    public static boolean isAssignable(Class<?> sourceClass, Class<?> targetClass) {",
              "        if (sourceClass == null && targetClass == null) {",
              "            return true;",
              "        }",
              "        if (targetClass == null) {",
              "            return false;",
              "        }",
              "        if (sourceClass.isPrimitive() && !targetClass.isPrimitive()) {",
              "            sourceClass = ClassUtils.primitiveToWrapper(sourceClass);",
              "            if (sourceClass == null) {",
              "                return false;",
              "            }",
              "        }",
              "        if (targetClass.isPrimitive() && !sourceClass.isPrimitive()) {",
              "            sourceClass = ClassUtils.wrapperToPrimitive(sourceClass);",
              "            if (sourceClass == null) {",
              "                return false;",
              "            }",
              "        }",
              "        if (sourceClass.equals(targetClass)) {",
              "            return true;",
              "        }",
              "        return targetClass.isAssignableFrom(sourceClass);",
              "    }"
            ]
          }
        ]
      }
    ]
  }
