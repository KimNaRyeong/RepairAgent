    public static String escapeJavaStyleString(String input) {
        if (input == null) {
            return null;
        }

        int len = input.length();
        StringBuilder out = new StringBuilder(len * 2);

        for (int i = 0; i < len; i++) {
            char ch = input.charAt(i);
            if (ch < 32 || ch > 126) {
                out.append("\\u");
                out.append(String.format("%04x", (int) ch));
            } else {
                switch (ch) {
                    case '"':
                        out.append("\\\"");
                        break;
                    case '\\':
                        out.append("\\\\");
                        break;
                    case '\b':
                        out.append("\\b");
                        break;
