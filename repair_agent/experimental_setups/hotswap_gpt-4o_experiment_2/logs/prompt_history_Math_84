    public void iterateSimplex(double[][] tableau, int objectiveRow, int minRatioPos) {
        int height = tableau.length;
        int width = tableau[0].length;

        // Divide the pivot row by the pivot value
        double pivotValue = tableau[objectiveRow][minRatioPos];
        for (int j = 0; j < width; j++) {
            tableau[objectiveRow][j] /= pivotValue;
        }

        // Subtract multiples of the pivot row from all other rows to zero out other entries in pivot column
        for (int i = 0; i < height; i++) {
            if (i != objectiveRow) {
                double factor = tableau[i][minRatioPos];
                for (int j = 0; j < width; j++) {
                    tableau[i][j] -= factor * tableau[objectiveRow][j];
                }
