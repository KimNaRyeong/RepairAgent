    /**
     * Copy safe nodes from source document to destination document. Safe nodes are cloned so the source document is not
     * modified. Any normalised text nodes will be cloned so the destination is clean of references to the source.
     *
     * @param source source document
     * @param dest destination document
     */
    public void copySafeNodes(Document source, Document dest) {
        Validate.notNull(source);
        Validate.notNull(dest);

        List<Node> sourceNodes = source.body().childNodes();
        Element destBody = dest.body();

        for (Node sourceNode : sourceNodes) {
            Node safeNode = processSafeNode(sourceNode);
            if (safeNode != null) {
                Node safeNodeCopy = safeNode.clone();
                destBody.appendChild(safeNodeCopy);
            }
        }
    }

    private Node processSafeNode(Node sourceNode) {
        if (sourceNode instanceof Element) {
            Element sourceElement = (Element) sourceNode;
            if (whitelist.isSafeTag(sourceElement.tagName())) {
                Element safeElement = Tag.valueOf(sourceElement.tagName()).builder().attributes(sourceElement.attributes()).parent(null).resetAttributes().build();
