              "    /**",
              "     * Updates namespace URIs in the given XML document.",
              "     *",
              "     * @param xmlDocument the XML document to update",
              "     * @param oldNamespace the old namespace URI to replace",
              "     * @param newNamespace the new namespace URI to set",
              "     * @throws ParserConfigurationException if a DocumentBuilder cannot be created",
              "     * @throws TransformerException if an error occurs during the transformation process",
              "     */",
              "    public void updateNamespaces(Document xmlDocument, String oldNamespace, String newNamespace) throws ParserConfigurationException, TransformerException {",
              "        Element rootElement = xmlDocument.getDocumentElement();",
              "        updateElementNamespace(rootElement, oldNamespace, newNamespace);",
              "",
              "        TransformerFactory transformerFactory = TransformerFactory.newInstance();",
              "        Transformer transformer = transformerFactory.newTransformer();",
              "        DOMSource source = new DOMSource(xmlDocument);",
              "        StreamResult result = new StreamResult(new StringWriter());",
              "        transformer.transform(source, result);",
              "    }",
              "",
              "    private void updateElementNamespace(Element element, String oldNamespace, String newNamespace) {",
              "        if (element.getNamespaceURI() != null && element.getNamespaceURI().equals(oldNamespace)) {",
              "            element.setPrefix(null);",
              "            element.setNamespaceURI(newNamespace);",
              "        }",
              "",
              "        Attributes attributes = new Attributes();",
              "        attributes.addAll(element.getAttributes());",
              "        for (Attribute attribute : attributes) {",
              "            if (attribute.getKey().startsWith(\"xmlns:\") && attribute.getValue().equals(oldNamespace)) {",
              "                element.removeAttribute(attribute.getKey());",
              "                element.setAttribute(\"xmlns:\" + attribute.getKey().substring(6), newNamespace);",
              "            }",
              "        }",
              "",
              "        for (int i = 0; i < element.getChildNodes().getLength(); i++) {",
              "            if (element.getChildNodes().item(i) instanceof Element) {",
              "                updateElementNamespace((Element) element.getChildNodes().item(i), oldNamespace, newNamespace);",
              "            }",
              "        }",
              "    }"
            ]
          }
        ]
      }
    ]
  }
