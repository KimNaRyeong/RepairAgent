              "    // Checks if a given JavaScript snippet may have side effects",
              "    public boolean mayHaveSideEffects(String jsSnippet) {",
              "        // Check for common keywords that indicate side effects",
              "        if (jsSnippet.contains(\"document.\") || jsSnippet.contains(\"console.\") || jsSnippet.contains(\"window.\")) {",
              "            return true;",
              "        }",
              "        // Check for common method calls that indicate side effects",
              "        if (jsSnippet.contains(\"alert(\") || jsSnippet.contains(\"confirm(\") || jsSnippet.contains(\"prompt(\")) {",
              "            return true;",
              "        }",
              "        // Check for common operations that indicate side effects",
              "        if (jsSnippet.contains(\"localStorage\") || jsSnippet.contains(\"sessionStorage\") || jsSnippet.contains(\"indexedDB\")) {",
              "            return true;",
              "        }",
              "        return false;",
              "    }"
            ]
          }
        ]
      }
    ]
  }
