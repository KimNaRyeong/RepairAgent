    public static String unescape(String string) {
        StringBuilder unescaped = new StringBuilder(string.length());

        // Regular expression pattern to match HTML entities
        Pattern pattern = Pattern.compile("&(#(x|X)?([0-9a-fA-F]+)|[a-zA-Z]+);");

        // Map of common HTML entities and their corresponding characters
        Map<String, String> entities = new HashMap<>();
        entities.put("amp", "&");
