        entities.put("gt", ">");
        entities.put("quot", "\"");
        entities.put("apos", "'");
        entities.put("nbsp", "\u00A0");

        Matcher matcher = pattern.matcher(string);
        int lastEnd = 0;

        while (matcher.find()) {
            // Append the characters between the last match and the current match
            unescaped.append(string, lastEnd, matcher.start());

            // Get the matched HTML entity
            String entity = matcher.group();

            // Check if the entity is a known HTML entity, if so, replace it with the corresponding character
            if (entities.containsKey(entity)) {
                unescaped.append(entities.get(entity));
            } else {
                // If the entity is not known, keep it as is
                unescaped.append(entity);
            }

            // Update the last match end position
            lastEnd = matcher.end();
        }

        // Append the remaining characters after the last match
        if (lastEnd < string.length()) {
            unescaped.append(string, lastEnd, string.length());
        }

        return unescaped.toString();
