     * Words are considered to be separated by spaces.
     * Non-letter characters are not included in the abbreviation.
     * 
     * @param input the input string to be abbreviated
     * @return the abbreviation of the input string
     */
    public String abbreviate(String input) {
        if (input == null || input.isEmpty()) {
            return "";
        }

        StringBuilder abbreviation = new StringBuilder();
        boolean isFirstChar = true;

        for (char c : input.toCharArray()) {
            if (Character.isLetter(c)) {
                if (isFirstChar) {
                    abbreviation.append(Character.toUpperCase(c));
                    isFirstChar = false;
