    public static int parseOctal(String octalString) {
        // Check if the input is null or empty
        if (octalString == null || octalString.isEmpty()) {
            throw new IllegalArgumentException("Input octal string is null or empty");
        }

        int decimalValue = 0;
        int length = octalString.length();

        // Iterate through each digit of the octal string
        for (int i = 0; i < length; i++) {
            char c = octalString.charAt(i);

            // Check if the character is a valid octal digit
            if (c < '0' || c > '7') {
                throw new IllegalArgumentException("Invalid octal digit found: " + c);
            }

            int digitValue = c - '0';

            // Calculate the decimal value using the formula
            decimalValue = decimalValue * 8 + digitValue;
        }

        return decimalValue;
    }
