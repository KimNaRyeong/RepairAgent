 * Calculates the geometric mean of an array of numbers.
 *
 * @param numbers the array of numbers
 * @return the geometric mean of the numbers
 */
public static double GeometricMean(double[] numbers) {
    if (numbers == null || numbers.length == 0) {
        throw new IllegalArgumentException("Input array must not be null or empty");
    }
    
    double product = 1.0;
    for (double num : numbers) {
        if (num <= 0) {
            throw new IllegalArgumentException("All numbers must be positive for geometric mean calculation");
        }
        product *= num;
    }
    
    return Math.pow(product, 1.0 / numbers.length);
}
