              "private Evaluator parseSelector() {",
              "    if (tq.matchChomp(\",\")) {",
              "        return new CombiningEvaluator.Or(evals);",
              "    } else if (tq.matchChomp(\"*\")) {",
              "        return AllElements.instance();",
              "    } else if (tq.matchChomp(\":lt(\")) {",
              "        return new IndexLessThanEvaluator(consumeIndex());",
              "    } else if (tq.matchChomp(\":gt(\")) {",
              "        return new IndexGreaterThanEvaluator(consumeIndex());",
              "    } else if (tq.matchChomp(\":eq(\")) {",
              "        return new IndexEqualsEvaluator(consumeIndex());",
              "    } else if (tq.matchesWord()) {",
              "        return Tag.valueOf(tq.consumeToAny(combinators));",
              "    } else {",
              "        throw new Selector.SelectorParseException(\"Could not parse query '%s': unexpected token at '%s'\", query, tq.remainder());",
              "    }",
              "}",
              "",
              "private int consumeIndex() {",
              "    String num = tq.consumeTo(')');",
              "    Validate.isTrue(StringUtil.isNumeric(num), \"Index must be numeric\");",
              "    return Integer.parseInt(num);",
              "}"
            ]
          }
