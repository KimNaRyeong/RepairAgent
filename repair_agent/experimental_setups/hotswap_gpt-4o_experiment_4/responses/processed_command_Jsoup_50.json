              "        // Check for BOM and adjust charset accordingly\n",
              "        if (byteData.remaining() >= 3) {\n",
              "            byte[] bom = new byte[3];\n",
              "            byteData.get(bom);\n",
              "            if ((bom[0] & 0xFF) == 0xEF && (bom[1] & 0xFF) == 0xBB && (bom[2] & 0xFF) == 0xBF) {\n",
              "                charsetName = \"UTF-8\";\n",
              "            }\n",
              "            byteData.rewind();\n",
