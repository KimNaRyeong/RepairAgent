public class RectangularCholeskyDecomposition {

    /** Row-oriented storage for L. */
    private final double[][] lTData;

    /**
     * Creates a new {@link RectangularCholeskyDecomposition}.
     *
     * @param matrix The matrix to be decomposed.
     * @param small The cutoff for considering a diagonal element as zero.
     */
    public RectangularCholeskyDecomposition(RealMatrix matrix, double small) {
        // Perform Cholesky decomposition here
        // Get matrix dimensions
        int n = matrix.getRowDimension();
        int m = matrix.getColumnDimension();

        if (n < m) {
            throw new IllegalArgumentException("Input matrix is not valid for Cholesky decomposition.");
        }

        // Initialize L^T matrix
        lTData = new double[m][m];

        // Perform Cholesky decomposition
        for (int j = 0; j < m; j++) {
            double d = 0.0;
            for (int k = 0; k < j; k++) {
                double s = 0.0;
                for (int i = 0; i < k; i++) {
                    s += lTData[j][i] * lTData[k][i];
                }
                lTData[j][k] = s = (matrix.getEntry(j, k) - s) / lTData[k][k];
                d = d + s * s;
            }
            d = matrix.getEntry(j, j) - d;
            if (d <= small) {
                throw new IllegalArgumentException("Matrix is not positive definite.");
            }
            lTData[j][j] = Math.sqrt(d);
        }
