                DataNode sourceData = (DataNode) sourceChild;
                DataNode destinationData = new DataNode(sourceData.getWholeData(), sourceChild.baseUri());
                dest.appendChild(destinationData);
                numCopied++;
            }
        }
        return numCopied;
    }

