public class MathUtils {

    /**
     * Returns the binomial coefficient "n choose k" as a double.
     *
     * @param n the total number of items
     * @param k the number of items to choose
     * @return the binomial coefficient as a double
     */
    public static double binomialCoefficientDouble(int n, int k) {
        if (k < 0 || k > n) {
            return 0;
        }
        
        k = Math.min(k, n - k); // take advantage of symmetry
        if (k == 0) {
            return 1;
        }
        
        double[] c = new double[k + 1];
        Arrays.fill(c, 1.0);

        for (int i = 1; i <= n - k; i++) {
            for (int j = 1; j <= k; j++) {
                c[j] += c[j - 1];
            }
        }

        return c[k];
    }
}
