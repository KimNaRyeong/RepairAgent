    /**
     * Returns the binomial coefficient "n choose k" as a double value.
     * The binomial coefficient is the number of ways to choose k elements from a set of n elements.
     * This implementation calculates the binomial coefficient using factorials.
     *
     * @param n the total number of elements
     * @param k the number of elements to choose
     * @return the binomial coefficient "n choose k" as a double value
     */
    public double binomialCoefficientDouble(int n, int k) {
        if (k < 0 || k > n) {
            return 0;
        }
        
        if (k == 0 || k == n) {
            return 1;
        }
        
        // Calculate n!
        double numerator = 1;
        for (int i = 1; i <= n; i++) {
            numerator *= i;
        }
        
        // Calculate k!
        double denominator1 = 1;
        for (int i = 1; i <= k; i++) {
            denominator1 *= i;
        }
        
        // Calculate (n-k)!
        double denominator2 = 1;
        for (int i = 1; i <= n - k; i++) {
            denominator2 *= i;
        }
        
        // Calculate n! / (k! * (n-k)!)
        return numerator / (denominator1 * denominator2);
    }
