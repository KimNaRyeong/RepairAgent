     * @param octalString a string representing an octal number
     * @return the decimal equivalent of the octal number
     */
    public int parseOctal(String octalString) {
        // Check if the input string is null or empty
        if (octalString == null || octalString.isEmpty()) {
            throw new IllegalArgumentException("Input string is null or empty");
        }
        
        // Check if the input string contains any non-octal characters
        for (int i = 0; i < octalString.length(); i++) {
            if (octalString.charAt(i) < '0' || octalString.charAt(i) > '7') {
                throw new IllegalArgumentException("Input string contains non-octal characters");
            }
        }
        
        // Parse the octal string to decimal
        int decimal = 0;
        int power = 0;
        for (int i = octalString.length() - 1; i >= 0; i--) {
            int digit = octalString.charAt(i) - '0';
            decimal += digit * Math.pow(8, power);
            power++;
        }
        
        return decimal;
    }
