        super(initialCapacity);
    }

    public void setMaxDepth(int maxDepth) {
        Validate.isTrue(maxDepth >= 0, "maxDepth must be 0 or greater");
        this.maxDepth = maxDepth;
    }

    public void add(Node node) {
        Validate.notNull(node);
        if (maxDepth > 0) {
            validateMaxDepth(node);
        }
        super.add(node);
    }

    private void validateMaxDepth(Node node) {
        int depth = calculateDepth(node);
        if (depth > maxDepth) {
            throw new IllegalArgumentException("Maximum depth exceeded. Node depth: " + depth + ", Maximum depth allowed: " + maxDepth);
        }
    }

    private int calculateDepth(Node node) {
        int depth = 0;
        Node currentNode = node;
        while (currentNode.parent() != null) {
            depth++;
            currentNode = currentNode.parent();
        }
        return depth;
    }
