                char[] chrs = Character.toChars(entityValue);
                out.write(chrs[0]);
                out.write(chrs[1]);
            } else {
                out.write(entityValue);
            }

            return 2 + (end - start) + (isHex ? 1 : 0) + (semiNext ? 1 : 0);
        }
        return 0;
    }

