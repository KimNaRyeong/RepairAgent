     */
    public Document copySafeNodes(Document source, Document dest) {
        Validate.notNull(source);
        Validate.notNull(dest);

        List<Node> sourceNodes = source.body().childNodes();
        for (Node sourceNode : sourceNodes) {
            Node cleanNode = copySafeNodes(sourceNode);
            dest.body().appendChild(cleanNode);
        }
        return dest;
    }

