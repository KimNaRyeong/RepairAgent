    /**
     * Copy safe nodes from source document to destination document, ensuring only safe elements are copied.
     *
     * @param source source document to copy nodes from
     * @param dest destination document to copy nodes to
     */
    public void copySafeNodes(Document source, Document dest) {
        Validate.notNull(source);
        Validate.notNull(dest);

        List<Node> sourceNodes = source.body().childNodes();
        Element destBody = dest.body();

        for (Node sourceNode : sourceNodes) {
            if (isSafeNode(sourceNode)) {
                Node destNode = sourceNode.clone();
                destBody.appendChild(destNode);
            }
        }
    }

