          {
            "line_number": 67,
            "new_lines": [
              "private Evaluator parseConjunction() {\n",
              "    Evaluator eval = parseSimpleSelector();\n",
              "    while (true) {\n",
              "        if (tq.matchChomp(')')) {\n",
              "            break;\n",
              "        }\n",
              "        if (tq.isEmpty() || tq.matchesAny(combinators)) {\n",
              "            break;\n",
              "        }\n",
              "        Evaluator next = parseSimpleSelector();\n",
              "        eval = new CombiningEvaluator.And(eval, next);\n",
              "    }\n",
              "    return eval;\n",
              "}\n",
              "\n",
              "private Evaluator parseSimpleSelector() {\n",
              "    if (tq.matchChomp(\"*\")) {\n",
              "        return new Evaluator.AllElements();\n",
              "    }\n",
              "    if (tq.matchChomp(\"@\")) {\n",
              "        Validate.isTrue(tq.matchChomp(TypeAttribute));\n",
              "        Validate.isTrue(tq.matchChomp(\"=\"));\n",
              "        String value = TokenQueue.unescape(tq.chompBalanced('(', ')'));\n",
              "        return new Evaluator.AttributeStarting(value.trim().toLowerCase());\n",
              "    }\n",
              "    if (tq.matchesWord()) {\n",
              "        String[] subQuery = StringUtil.split(tq.consumeWord(), ':');\n",
              "        String key = subQuery[0];\n",
              "        String value = subQuery.length == 2 ? subQuery[1] : \"\";\n",
              "        if (key.equals(\"lt\")) {\n",
              "            return new Evaluator.IndexLessThan(Integer.parseInt(value));\n",
              "        } else if (key.equals(\"gt\")) {\n",
              "            return new Evaluator.IndexGreaterThan(Integer.parseInt(value));\n",
              "        } else if (key.equals(\"eq\")) {\n",
              "            return new Evaluator.IndexEquals(Integer.parseInt(value));\n",
              "        } else if (key.equals(\"has\")) {\n",
              "            return new Evaluator.HasAttribute(value);\n",
              "        } else if (key.equals(\"contains\")) {\n",
              "            return new Evaluator.ContainsText(value);\n",
              "        } else if (key.equals(\"containsOwn\")) {\n",
              "            return new Evaluator.ContainsOwnText(value);\n",
              "        } else if (key.equals(\"matches\")) {\n",
              "            return new Evaluator.Matches(Pattern.compile(value));\n",
              "        } else if (key.equals(\"matchesOwn\")) {\n",
              "            return new Evaluator.MatchesOwn(Pattern.compile(value));\n",
              "        } else if (key.equals(\"tagName\")) {\n",
              "            return new Evaluator.Tag(value.trim().toLowerCase());\n",
              "        } else if (key.equals(\"class\")) {\n",
              "            return new Evaluator.Class(value.trim());\n",
              "        } else if (key.equals(\"id\")) {\n",
              "            return new Evaluator.Id(value.trim());\n",
              "        } else {\n",
              "            throw new Selector.SelectorParseException(\"Could not parse query '%s': unexpected token at '%s\", query, tq.remainder());\n",
              "        }\n",
              "    }\n",
              "    if (tq.matchChomp(\"[\")) {\n",
              "        String key = tq.chompTo(\"=\");\n",
              "        Validate.notEmpty(key);\n",
              "        Validate.isTrue(!tq.isEmpty(), \"No value for attribute\");\n",
              "        Validate.isTrue(tq.matchChomp(\"=\"));\n",
              "        String value = TokenQueue.unescape(tq.chompTo(\"]\"));\n",
              "        Validate.notEmpty(value);\n",
              "        Validate.isTrue(tq.matchChomp(\"]\"));\n",
              "        return new Evaluator.Attribute(key, value);\n",
              "    }\n",
              "    if (tq.matchChomp(\":\")) {\n",
              "        String value = tq.chompTo(\"()\");\n",
              "        Validate.notEmpty(value);\n",
              "        Validate.isTrue(tq.matchChomp(\"()\"));\n",
              "        return new Evaluator.Pseudo(value.trim());\n",
              "    }\n",
              "    if (tq.matchChomp(\"(\")) {\n",
              "        Evaluator subEval = parse();\n",
              "        Validate.isTrue(tq.matchChomp(\")\"));\n",
              "        return subEval;\n",
              "    }\n",
              "    throw new Selector.SelectorParseException(\"Could not parse query '\");\n",
              "}\n"
            ]
          }
        ],
        "deletions": [],
        "modifications": []
      }
    ]
