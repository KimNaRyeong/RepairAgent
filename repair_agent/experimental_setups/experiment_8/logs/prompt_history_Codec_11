    public void encodeQuotedPrintable(String input) {
        if (input == null) {
            return;
        }

        StringBuilder encoded = new StringBuilder();
        for (char c : input.toCharArray()) {
            if ((c >= 33 && c <= 60) || (c >= 62 && c <= 126)) {
                encoded.append(c);
