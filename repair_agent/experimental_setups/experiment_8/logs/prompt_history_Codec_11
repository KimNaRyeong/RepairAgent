    // Method to encode a string to quoted printable format
    public static String encodeQuotedPrintable(String input) throws UnsupportedEncodingException {
        byte[] bytes = input.getBytes(StandardCharsets.UTF_8);
        StringBuilder result = new StringBuilder(bytes.length * 3);

