public class ContinuedFraction {

    public double evaluate(double epsilon, double x, int maxIterations) {
        double small = 1e-50;
        double hPrev = x;
        double kPrev = 0.0;
        double n = 1.0;
        double dPrev = 1.0;
        double cPrev = hPrev;
        double hN = hPrev;
        double cN = hN;

        while (n < maxIterations) {
            n += 1.0;
            double a = -n * (n - 1);
            double b = 2 * n - 1;
            double dN = a * dPrev + b * cPrev;
            if (Math.abs(dN) < small) {
                dN = small;
            }
            double cN = a / b * cPrev + hPrev;
            if (Math.abs(cN) < small) {
                cN = small;
            }
            dN = 1 / dN;
            double deltaN = cN * dN;
            hN = hPrev * deltaN;
            if (Double.isInfinite(hN)) {
                throw new ArithmeticException("Continued fraction convergents diverged to +/- infinity for value " + x);
            }
            if (Double.isNaN(hN)) {
                throw new ArithmeticException("Continued fraction convergents failed to converge for value " + x);
            }
            if (Math.abs(deltaN - 1.0) < epsilon) {
                break;
            }
            hPrev = hN;
            dPrev = dN;
            cPrev = cN;
        }

        return hN;
    }
}
