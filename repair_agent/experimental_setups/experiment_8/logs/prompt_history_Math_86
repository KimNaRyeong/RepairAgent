     * @param smallDiagonalThreshold threshold below which diagonal entries are considered null
     * @throws NonPositiveDefiniteMatrixException if the matrix is not symmetric or not positive definite
     */
    public CholeskyDecompositionImpl(final RealMatrix matrix,
                                     final double relativeSymmetryThreshold,
                                     final double smallDiagonalThreshold) {
        if (!matrix.isSquare()) {
            throw new NonSquareMatrixException(matrix.getRowDimension(), matrix.getColumnDimension());
        }

        int order = matrix.getRowDimension();
        double[][] c = matrix.getData();

        double[][] l = new double[order][order];
        double[] diagonal = new double[order];

        boolean isSymmetric = true;
        for (int i = 0; i < order; i++) {
            for (int j = 0; j < i; j++) {
                isSymmetric = isSymmetric && Precision.equals(c[i][j], c[j][i], relativeSymmetryThreshold);
            }
        }

        if (!isSymmetric) {
            throw new NonSymmetricMatrixException();
        }

        for (int i = 0; i < order; i++) {
            double sum = c[i][i];
            for (int k = 0; k < i; k++) {
                sum -= l[i][k] * l[i][k] * diagonal[k];
            }
            if (sum <= 0) {
                throw new NonPositiveDefiniteMatrixException(i);
            }
            diagonal[i] = sum;
            double inverse = 1.0 / FastMath.sqrt(sum);
            for (int j = i + 1; j < order; j++) {
                sum = c[j][i];
                for (int k = 0; k < i; k++) {
                    sum -= l[j][k] * l[i][k] * diagonal[k];
                }
                l[j][i] = sum * inverse;
            }
        }

        this.lT = MatrixUtils.createRealMatrix(l);
    }
