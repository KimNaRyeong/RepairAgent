                            "modified_line": "public String chompBalanced(char open, char close) {\n        int start = -1;\n        int end = -1;\n        int depth = 0;\n        int len = queue.length();\n\n        for (int i = pos; i < len; i++) {\n            char c = queue.charAt(i);\n            if (c == open) {\n                if (start == -1) {\n                    start = i;\n                }\n                depth++;\n            } else if (c == close) {\n                depth--;\n                if (depth == 0) {\n                    end = i;\n                    break;\n                }\n            }\n        }\n\n        if (start != -1 && end != -1) {\n            String chomped = queue.substring(start, end + 1);\n            pos = end + 1;\n            return chomped;\n        } else {\n            return \"\";\n        }\n    }"
