                            "new_lines": [
                                "    // Simplified method to extract multiline textual block",
                                "    public void extractMultilineTextualBlock(String text) {",
                                "        List<String> multilineBlocks = new ArrayList<>();",
                                "        StringBuilder block = new StringBuilder();",
                                "        boolean inBlock = false;",
                                "",
                                "        for (String line : text.split(\"\\\\r?\\\\n\")) {",
                                "            if (line.trim().isEmpty()) {",
                                "                if (inBlock) {",
                                "                    multilineBlocks.add(block.toString());",
                                "                    block.setLength(0);",
                                "                    inBlock = false;",
                                "                }",
                                "            } else {",
                                "                if (!inBlock) {",
                                "                    inBlock = true;",
                                "                } else {",
                                "                    block.append(line).append(\"\\n\");",
                                "                }",
                                "            }",
                                "        }",
                                "",
                                "        if (inBlock) {",
                                "            multilineBlocks.add(block.toString());",
                                "        }",
                                "",
                                "        for (String blockText : multilineBlocks) {",
                                "            System.out.println(\"Textual Block:\\n\" + blockText);",
                                "        }",
                                "    }"
                            ]
                        }
                    ]
                }
            ]
        }
