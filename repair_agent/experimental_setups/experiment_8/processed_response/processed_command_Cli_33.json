                    "file_name": "org/apache/commons/cli/HelpFormatter.java",
                    "insertions": [
                        {
                            "line_number": 726,
                            "new_lines": [
                                "    public void renderWrappedText(String text, int width) {",
                                "        StringBuilder result = new StringBuilder();",
                                "        int startIndex = 0;",
                                "        int endIndex = width;",
                                "        while (endIndex < text.length()) {",
                                "            while (endIndex > startIndex && text.charAt(endIndex) != ' ') {",
                                "                endIndex--;",
                                "            }",
                                "            if (endIndex == startIndex) {",
                                "                endIndex = startIndex + width;",
                                "            }",
                                "            result.append(text, startIndex, endIndex).append(\"\\n\");",
                                "            startIndex = endIndex + 1;",
                                "            endIndex = startIndex + width;",
                                "        }",
                                "        if (startIndex < text.length()) {",
                                "            result.append(text.substring(startIndex));",
                                "        }",
                                "        System.out.println(result.toString());",
                                "    }"
                            ]
                        }
                    ]
                }
            ]
        }
