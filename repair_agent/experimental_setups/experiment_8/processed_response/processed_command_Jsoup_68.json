                            "line_number": 469,
                            "new_lines": [
                                "    private void closeInSpecificScope(String[] targetNames) {",
                                "        int bottom = stack.size() - 1;",
                                "        for (int pos = bottom; pos >= 0; pos--) {",
                                "            Element el = stack.get(pos);",
                                "            if (inSorted(el.nodeName(), targetNames)) {",
                                "                for (int j = stack.size() - 1; j >= pos; j--) {",
                                "                    Element popped = pop();",
                                "                    if (popped == el) {",
                                "                        break;",
                                "                    }",
                                "                }",
                                "                break;",
                                "            }",
                                "            if (el.tag().isFormListed()) {",
                                "                break;",
                                "            }",
                                "        }",
                                "    }",
                                "",
                                "    private void generateImpliedEndTags(String excludeTag) {",
                                "        while (stack.size() > 0) {",
                                "            Element el = currentElement();",
                                "            String nodeName = el.nodeName();",
                                "            if (nodeName.equals(excludeTag) || !el.tag().isSpecial()) {",
                                "                return;",
                                "            }",
                                "            pop();",
                                "        }",
                                "    }",
                                "",
                                "    private void generateImpliedEndTags() {",
                                "        generateImpliedEndTags(null);",
                                "    }",
                                "",
                                "    private boolean isSpecialElement(Element el) {",
                                "        return el.tag().isSpecial();",
                                "    }",
                                "",
                                "    private boolean isSpecialElement(String elName) {",
                                "        return Tag.valueOf(elName, settings).isSpecial();",
                                "    }",
                                "",
                                "    private void clearFormattingElementsToLastMarker() {",
                                "        while (!formattingElements.isEmpty()) {",
                                "            Element el = formattingElements.remove(formattingElements.size() - 1);",
                                "            if (el == null) {",
                                "                break;",
                                "            }",
                                "        }",
                                "    }",
                                "",
                                "    private void removeFromActiveFormattingElements(Element el) {",
                                "        for (int i = formattingElements.size() - 1; i >= 0; i--) {",
                                "            if (formattingElements.get(i) == el) {",
                                "                formattingElements.remove(i);",
                                "                break;",
                                "            }",
                                "        }",
                                "    }",
                                "",
                                "    private void insertMarkerToFormattingElements() {",
                                "        formattingElements.add(null);",
                                "    }",
                                "",
                                "    private void reconstructFormattingElements() {",
                                "        if (formattingElements.isEmpty()) {",
                                "            return;",
                                "        }",
                                "        Element last = formattingElements.get(formattingElements.size() - 1);",
                                "        if (last == null || onStack(last)) {",
                                "            return;",
                                "        }",
                                "        int size = formattingElements.size();",
                                "        for (int i = size - 1; i >= 0; i--) {",
                                "            Element entry = formattingElements.get(i);",
                                "            if (entry == null) {",
                                "                break;",
                                "            }",
                                "            if (onStack(entry)) {",
                                "                break;",
                                "            }",
                                "            formattingElements.remove(i);",
                                "        }",
                                "    }",
                                "",
                                "    private Element getActiveFormattingElement(String elName) {",
                                "        for (int pos = formattingElements.size() - 1; pos >= 0; pos--) {",
                                "            Element next = formattingElements.get(pos);",
                                "            if (next == null) {",
                                "                return null;",
                                "            }",
                                "            if (next.nodeName().equals(elName)) {",
                                "                return next;",
                                "            }",
                                "        }",
                                "        return null;",
                                "    }"
                            ]
                        }
                    ]
                }
            ]
        }
