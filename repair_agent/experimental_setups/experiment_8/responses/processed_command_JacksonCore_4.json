            "line_number": 580,
            "new_lines": [
              "    /**",
              "     * Method that will expand the current segment to contain at least the specified",
              "     * number of characters. If the current size of the segment is already greater",
              "     * than or equal to the specified number, no expansion is done.",
              "     *",
              "     * @param needed number of characters needed in the current segment",
              "     */",
              "    public void expandCurrentSegment(int needed) {",
              "        if (_segments == null) {",
              "            _segments = new ArrayList<>();",
              "        }",
              "        if (_currentSegment == null) {",
              "            _currentSegment = _allocator.allocCharBuffer(BufferRecycler.CharBufferType.TEXT_BUFFER);",
              "        }",
              "        int amount = _currentSegment.length;",
              "        if (amount < needed) {",
              "            amount = Math.max(needed, MIN_SEGMENT_LEN);",
              "            _currentSegment = Arrays.copyOf(_currentSegment, amount);",
              "        }",
              "    }"
            ]
          }
        ],
        "deletions": [
          580,
          590
        ]
      }
    ]
  }
