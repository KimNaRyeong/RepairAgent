            "line_number": 139,
            "new_lines": [
              "    Elements elements = new Elements();",
              "    Element[] parents = new Element[] {root};",
              "",
              "    while (!tq.isEmpty()) {",
              "        String subQuery = tq.chompToAny(combinators);",
              "        Elements currentElements = parse(parents, subQuery);",
              "        elements.addAll(currentElements);",
              "",
              "        if (tq.matchesAny(combinators)) {",
              "            String combinator = tq.consume();",
              "            if (combinator.equals(\" \")) {",
              "                parents = currentElements.toArray(new Element[0]);",
              "            } else if (combinator.equals(\">\")) {",
              "                parents = currentElements.toArray(new Element[0]);",
              "            } else if (combinator.equals(\"+\")) {",
              "                Elements plusElements = new Elements();",
              "                for (Element el : currentElements) {",
              "                    Element next = el.nextElementSibling();",
              "                    if (next != null && matches(next, tq.remainder())) {",
              "                        plusElements.add(next);",
              "                    }",
              "                }",
              "                elements = plusElements;",
              "            } else if (combinator.equals(\"~\")) {",
              "                Elements tildeElements = new Elements();",
              "                for (Element el : currentElements) {",
              "                    Element next = el.nextElementSibling();",
              "                    while (next != null) {",
              "                        if (matches(next, tq.remainder())) {",
              "                            tildeElements.add(next);",
              "                        }",
              "                        next = next.nextElementSibling();",
              "                    }",
              "                }",
              "                elements = tildeElements;",
              "            } else if (combinator.equals(\",\")) {",
              "                elements.addAll(select());",
              "            }",
              "        }",
              "    }",
              "",
              "    return elements;"
            ]
          }
        ],
        "deletions": [],
        "modifications": []
      }
    ]
  }
