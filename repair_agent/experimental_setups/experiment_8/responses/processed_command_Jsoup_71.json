              "    return parse();"
            ]
          },
          {
            "line_number": 41,
            "new_lines": [
              "    Evaluator parse() {",
              "        tq.consume();",
              "        return parseOr();",
              "    }",
              "",
              "    private Evaluator parseOr() {",
              "        List<Evaluator> evals = parseAnd();",
              "        if (!tq.matchesAny(combinators)) {",
              "            return evals.get(0);",
              "        }",
              "",
              "        OrEvaluator or = new OrEvaluator(evals);",
              "        while (tq.matchesAny(combinators)) {",
              "            String combinator = tq.consume().toString();",
              "            List<Evaluator> next = parseAnd();",
              "            or.add(next, combinator);",
              "        }",
              "        return or;",
              "    }",
              "",
              "    private List<Evaluator> parseAnd() {",
              "        List<Evaluator> evals = new ArrayList<>();",
              "        Evaluator right = parseCondition();",
              "        if (right == null) {",
              "            return evals;",
              "        }",
              "        while (true) {",
              "            if (!tq.matchChomp(' ')) {",
              "                break;",
              "            }",
              "            Evaluator next = parseCondition();",
              "            if (next == null) {",
              "                break;",
              "            }",
              "            evals.add(new AndEvaluator(right, next));",
              "            right = next;",
              "        }",
              "        return evals;",
              "    }",
              "",
              "    private Evaluator parseCondition() {",
              "        if (tq.matchChomp('*')) {",
              "            return new Evaluator.AllElements();",
              "        }",
              "        if (tq.matchChomp(':')) {",
              "            return parsePseudo();",
              "        }",
              "        if (tq.matchChomp('[')) {",
              "            return parseAttribute();",
              "        }",
              "        if (tq.matchChomp('.')) {",
              "            return parseClass();",
              "        }",
              "        if (tq.matchChomp('#')) {",
              "            return parseId();",
              "        }",
              "        if (tq.matchesWord()) {",
              "            return parseTag();",
              "        }",
              "        if (tq.matchesAny(combinators)) {",
              "            return null;",
              "        }",
              "        throw new Selector.SelectorParseException(\"Could not parse query '%s': unexpected token at '%s'\", query, tq.remainder());",
              "    }",
              "",
              "    private Evaluator parseTag() {",
              "        String tagName = tq.consumeElementSelector();",
              "        Validate.notEmpty(tagName);",
              "        return new Evaluator.Tag(tagName);",
              "    }",
              "",
              "    private Evaluator parseId() {",
              "        String id = tq.consumeCssIdentifier();",
              "        Validate.notEmpty(id);",
              "        return new Evaluator.Id(id);",
              "    }",
              "",
              "    private Evaluator parseClass() {",
              "        String className = tq.consumeCssIdentifier();",
              "        Validate.notEmpty(className);",
              "        return new Evaluator.Class(className);",
              "    }",
              "",
              "    private Evaluator parseAttribute() {",
              "        String key = tq.consumeToAny(AttributeEvals);",
              "        Validate.notEmpty(key);",
              "        tq.consumeWhitespace();",
              "",
              "        if (tq.isEmpty() || tq.matches(']')) {",
              "            return new Evaluator.Attribute(key);",
              "        }",
              "",
              "        String value = tq.chompTo(']').trim();",
              "        Validate.notEmpty(value);",
              "        return new Evaluator.AttributeWithValue(key, value);",
              "    }",
              "",
              "    private Evaluator parsePseudo() {",
              "        String pseudo = tq.chompTo('(').trim().toLowerCase();",
              "        tq.consume('(');",
              "        if (\"not\".equals(pseudo)) {",
              "            return new StructuralEvaluator.Not(parse());",
              "        }",
              "        if (InQueryParser.isCombiningEvaluator(pseudo)) {",
              "            return new StructuralEvaluator.Combining(parse(), pseudo);",
              "        }",
              "        if (\"contains\".equals(pseudo)) {",
              "            return new Evaluator.Contains(parseText());",
              "        }",
              "        if (\"containsOwn\".equals(pseudo)) {",
              "            return new Evaluator.ContainsOwn(parseText());",
              "        }",
              "        if (\"matches\".equals(pseudo)) {",
              "            return new Evaluator.Matches(parseText());",
              "        }",
              "        if (\"matchesOwn\".equals(pseudo)) {",
              "            return new Evaluator.MatchesOwn(parseText());",
              "        }",
              "        if (\"matchesOwnCaseless\".equals(pseudo)) {",
              "            return new Evaluator.MatchesOwnCaseless(parseText());",
              "        }",
              "        throw new Selector.SelectorParseException(\"Could not parse query '%s': unexpected pseudo class '%s'\", query, pseudo);",
              "    }",
              "",
              "    private Evaluator parseText() {",
              "        String text = tq.chompBalanced('(', ')');",
              "        Validate.notEmpty(text);",
              "        return new Evaluator.ContainsOwnText(text);",
              "    }"
            ]
          }
        ]
      }
    ]
  }
