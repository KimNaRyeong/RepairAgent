              "    private Evaluator parseCombined() {",
              "        Evaluator eval = parseSeq();",
              "        while (true) {",
              "            if (tq.matchChomp(',')) {",
              "                eval = new CombiningEvaluator.Or(eval, parseSeq());",
              "            } else {",
              "                return eval;",
              "            }",
              "        }",
              "    }",
              "",
              "    private Evaluator parseSeq() {",
              "        Evaluator eval = parseSimple();",
              "        while (true) {",
              "            if (tq.peek().matches(\"[\\\\s]*[>+~]\")) {",
              "                if (tq.matchChomp('>')) {",
              "                    eval = new CombiningEvaluator.And(eval, parseSimple());",
              "                } else if (tq.matchChomp('+')) {",
              "                    eval = new CombiningEvaluator.And(eval, new StructuralEvaluator.ImmediatePreviousSibling(parseSimple()));",
              "                } else if (tq.matchChomp('~')) {",
              "                    eval = new CombiningEvaluator.And(eval, new StructuralEvaluator.PreviousSibling(parseSimple()));",
              "                } else {",
              "                    tq.consumeWhitespace();",
              "                }",
              "            } else {",
              "                return eval;",
              "            }",
              "        }",
              "    }",
              "",
              "    private Evaluator parseSimple() {",
              "        if (tq.matchChomp(\"*\")) {",
              "            return new Evaluator.AllElements();",
              "        }",
              "        if (tq.matchChomp(Tag.EVALUATOR)) {",
              "            return new Evaluator.Tag(tq.consumeToAny(combinators));",
              "        }",
              "        if (tq.matchChomp(\"#\")) {",
              "            return new Evaluator.Id(tq.consumeToAny(combinators));",
              "        }",
              "        if (tq.matchChomp(\".\")) {",
              "            return new Evaluator.Class(tq.consumeToAny(combinators));",
              "        }",
              "        if (tq.matchesWord() || tq.matchesAny(combinators)) {",
              "            return new Evaluator.Tag(tq.consumeToAny(combinators));",
              "        }",
              "        String attKey = tq.consumeAttributeKey();",
              "        if (tq.matchChomp(AttributeEvals)) {",
              "            String attValue = tq.consumeToAny(combinators);",
              "            Validate.notNull(attValue);",
              "            return new Evaluator.Attribute(attKey, attValue, AttributeEvals);",
              "        }",
              "        return new Evaluator.Attribute(attKey);",
              "    }"
            ]
          }
        ]
      }
