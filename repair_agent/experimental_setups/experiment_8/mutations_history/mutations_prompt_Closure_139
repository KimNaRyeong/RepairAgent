    private void normalizeLabels(Node n) {
      Preconditions.checkArgument(n.getType() == Token.LABEL);

      Node last = n.getLastChild();
      switch (last.getType()) {
        case Token.LABEL:
        case Token.BLOCK:
        case Token.FOR:
