    public static int parseOctal(String octalString) {
        // Validate input
        if (octalString == null || octalString.isEmpty()) {
            throw new NumberFormatException("Input string is null or empty");
        }

        // Check if the input string starts with '0'
        if (!octalString.startsWith("0")) {
            throw new NumberFormatException("Octal string must start with '0'");
        }

        int result = 0;
        int base = 1; // Base for the calculations

        // Iterate through the octal string from right to left
        for (int i = octalString.length() - 1; i >= 0; i--) {
            char digit = octalString.charAt(i);
            if (digit < '0' || digit > '7') {
                throw new NumberFormatException("Invalid character in octal string");
            }
            result += (digit - '0') * base;
            base *= 8; // Octal system is base 8
        }

        return result;
    }
