     *
     * @param input the input string with HTML entities to unescape
     * @return the input string with HTML entities unescaped
     */
    public static String unescapePattern(String input) {
        // Define the HTML entity pattern
        Pattern pattern = Pattern.compile("&(#?)([a-zA-Z0-9]+);");

        // Create a map of common HTML entities and their corresponding characters
        Map<String, String> htmlEntityMap = new HashMap<>();
        htmlEntityMap.put("quot", "\"");
        htmlEntityMap.put("amp", "&");
        htmlEntityMap.put("apos", "'");
        htmlEntityMap.put("lt", "<");
        htmlEntityMap.put("gt", ">");

        // Matcher for finding HTML entities in the input string
        Matcher matcher = pattern.matcher(input);

        // StringBuilder to hold the unescaped input
        StringBuilder unescaped = new StringBuilder();

        // Loop through the input string and replace HTML entities with their corresponding characters
        int lastEnd = 0;
        while (matcher.find()) {
            // Append the substring before the match
            unescaped.append(input, lastEnd, matcher.start());

            // Get the entity name or number
            String name = matcher.group(2);

            // Check if the entity is a number
            if (matcher.group(1).isEmpty()) {
                // Handle numeric entities
                if (name.startsWith("x") || name.startsWith("X")) {
                    // Hexadecimal
                    int codepoint = Integer.parseInt(name.substring(1), 16);
                    unescaped.append((char) codepoint);
                } else {
                    // Decimal
                    int codepoint = Integer.parseInt(name);
                    unescaped.append((char) codepoint);
                }
            } else {
                // Handle named entities
                String value = htmlEntityMap.get(name);
                if (value != null) {
                    unescaped.append(value);
                } else {
                    // Unknown named entity, keep as is
                    unescaped.append(matcher.group());
                }
            }

            lastEnd = matcher.end();
        }

        // Append the rest of the input string
        unescaped.append(input.substring(lastEnd));

        return unescaped.toString();
    }
