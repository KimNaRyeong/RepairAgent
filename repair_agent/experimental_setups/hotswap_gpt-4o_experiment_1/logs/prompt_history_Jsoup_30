    /**
     * Determines if the node and its children are valid for the defined whitelist.
     *
     * @param root root node to descend from
     * @return a cleaned copy of the input root and its children
     */
    public Element copySafeNodes(Element root) {
        Element safe = (Element) root.clone();
        copySafeNodes(root, safe);
        return safe;
    }

    private void copySafeNodes(Node source, Node dest) {
        List<Node> sourceChildren = source.childNodes();
        for (Node sourceChild : sourceChildren) {
            if (sourceChild instanceof Element) {
                Element sourceChildElement = (Element) sourceChild;
                if (whitelist.isSafeTag(sourceChildElement.tagName())) {
