                    Element destinationChild = new Element(Tag.valueOf(sourceEl.tagName()), sourceEl.baseUri(), sourceEl.attributes());
                    dest.appendChild(destinationChild);
                    copySafeNodes(sourceEl, destinationChild, whitelist); // Recursively copy children
                } else {
                    copySafeNodes(sourceEl, dest, whitelist); // Skip current element but continue with its children
