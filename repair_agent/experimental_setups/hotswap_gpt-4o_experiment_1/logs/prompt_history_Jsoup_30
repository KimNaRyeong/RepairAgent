                dest.appendChild(new TextNode(sourceText.getWholeText(), sourceText.baseUri()));
            } else if (sourceChild instanceof DataNode) {
                DataNode sourceData = (DataNode) sourceChild;
                dest.appendChild(new DataNode(sourceData.getWholeData(), sourceData.baseUri()));
            }
        }
