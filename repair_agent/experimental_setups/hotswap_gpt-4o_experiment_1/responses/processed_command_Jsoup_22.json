            "line_number": 446,
            "modified_line": "    public Element nextElementSibling() {\n        Element parent = parent();\n        if (parent == null) {\n            return null;\n        }\n        Elements siblings = parent.children();\n        int index = siblings.indexOf(this);\n        if (index == -1 || index == siblings.size() - 1) {\n            return null;\n        }\n        return siblings.get(index + 1);\n    }"
          },
          {
            "line_number": 461,
            "modified_line": "    public Element previousElementSibling() {\n        Element parent = parent();\n        if (parent == null) {\n            return null;\n        }\n        Elements siblings = parent.children();\n        int index = siblings.indexOf(this);\n        if (index <= 0) {\n            return null;\n        }\n        return siblings.get(index - 1);\n    }"
          }
        ]
      }
    ]
  }
