    "code_snippet": "private String consumeSubQuery() { StringBuilder sq = new StringBuilder(); while (!tq.isEmpty()) { if (tq.matches(\"(\")) sq.append(\"(\").append(tq.chompBalanced('(', ')')).append(\")\"); else if (tq.matches(\"[\")) sq.append(\"[\").append(tq.chompBalanced('[', ']')).append(\"]\"); else if (tq.matchesAny(combinators)) break; else sq.append(tq.consume()); } return sq.toString(); }"
  }
