        // variable's type
        JSType type = null;
        if (info == null) {
          // the variable's type will be inferred
          CompilerInput input = compiler.getInput(sourceName);
          Preconditions.checkNotNull(input, sourceName);
          type = input.isExtern() ?
              getNativeType(UNKNOWN_TYPE) : null;
        } else if (info.hasEnumParameterType()) {
