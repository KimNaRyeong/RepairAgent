              "    /**\n",
              "     * Pulls a balanced run of text from the queue. \n",
              "     * The opening character is assumed to be on the queue, and balanced text is defined as a matching closing character, \n",
              "     * or the nested balanced text itself. Use to chomp balanced parentheses, brackets, quotes. \n",
              "     * @return balanced run\n",
              "     */\n",
              "    public String chompBalanced() {\n",
              "        int start = pos;\n",
              "        char open = queue.charAt(pos);\n",
              "        char close = StringUtil.closeFor(open);\n",
              "\n",
              "        int depth = 0;\n",
              "        boolean inQuote = false; // whether we are in a quote\n",
              "        boolean inTag = false; // whether we are in a tag (CDATA)\n",
              "        boolean inUnquotedValue = false; // whether we are inside an unquoted attribute value\n",
              "\n",
              "        for (int i = pos; i < queue.length(); i++) {\n",
              "            char c = queue.charAt(i);\n",
              "\n",
              "            if (inTag) {\n",
              "                if (c == '>' && !inQuote) {\n",
              "                    inTag = false;\n",
              "                }\n",
              "            } else if (inQuote) {\n",
              "                if (c == ESC) {\n",
              "                    i++; // skip next char\n",
              "                } else if (c == '\"') {\n",
              "                    inQuote = false;\n",
              "                }\n",
              "            } else if (c == '\"') {\n",
              "                inQuote = true;\n",
              "            } else if (c == '<' && !inUnquotedValue) {\n",
              "                inTag = true;\n",
              "            } else if (c == open) {\n",
              "                depth++;\n",
              "            } else if (c == close) {\n",
              "                depth--;\n",
              "                if (depth == 0) {\n",
              "                    String chomped = queue.substring(start, i + 1);\n",
              "                    pos = i + 1;\n",
              "                    return chomped;\n",
              "                }\n",
              "            } else if (c == ' ' || c == '\\n' || c == '\\t' || c == '\\f' || c == '\\r') {\n",
              "                if (!inUnquotedValue) {\n",
              "                    start++;\n",
              "                }\n",
              "            } else {\n",
              "                inUnquotedValue = true;\n",
              "            }\n",
              "        }\n",
              "        return queue.substring(start); // return to end\n",
              "    }\n"
            ]
