        "modifications": [
          {
            "line_number": 314,
            "modified_line": "/**\n * Determines if a property assignment is a prototype property assignment,\n * i.e., its left-hand side is a direct reference to a prototype.\n */\nprivate boolean isPrototypePropertyAssign(Node n) {\n    Node parent = n.getParent();\n    \n    if (parent == null || parent.getType() != Token.ASSIGN) {\n        return false;\n    }\n    \n    Node lhs = parent.getFirstChild();\n    \n    if (lhs == null || lhs.getType() != Token.GETPROP) {\n        return false;\n    }\n    \n    Node obj = lhs.getFirstChild();\n    \n    return obj != null && obj.getType() == Token.THIS;\n}"
          }
        ]
      }
    ]
  }
}
