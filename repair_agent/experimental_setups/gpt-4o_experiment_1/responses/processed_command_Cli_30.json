{
  "command_name": "express_hypothesis",
  "arguments": {
    "hypothesis": "The bug is caused by missing logic for handling option groups in the methods handling properties in DefaultParser and Parser. This results in an AlreadySelectedException when an option from a group is already selected, as the code does not check if another option from the group has been selected before adding a new option."
  }
}
