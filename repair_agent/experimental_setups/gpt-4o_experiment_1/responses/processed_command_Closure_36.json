              "     * Checks if the initialization is a singleton getter method.\n",
              "     */\n",
              "    private boolean isSingletonGetterMethod(Reference initialization) {\n",
              "      Node value = initialization.getAssignedValue();\n",
              "      if (value != null && value.isFunction()) {\n",
              "        Node functionBody = value.getLastChild();\n",
              "        if (functionBody != null && functionBody.hasChildren()) {\n",
              "          Node returnNode = functionBody.getFirstChild();\n",
              "          if (returnNode.isReturn()) {\n",
              "            Node returnValue = returnNode.getFirstChild();\n",
              "            return returnValue != null && returnValue.isOr();\n",
              "          }\n",
              "        }\n",
              "      }\n",
              "      return false;\n",
              "    }\n"
            ]
