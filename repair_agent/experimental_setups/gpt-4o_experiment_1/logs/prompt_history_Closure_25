        FunctionType iParameterFnType = iParameterType.toMaybeFunctionType();

        if (iArgument.isFunction() &&
            iArgumentType.isFunctionType() &&
            iArgument.getJSDocInfo() == null) {
          iArgument.setJSType(iParameterFnType);
