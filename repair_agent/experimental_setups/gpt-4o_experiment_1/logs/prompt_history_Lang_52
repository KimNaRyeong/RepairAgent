/**
 * Escape characters in a Java-style string
 * 
 * @param input the string to escape
 * @return the escaped string
 */
public static String escapeJavaStyleString(String input) {
    if (input == null) {
        return null;
    }

    StringBuilder result = new StringBuilder();
    for (int i = 0; i < input.length(); i++) {
        char c = input.charAt(i);
        switch (c) {
            case '\b':
                result.append("\\b");
                break;
            case '\t':
                result.append("\\t");
                break;
            case '\n':
                result.append("\\n");
                break;
            case '\f':
                result.append("\\f");
                break;
            case '\r':
                result.append("\\r");
                break;
            case '\"':
                result.append("\\\"");
                break;
            case '\\':
                result.append("\\\\");
                break;
            default:
                if (c < 32 || c > 126) {
                    String hex = Integer.toHexString(c);
                    result.append("\\u");
                    for (int j = 0; j < 4 - hex.length(); j++) {
                        result.append('0');
                    }
                    result.append(hex);
                } else {
                    result.append(c);
                }
        }
    }
    return result.toString();
}
