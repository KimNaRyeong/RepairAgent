    public int getPivotRow(double[][] matrix, int pivotCol, int startRow) {
        double maxVal = Math.abs(matrix[startRow][pivotCol]);
        int pivotRow = startRow;

        for (int i = startRow + 1; i < matrix.length; i++) {
            double currentVal = Math.abs(matrix[i][pivotCol]);
            if (currentVal > maxVal) {
                maxVal = currentVal;
                pivotRow = i;
