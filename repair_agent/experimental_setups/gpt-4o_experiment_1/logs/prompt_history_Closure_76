import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class VariableChecker {
    // Method to check if a variable is still live within an expression
    public boolean isVariableStillLiveWithinExpression(String variableName, String expression) {
        // Create a regex pattern to match the variable name
        String patternString = "\\b" + variableName + "\\b";
        Pattern pattern = Pattern.compile(patternString);

        // Create a matcher with the given expression
        Matcher matcher = pattern.matcher(expression);

        // Check if the variable is still live within the expression
        return matcher.find();
    }
}
