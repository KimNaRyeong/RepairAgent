public class VariableAnalyzer {

    // Method to check if a variable is read before it is killed
    public boolean isVariableReadBeforeKill(List<String> operations, String variable) {
        boolean isRead = false;

        for (String operation : operations) {
            if (operation.contains(variable)) {
                if (!isRead) {
                    isRead = true;
                } else {
                    return false; // Variable is killed before being read again
                }
            }
        }

        return isRead; // Variable is read before being killed
