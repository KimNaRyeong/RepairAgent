import com.google.javascript.rhino.Node;

public class VariableAnalyzer {

    // This method checks if a variable is read before it is killed (overwritten)
    public boolean isVariableReadBeforeKill(Node node, String variableName) {
        Node current = node;

        // Traverse the abstract syntax tree to find all occurrences of the variable
        while (current != null) {
            if (current.isName() && current.getString().equals(variableName)) {
                // Check if the variable is read before it is killed
                Node next = current.getNext();
                while (next != null) {
                    if (next.isName() && next.getString().equals(variableName)) {
                        return true; // Variable is read before it is killed
                    }
                    if (next.isAssign() && next.getFirstChild().getString().equals(variableName)) {
                        return false; // Variable is killed (overwritten) before it is read
                    }
                    next = next.getNext();
                }
            }
            current = current.getNext();
        }

        return false; // Variable is not found or not read before killed
    }
}
