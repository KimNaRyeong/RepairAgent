public class AliasFinder {
    
    // Method to find aliases in a given list of strings
    public void findAliases(String[] strings) {
        Map<Character, Set<String>> map = new HashMap<>();
        
        // Iterate through each string in the input array
        for (String str : strings) {
            if (str.length() > 0) {
                char firstChar = str.charAt(0);
                // Check if the map contains the first character
                if (map.containsKey(firstChar)) {
                    // If it contains, add the string to the existing set
                    map.get(firstChar).add(str);
                } else {
                    // If it doesn't contain, create a new set and add the string
                    Set<String> set = new HashSet<>();
                    set.add(str);
                    map.put(firstChar, set);
                }
            }
        }
        
        // Print the aliases found
        for (Character key : map.keySet()) {
            System.out.println("Alias for " + key + ": " + map.get(key));
        }
    }
}
