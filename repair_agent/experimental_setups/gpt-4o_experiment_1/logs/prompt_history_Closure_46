import java.util.Set;

public class TypeUtils {

    // Method to find the least common supertype of two given types
    public static Class<?> getLeastSupertype(Class<?> type1, Class<?> type2) {
        // Find all superclasses for the first type
        Set<Class<?>> type1Superclasses = TypeHierarchyUtils.getSuperclasses(type1);
        
        // Check if the second type is a superclass of the first type
        if (type1Superclasses.contains(type2)) {
            return type2;
        }
        
        // Find all superclasses for the second type
        Set<Class<?>> type2Superclasses = TypeHierarchyUtils.getSuperclasses(type2);
        
        // Check if the first type is a superclass of the second type
        if (type2Superclasses.contains(type1)) {
            return type1;
        }
        
        // Find the common superclasses of both types
        Set<Class<?>> commonSuperclasses = new HashSet<>(type1Superclasses);
        commonSuperclasses.retainAll(type2Superclasses);
        
        // If there are common superclasses, return the first one
        if (!commonSuperclasses.isEmpty()) {
            return commonSuperclasses.iterator().next();
        }
        
        // If no common superclasses found, return Object class as the default supertype
        return Object.class;
    }
}
