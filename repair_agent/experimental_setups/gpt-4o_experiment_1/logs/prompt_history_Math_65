        // Calculate the sum of squares of each number in the array
        for (double num : numbers) {
            sumOfSquares += num * num;
        }
        
        // Calculate the mean of the squares
        double meanOfSquares = sumOfSquares / numbers.length;
        
        // Calculate the square root of the mean of squares to get the RMS
