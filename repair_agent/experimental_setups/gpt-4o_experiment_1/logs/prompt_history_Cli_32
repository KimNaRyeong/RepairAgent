public class TextWrapper {
    /**
     * Find a wrap position within a string.
     * 
     * @param text The text to search within.
     * @param startPos The starting position to search from.
     * @param wrapSize The maximum wrap size.
     * @return The wrap position within the text.
     */
    public int findWrapPos(String text, int startPos, int wrapSize) {
        // If the starting position is already at or beyond the text length, return -1
        if (startPos >= text.length()) {
            return -1;
        }
        
        // Calculate the end position based on the wrap size or the text length, whichever is smaller
        int endPos = Math.min(startPos + wrapSize, text.length());
        
        // If the end position is at the text length, return -1
        if (endPos == text.length()) {
            return -1;
        }
        
        // Check for a space before the end position
        while (endPos > startPos && text.charAt(endPos) != ' ') {
            endPos--;
        }
        
        // If no space was found, return -1
        if (endPos == startPos) {
            return -1;
        }
        
        return endPos;
    }
}
