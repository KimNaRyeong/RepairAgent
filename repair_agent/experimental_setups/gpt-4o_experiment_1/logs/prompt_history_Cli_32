public class TextWrapper {
    private static final int DEFAULT_WRAP_COLUMN = 80;

    /**
     * Find the wrap position for the given text string starting from the specified index.
     * The wrap position is the index where the text should be wrapped to the next line.
     *
     * @param text The text string to wrap
     * @param startPos The starting index to search for the wrap position
     * @return The wrap position index
     */
    public int findWrapPos(String text, int startPos) {
        // Initialize the wrap position to the default wrap column
        int wrapPos = startPos + DEFAULT_WRAP_COLUMN;
        
        // Find the last space character within the wrap column
        for (int i = startPos + DEFAULT_WRAP_COLUMN; i >= startPos; i--) {
            if (text.charAt(i) == ' ') {
                wrapPos = i;
                break;
            }
        }
        
        return wrapPos;
    }
}
