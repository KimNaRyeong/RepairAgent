import java.util.HashMap;
import java.util.Map;

public class PaxHeadersParser {

    public Map<String, String> parsePaxHeaders(String paxHeadersString) {
        Map<String, String> paxHeaders = new HashMap<>();

        if (paxHeadersString == null || paxHeadersString.isEmpty()) {
            return paxHeaders;
        }

        String[] headers = paxHeadersString.split(",");

        for (String header : headers) {
            String[] parts = header.split("=");
            if (parts.length == 2) {
                paxHeaders.put(parts[0].trim(), parts[1].trim());
            }
        }

        return paxHeaders;
    }
}
