    /**
     * Returns the node in the tree where a new code should be inserted based on its code.
     * If the code already exists in the tree, it returns the node containing that code.
     * If the code doesn't exist, it returns the parent node where the code should be inserted.
     * 
     * @param root The root node of the tree.
     * @param code The code to be inserted.
     * @return The node where the new code should be inserted or the node containing the code.
     */
    public Node getNodeForCodeInsertion(Node root, String code) {
        Node current = root;
        Node parent = null;
        
        while (current != null) {
            int compareResult = code.compareTo(current.getCode());
            if (compareResult == 0) {
                // Code already exists in the tree
                return current;
            } else if (compareResult < 0) {
                parent = current;
                current = current.getLeft();
            } else {
                parent = current;
                current = current.getRight();
            }
        }
        
        // Code doesn't exist in the tree, return the parent node where it should be inserted
        return parent;
    }
