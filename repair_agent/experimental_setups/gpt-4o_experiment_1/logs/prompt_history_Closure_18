    Set<CompilerInput> entryPointInputs = Sets.newLinkedHashSet();
    if (depOptions.shouldPruneDependencies()) {
      if (!depOptions.shouldDropMoochers()) {
        entryPointInputs.addAll(sorter.getInputsWithoutProvides());
      }

