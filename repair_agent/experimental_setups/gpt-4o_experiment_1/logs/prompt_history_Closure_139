        // It is an empty reference remove it.
        if (NodeUtil.isStatementBlock(gramps)) {
          gramps.removeChild(parent);
        } else if (gramps.getType() == Token.FOR) {
          // This is the "for (var a in b)..." case.  We don't need to worry
