     * @param octalString the octal string to parse
     * @return the decimal equivalent of the octal string
     * @throws NumberFormatException if the string is not a valid octal number
     */
    public static int parseOctal(String octalString) {
        if (octalString == null || octalString.isEmpty()) {
            throw new NumberFormatException("Empty or null input string");
        }

        int decimalValue = 0;
        int length = octalString.length();

        for (int i = 0; i < length; i++) {
            char c = octalString.charAt(i);
            if (c < '0' || c > '7') {
                throw new NumberFormatException("Invalid character in input string: " + c);
            }
            decimalValue = decimalValue * 8 + (c - '0');
        }

        return decimalValue;
    }
