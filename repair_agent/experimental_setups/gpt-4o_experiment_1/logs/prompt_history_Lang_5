import java.util.Locale;

public class MyLocaleUtil {

    /**
     * Method to convert the given string to a Locale object.
     * If the input string is null or empty, it returns the default locale.
     * If the input has language only, it returns the Locale with that language.
     * If the input has language and country, it returns the Locale with that language and country.
     * If the input has language, country, and variant, it returns the Locale with all three.
     * 
     * @param localeStr the string representing the locale
     * @return the Locale object corresponding to the input string
     */
    public static Locale toLocale(String localeStr) {
        if (localeStr == null || localeStr.isEmpty()) {
            return Locale.getDefault();
        }

        String[] parts = localeStr.split("_");
        switch (parts.length) {
            case 1:
                return new Locale(parts[0]);
            case 2:
                return new Locale(parts[0], parts[1]);
            case 3:
                return new Locale(parts[0], parts[1], parts[2]);
            default:
                return Locale.getDefault();
        }
    }
}
