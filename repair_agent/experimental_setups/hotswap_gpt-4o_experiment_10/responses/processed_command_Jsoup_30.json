              "    /**",
              "     * Copy nodes from the input Document, cleaning their attributes and TextNodes. Used for HTML and XML parsing.",
              "     *",
              "     * @param source source document",
              "     * @param output output document",
              "     */",
              "    public void copySafeNodes(Document source, Document output) {",
              "        Validate.notNull(source);",
              "        Validate.notNull(output);",
              "",
              "        List<Node> sourceNodes = source.body().childNodes();",
              "        for (Node sourceNode : sourceNodes) {",
              "            Node cleanedNode = clean(sourceNode);",
              "            output.body().appendChild(cleanedNode);",
              "        }",
              "    }",
              "",
              "    private Node clean(Node node) {",
              "        if (node instanceof Element) {",
              "            Element element = (Element) node;",
              "            Element cleanedElement = new Element(Tag.valueOf(element.tagName()), element.baseUri(), element.attributes());",
              "            List<Node> childNodes = element.childNodes();",
              "            for (Node childNode : childNodes) {",
              "                Node cleanedChildNode = clean(childNode);",
              "                cleanedElement.appendChild(cleanedChildNode);",
              "            }",
              "            return cleanedElement;",
              "        } else if (node instanceof TextNode) {",
              "            TextNode textNode = (TextNode) node;",
              "            return new TextNode(textNode.getWholeText(), textNode.baseUri());",
              "        } else {",
              "            return node.clone();",
              "        }",
              "    }",
              "}"
