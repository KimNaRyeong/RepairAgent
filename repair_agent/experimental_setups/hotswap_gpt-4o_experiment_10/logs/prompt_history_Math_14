     * Calculates the square root of a given number using Newton's method.
     *
     * @param x the number whose square root to calculate
     * @return the square root of the given number
     */
    public static double squareRoot(double x) {
        if (x < 0) {
            throw new IllegalArgumentException("Cannot calculate square root of a negative number");
        }

        double guess = x / 2.0;
        double error = 1e-15; // small error threshold for convergence
        while (Math.abs(guess * guess - x) > error) {
            guess = 0.5 * (guess + x / guess);
        }

        return guess;
    }
