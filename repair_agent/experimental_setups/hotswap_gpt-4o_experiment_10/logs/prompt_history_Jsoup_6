    public static String unescape(String text) {
        // Define the HTML entity pattern
        Pattern pattern = Pattern.compile("&(#[0-9]+|#[xX][0-9a-fA-F]+|\\w+);");
        
        // Define the HTML entities map
        Map<String, String> entities = new HashMap<>();
