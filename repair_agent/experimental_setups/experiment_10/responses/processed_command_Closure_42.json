{
  "command_name": "write_fix",
  "arguments": {
    "project_name": "Closure",
    "bug_index": "42",
    "changes_dicts": [
      {
        "file_name": "com/google/javascript/jscomp/parsing/IRFactory.java",
        "insertions": [
          {
            "line_number": 568,
            "new_lines": [
              "public void transformForInLoop(Node forIn) {",
              "Node lhs = forIn.removeFirstChild();",
              "Node obj = forIn.removeFirstChild();",
              "",
              "Node body = forIn.removeFirstChild();",
              "Node block = new Node(Token.BLOCK, body);",
              "",
              "Node iteratorName = IR.name(\"$$jscomp$key\");",
              "Node iterator = IR.var(iteratorName.cloneTree(), IR.getprop(obj.cloneTree(), IR.string(\"keys\")));",
              "",
              "Node getnext = IR.getelem(obj.cloneTree(), iteratorName.cloneTree());",
              "Node callNext = IR.call(IR.getelem(iterator.cloneTree(), IR.string(\"next\")));",
              "Node assign = IR.assign(iteratorName.cloneTree(), IR.getprop(callNext, IR.string(\"value\")));",
              "",
              "Node loop = IR.forIn(iteratorName.cloneTree(), obj.cloneTree(), block);",
              "loop.putBooleanProp(Node.IS_FOR_OF, true);",
              "",
              "Node stmts = new Node(Token.BLOCK, iterator, getnext, assign, loop);",
              "",
              "forIn.addChildrenToFront(stmts);",
              "}"
            ]
          }
        ]
      }
    ]
  }
}
