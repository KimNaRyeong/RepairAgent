              "     * @param bytes the byte data to parse",
              "     * @return the extracted charset or the default charset if not found",
              "     */",
              "    public static String parseByteData(byte[] bytes) {",
              "        String charset = defaultCharset; // Default to UTF-8 if charset not found",
              "        ByteBuffer byteBuffer = ByteBuffer.wrap(bytes);",
              "        if (bytes.length >= 2) {",
              "            int bom = (bytes[0] & 0xFF) << 8 | (bytes[1] & 0xFF);",
