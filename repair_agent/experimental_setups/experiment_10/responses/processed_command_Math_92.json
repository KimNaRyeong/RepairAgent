        "file_name": "org/apache/commons/math/util/MathUtils.java",
        "insertions": [],
        "deletions": [],
        "modifications": [
          {
            "line_number": 234,
            "modified_line": "    public double binomialCoefficientDouble(int n, int k) {\n        if (k < 0 || k > n) {\n            return 0;\n        }\n        \n        if (k == 0 || k == n) {\n            return 1;\n        }\n        \n        if (k > n - k) {\n            k = n - k;\n        }\n        \n        double result = 1.0;\n        for (int i = 1; i <= k; i++) {\n            result *= (double) (n - k + i) / i;\n        }\n        \n        return result;\n    }"
          }
        ]
      }
    ]
  }
}
