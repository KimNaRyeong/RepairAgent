        while (len > 0) {
            if (pos >= limit) {
                fillBuffer();
                if (pos >= limit) {
                    break; // end of stream
                }
            }
            int copyLen = Math.min(limit - pos, len);
            System.arraycopy(buffer, pos, b, off, copyLen);
            pos += copyLen;
            off += copyLen;
            len -= copyLen;
            bytesRead += copyLen;
        }

        return (bytesRead == 0 && pos >= limit) ? -1 : bytesRead;
    }

