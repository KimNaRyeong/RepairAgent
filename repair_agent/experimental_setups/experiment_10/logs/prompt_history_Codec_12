     * 
     * @param in    the input stream to read from
     * @param codec the Base-N codec to use for decoding
     */
    public BaseNCodecInputStream(InputStream in, BaseNCodec codec) {
        this.in = in;
        this.codec = codec;
        this.buffer = new byte[codec.getMaxDecodedSize(8192)]; // using a reasonable buffer size
        this.pos = 0;
        this.limit = 0;
    }

    @Override
    public int read() throws IOException {
        if (pos >= limit) {
            fillBuffer();
            if (pos >= limit) {
                return -1; // end of stream
            }
        }
        return buffer[pos++] & 0xFF;
    }

    @Override
    public int read(byte[] b, int off, int len) throws IOException {
        if (b == null) {
            throw new NullPointerException();
        } else if (off < 0 || len < 0 || len > b.length - off) {
            throw new IndexOutOfBoundsException();
        } else if (len == 0) {
            return 0;
        }

