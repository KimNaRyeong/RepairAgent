package com.google.javascript.jscomp;

import com.google.javascript.rhino.Node;
import com.google.javascript.jscomp.NodeTraversal;
import java.util.HashMap;
import java.util.Map;

public class ScopedAliases {

    private final NodeTraversal t;
    private final Map<String, Node> aliases;

    public ScopedAliases(NodeTraversal t) {
        this.t = t;
        this.aliases = new HashMap<>();
    }

    public void findAliases(NodeTraversal t) {
        t.traverse(new NodeTraversal.Callback() {
            @Override
            public boolean shouldTraverse(NodeTraversal nodeTraversal, Node n, Node parent) {
                return true;
            }

            @Override
            public void visit(NodeTraversal nodeTraversal, Node n, Node parent) {
                if (n.isName() && n.getParent().isVar()) {
                    String name = n.getString();
                    aliases.put(name, n);
                }
            }
        });
    }
}
