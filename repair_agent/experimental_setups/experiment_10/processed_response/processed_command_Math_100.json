                    "insertions": [
                        {
                            "line_number": 38,
                            "new_lines": [
                                "    /**",
                                "     * Computes the covariances between the columns of the input matrix.",
                                "     *",
                                "     * @param data input matrix with columns representing variables",
                                "     * @return the matrix of covariances",
                                "     */",
                                "    public RealMatrix getCovariances(RealMatrix data) {",
                                "        int nVars = data.getColumnDimension();",
                                "        int nObs = data.getRowDimension();",
                                "",
                                "        // Compute mean vector",
                                "        double[] means = new double[nVars];",
                                "        for (int i = 0; i < nVars; i++) {",
                                "            means[i] = StatUtils.mean(data.getColumn(i));",
                                "        }",
                                "",
                                "        // Compute covariances",
                                "        RealMatrix covariances = new Array2DRowRealMatrix(nVars, nVars);",
                                "        for (int i = 0; i < nVars; i++) {",
                                "            for (int j = i; j < nVars; j++) {",
                                "                double covariance = 0;",
                                "                for (int k = 0; k < nObs; k++) {",
                                "                    covariance += (data.getEntry(k, i) - means[i]) * (data.getEntry(k, j) - means[j]);",
                                "                }",
                                "                covariance /= (nObs - 1);",
                                "                covariances.setEntry(i, j, covariance);",
                                "                covariances.setEntry(j, i, covariance); // Covariance matrix is symmetric",
                                "            }",
                                "        }",
                                "",
                                "        return covariances;",
                                "    }"
                            ]
                        }
                    ]
                }
            ]
        }
    },
