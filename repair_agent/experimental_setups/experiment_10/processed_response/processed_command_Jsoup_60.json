                    "deletions": [],
                    "modifications": [
                        {
                            "line_number": 289,
                            "modified_line": "    public String chompBalanced(char open, char close) {\n        int start = -1;\n        int end = -1;\n        int depth = 0;\n        char last = 0;\n        boolean inQuote = false;\n\n        while (pos < queue.length()) {\n            char c = queue.charAt(pos);\n            if (last == ESC) {\n                // skip char\n            } else if (c == open) {\n                if (start == -1) {\n                    start = pos;\n                }\n                depth++;\n            } else if (c == close) {\n                depth--;\n                if (depth == 0) {\n                    end = pos;\n                    break;\n                }\n            } else if (c == '\"' || c == \"'\") {\n                inQuote = !inQuote;\n            }\n            last = c;\n            pos++;\n        }\n\n        if (end >= 0) {\n            return queue.substring(start, end + 1);\n        } else {\n            return \"\";\n        }\n    }"
                        }
                    ]
                }
            ]
        }
