                            "modified_line": "public void tryRemoveUnconditionalBranching(NodeTraversal t, Node n, Node parent) {\n    if (n.isIf() && n.getChildCount() == 2) {\n      Node condition = n.getFirstChild();\n      Node ifBlock = n.getLastChild();\n      Node grandparent = parent.getParent();\n\n      if (grandparent != null && grandparent.isBlock() && grandparent.getParent().isLabel() && ifBlock.isBlock() && ifBlock.hasOneChild()) {\n        Node labelParent = grandparent.getParent();\n        Node newBlock = ifBlock.removeFirstChild();\n        grandparent.replaceWith(newBlock.detach());\n        labelParent.removeChild(parent);\n      }\n    }\n}"
