                    "modifications": [
                        {
                            "line_number": 457,
                            "modified_line": "    protected JsonToken _nextToken2() throws IOException {\n        // First, clear any state\n        _currToken = null;\n\n        // Ok: common case first: did we have a token?\n        if (_exposedContext != null) {\n            JsonToken t = _exposedContext.nextTokenToRead();\n            if (t != null) {\n                // may need to update head context, if it should be closed\n                if (t == JsonToken.END_ARRAY || t == JsonToken.END_OBJECT) {\n                    if (_exposedContext.inArray()) {\n                        if (!_exposedContext.isStartHandled()) {\n                            _exposedContext.setStartHandled(true);\n                        } else {\n                            _headContext = _headContext.getParent();\n                            if (_headContext == null) {\n                                // Should we close the delegate, or just leave as is?\n                                return (_currToken = t);\n                            }\n                        }\n                    } else if (_exposedContext.inObject()) {\n                        if (!_exposedContext.isStartHandled() && _exposedContext.hasId()) {\n                            _exposedContext.setStartHandled(true);\n                        } else {\n                            _headContext = _headContext.getParent();\n                            if (_headContext == null) {\n                                // Should we close the delegate, or just leave as is?\n                                return (_currToken = t);\n                            }\n                        }\n                    }\n                }\n                return (_currToken = t);\n            }\n        }\n        // If not, need to do more work; may mean head context is different\n        while (_exposedContext != null) {\n            TokenFilterContext ctxt = _headContext.findChildOf(_exposedContext);\n            if (ctxt != null) {\n                // If so, need to ask it to provide next token\n                JsonToken t = ctxt.nextTokenToRead();\n                if (t != null) {\n                    return (_currToken = t);\n                }\n                // if not, move to the next sibling\n            }\n            // no more children; move back until we find a sibling\n            _exposedContext = _exposedContext.getParent();\n            if (_exposedContext == null) {\n                return (_currToken = null);\n            }\n            if (_headContext == null) {\n                _headContext = _exposedContext;\n            }\n            if (_exposedContext.inArray()) {\n                if (!_exposedContext.isStartHandled()) {\n                    _exposedContext.setStartHandled(true);\n                    return (_currToken = JsonToken.START_ARRAY);\n                }\n            } else if (_exposedContext.inObject()) {\n                if (!_exposedContext.isStartHandled() && _exposedContext.hasId()) {\n                    _exposedContext.setStartHandled(true);\n                    return (_currToken = JsonToken.START_OBJECT);\n                }\n            }\n        }\n        // we should never get here\n        throw new IllegalStateException(\"Internal error: failed to find parent context for a token\");\n    }"
                        }
                    ]
                }
            ]
        }
    },
