                        {
                            "line_number": 38,
                            "modified_line": "    public static String unescape(String htmlEscapedString) {\n        Map<String, String> escapeMap = new HashMap<>();\n        escapeMap.put(\"quot\", \"\\\"\");\n        escapeMap.put(\"amp\", \"&\");\n        escapeMap.put(\"lt\", \"<\");\n        escapeMap.put(\"gt\", \">\");\n        \n        String unescapedString = htmlEscapedString;\n        \n        // Unescape standard HTML entities\n        for (Map.Entry<String, String> entry : escapeMap.entrySet()) {\n            unescapedString = unescapedString.replaceAll(\"&\" + entry.getKey() + \";\", entry.getValue());\n        }\n        \n        // Unescape decimal HTML entities\n        Pattern decimalPattern = Pattern.compile(\"&#(\\\\d+);\");\n        Matcher decimalMatcher = decimalPattern.matcher(unescapedString);\n        while (decimalMatcher.find()) {\n            int decimalValue = Integer.parseInt(decimalMatcher.group(1));\n            unescapedString = unescapedString.replace(\"&#\" + decimalValue + \";\", Character.toString((char) decimalValue));\n        }\n        \n        // Unescape hex HTML entities\n        Pattern hexPattern = Pattern.compile(\"&#x([0-9A-Fa-f]+);\");\n        Matcher hexMatcher = hexPattern.matcher(unescapedString);\n        while (hexMatcher.find()) {\n            int hexValue = Integer.parseInt(hexMatcher.group(1), 16);\n            unescapedString = unescapedString.replace(\"&#x\" + hexMatcher.group(1) + \";\", Character.toString((char) hexValue));\n        }\n        \n        return unescapedString;\n    }"
                        }
                    ]
                }
            ]
