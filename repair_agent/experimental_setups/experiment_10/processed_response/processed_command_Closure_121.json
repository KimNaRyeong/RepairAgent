                            "line_number": 1,
                            "modified_line": "package com.google.javascript.jscomp;\n\nimport com.google.javascript.rhino.Node;\nimport com.google.javascript.rhino.Token;\n\n/**\n * This class implements the inlining behavior for non-constant variables.\n */\nclass InlineVariables$InliningBehavior {\n\n  /**\n   * Inlines non-constant variables in the given node.\n   *\n   * @param n The node to process\n   */\n  public void inlineNonConstants(Node n) {\n    NodeTraversal.traverseEs6(compiler, n, new AbstractShallowCallback() {\n      @Override\n      public void visit(NodeTraversal t, Node node, Node parent) {\n        if (node.isName() && !NodeUtil.isConstantVar(node)) {\n          Node replacement = InlineVariables.this.getReplacement(\n              t, node, parent);\n          if (replacement != null) {\n            parent.replaceChild(node, replacement);\n            t.reportCodeChange();\n          }\n        }\n      }\n    });\n  }\n}"
                        }
                    ]
                }
