    // Method to count the occurrences of each character in a given string
    public void getCounts(String input) {
        // Create a map to store character counts
        Map<Character, Integer> charCounts = new HashMap<>();

        // Convert the input string to lowercase for case-insensitive counting
        input = input.toLowerCase();

        // Iterate through each character in the input string
        for (char c : input.toCharArray()) {
            // Update the count of the current character in the map
            charCounts.put(c, charCounts.getOrDefault(c, 0) + 1);
        }

        // Print the character counts
        for (Map.Entry<Character, Integer> entry : charCounts.entrySet()) {
            System.out.println(entry.getKey() + ": " + entry.getValue());
        }
    }
}
