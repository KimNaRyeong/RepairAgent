              "    protected double doSolve() throws TooManyEvaluationsException {",
              "        // Get initial guess",
              "        double x0 = getStartValue();",
              "        double x1 = getStartValue() + 1.0;",
              "",
              "        // Get the function value at x0 and x1",
              "        double f0 = computeObjectiveValue(x0);",
              "        double f1 = computeObjectiveValue(x1);",
              "",
              "        // Iteratively find the root",
              "        while (true) {",
              "            // Check for convergence",
              "            if (Math.abs(f1) < Math.abs(f0)) {",
              "                // Swap x0 and x1",
              "                double temp = x0;",
              "                x0 = x1;",
              "                x1 = temp;",
              "",
              "                // Swap f0 and f1",
              "                temp = f0;",
              "                f0 = f1;",
              "                f1 = temp;",
              "            }",
              "",
              "            // Check for convergence",
              "            double dx = x1 - x0;",
              "            double tolerance = getRelativeAccuracy() * (Math.abs(x0) + Math.abs(x1)) * 0.5;",
              "            if (Math.abs(dx) <= tolerance || Math.abs(f1) <= getFunctionValueAccuracy()) {",
              "                setResult(x1);",
              "                return x1;",
              "            }",
              "",
              "            // Compute the next approximation of the root",
              "            double x = x1 - f1 * (x1 - x0) / (f1 - f0);",
              "",
              "            // Update the variables for next iteration",
              "            x0 = x1;",
              "            f0 = f1;",
              "            x1 = x;",
              "            f1 = computeObjectiveValue(x);",
              "        }",
              "    }"
            ]
          }
