            "line_number": 580,
            "modified_line": "    public char[] expandCurrentSegment()\n    {\n        final char[] curr = _currentSegment;\n        // Let's grow by 50% by default\n        final int len = curr.length;\n        // but above intended maximum, slow to increase by 25%\n        int newLen = (len == MAX_SEGMENT_LEN) ? (MAX_SEGMENT_LEN+1) : Math.min(MAX_SEGMENT_LEN, len + (len >> 1));\n        return (_currentSegment = Arrays.copyOf(curr, newLen));\n    }"
          },
          {
            "line_number": 580,
            "modified_line": "    private void expandCurrentSegment(int minSize)\n    {\n        if (_currentSegment == null || _currentSize + minSize > _currentSegment.length) {\n            int newSize = (_currentSegment == null) ? Math.max(MIN_SEGMENT_LEN, minSize) :\n                    Math.max(_currentSegment.length + _currentSegment.length, minSize);\n            _currentSegment = _allocator.allocCharBuffer(BufferRecycler.CharBufferType.TEXT_BUFFER, newSize);\n            _segmentSize += _currentSize;\n            if (_segments == null) {\n                _segments = new ArrayList<>();\n            }\n            _segments.add(_currentSegment);\n            _hasSegments = true;\n            _currentSize = 0;\n        }\n    }"
          }
        ]
      }
    ]
  }
