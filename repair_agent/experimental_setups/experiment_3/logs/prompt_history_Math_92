    /**
     * Returns the binomial coefficient of n and k, calculated as n! / (k! * (n-k)!).
     * This method uses double precision for the calculation.
     *
     * @param n the total number of items
     * @param k the number of items to choose
     * @return the binomial coefficient of n and k
     */
    public double binomialCoefficientDouble(int n, int k) {
        if (k < 0 || k > n) {
            return 0;
        }
        
        if (k == 0 || k == n) {
            return 1;
        }
        
        if (k > n - k) {
            k = n - k;
        }
        
        double result = 1.0;
        for (int i = 1; i <= k; i++) {
            result *= (double) (n - k + i) / i;
        }
        
        return result;
    }
