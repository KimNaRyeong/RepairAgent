    public void inlineAliases(GlobalNamespace globalNamespace) {
        // Iterate over all the namespaces in reverse topological order
        for (Namespace namespace : globalNamespace.topoSort()) {
            // Iterate over the properties of the namespace
            for (Name name : namespace.properties) {
