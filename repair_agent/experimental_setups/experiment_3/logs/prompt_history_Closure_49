public class ClosureCompiler {
    
    // Method to find declared names in a given input string
    public void findDeclaredNames(String input) {
        Set<String> declaredNames = new HashSet<>();
        
        // Split the input string by spaces and iterate over each word
        String[] words = input.split(" ");
        for (String word : words) {
            // Check if the word is a valid identifier
            if (isValidIdentifier(word)) {
                declaredNames.add(word);
            }
        }
        
        // Print out the declared names
        System.out.println("Declared names:");
        for (String name : declaredNames) {
            System.out.println(name);
        }
    }
    
    // Method to check if a given string is a valid identifier
    private boolean isValidIdentifier(String str) {
        // Check if the string is not empty and starts with a letter or underscore
        if (str.isEmpty() || !(Character.isLetter(str.charAt(0)) || str.charAt(0) == '_')) {
            return false;
        }
        
        // Check if the rest of the string only contains letters, digits, or underscores
        for (int i = 1; i < str.length(); i++) {
            char ch = str.charAt(i);
            if (!(Character.isLetterOrDigit(ch) || ch == '_')) {
                return false;
            }
        }
        
        return true;
    }
}
