public class TypedPercent {

    // Method to calculate the percentage of typed characters in a given string
    public double getTypedPercent(String input) {
        // Initialize variables to count total characters and typed characters
        int totalChars = 0;
        int typedChars = 0;

        // Loop through each character in the input string
        for (int i = 0; i < input.length(); i++) {
            char c = input.charAt(i);
            // Check if the character is a letter or a digit
            if (Character.isLetterOrDigit(c)) {
                typedChars++;
            }
            totalChars++;
        }

        // Calculate the percentage of typed characters
        double typedPercent = ((double) typedChars / totalChars) * 100;

        return typedPercent;
    }
}
