[{'file_name': 'org/apache/commons/cli/HelpFormatter.java', 'insertions': [{'line_number': 730, 'new_lines': ['    private static final int WRAP_WIDTH = 400;\n\n    public void renderWrappedText(Graphics2D g2d, String text, int x, int y) {\n        FontRenderContext frc = g2d.getFontRenderContext();\n        TextLayout textLayout = new TextLayout(text, g2d.getFont(), frc);\n        float wrappingWidth = WRAP_WIDTH;\n        float penX = x;\n        float penY = y + textLayout.getAscent();\n        for (String line : getWrappedLines(text, g2d)) {\n            textLayout = new TextLayout(line, g2d.getFont(), frc);\n            textLayout.draw(g2d, penX, penY);\n            penY += textLayout.getAscent() + textLayout.getDescent() + textLayout.getLeading();\n        }\n    }\n\n    private String[] getWrappedLines(String text, Graphics2D g2d) {\n        if (g2d.getFontMetrics().stringWidth(text) < WRAP_WIDTH) {\n            return new String[] {text};\n        }\n        String[] words = text.split("\\\\s");\n        StringBuilder wrappedText = new StringBuilder();\n        int lineLength = 0;\n        for (String word : words) {\n            if (g2d.getFontMetrics().stringWidth(word) + lineLength < WRAP_WIDTH) {\n                wrappedText.append(word).append(" ");\n                lineLength += g2d.getFontMetrics().stringWidth(word + " ");\n            } else {\n                wrappedText.append("\\n").append(word).append(" ");\n                lineLength = g2d.getFontMetrics().stringWidth(word + " ");\n            }\n        }\n        return wrappedText.toString().split("\\n");\n    }']}], 'deletions': [], 'modifications': []}]

