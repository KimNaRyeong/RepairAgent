import org.apache.commons.math.linear.RealMatrix;

public class CholeskyDecompositionImpl {

    /**
     * Calculates the Cholesky decomposition of a real symmetric positive definite matrix.
     *
     * @param matrix the real symmetric positive definite matrix to be decomposed
     * @param small the small positive number to compare with zero
     * @param sqrtSmall the square root of small number
     */
    public CholeskyDecompositionImpl(RealMatrix matrix, double small, double sqrtSmall) {
        // Implementation of Cholesky decomposition
        // Check if the matrix is symmetric
        if (!matrix.isSymmetric()) {
            throw new IllegalArgumentException("Matrix is not symmetric");
        }

        // Get the number of rows of the matrix
        int n = matrix.getRowDimension();

        // Initialize the lower triangular matrix L
        double[][] lMatrix = new double[n][n];

        // Perform Cholesky decomposition
        for (int i = 0; i < n; i++) {
            double sum = 0.0;
            for (int k = 0; k < i; k++) {
                sum += lMatrix[i][k] * lMatrix[i][k];
            }
            double diagonalElement = matrix.getEntry(i, i) - sum;
            if (diagonalElement <= small) {
                throw new IllegalArgumentException("Matrix is not positive definite");
            }
            lMatrix[i][i] = Math.sqrt(diagonalElement);
            double inverseDiagonalElement = 1.0 / lMatrix[i][i];

            for (int j = i + 1; j < n; j++) {
                sum = 0.0;
                for (int k = 0; k < i; k++) {
                    sum += lMatrix[j][k] * lMatrix[i][k];
                }
                lMatrix[j][i] = (matrix.getEntry(j, i) - sum) * inverseDiagonalElement;
            }
        }
    }

    // Other methods related to Cholesky decomposition can be added here
}
