package org.apache.commons.cli;

import java.util.ArrayList;
import java.util.List;

public class PosixParser {

    // Method to burst a token into its constituent parts
    public void burstToken(String token, boolean eatTheRest) {
        List<String> tokens = new ArrayList<>();
        int index = 0;
        StringBuilder builder = new StringBuilder();

        // Loop through the characters in the token
        while (index < token.length()) {
            char c = token.charAt(index);

            // Check for special characters that indicate a new token
            if (c == ' ' || c == '\t' || c == '\n') {
                if (builder.length() > 0) {
                    tokens.add(builder.toString());
                    builder.setLength(0);
                }
            } else {
                builder.append(c);
            }

            index++;
        }

        // Add the last token if it exists
        if (builder.length() > 0) {
            tokens.add(builder.toString());
        }

        // If eatTheRest is true, add the remaining token as a single token
        if (eatTheRest && !tokens.isEmpty()) {
            StringBuilder restBuilder = new StringBuilder();
            for (String t : tokens) {
                restBuilder.append(t);
            }
            tokens.clear();
            tokens.add(restBuilder.toString());
        }

        // Print the burst tokens
        for (String t : tokens) {
            System.out.println(t);
        }
    }
}
