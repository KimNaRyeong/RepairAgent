public class MathUtils {

    /**
     * Get the numerical mean of a list of double values.
     *
     * @param values List of double values
     * @return The numerical mean of the values
     */
    public double getNumericalMean(List<Double> values) {
        if (values == null || values.isEmpty()) {
            throw new IllegalArgumentException("List of values is null or empty");
