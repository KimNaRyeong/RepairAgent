    /**
     * Smoothes the input data by averaging each value with its neighbors within a specified window size.
     * @param data The input data to be smoothed
     * @param windowSize The size of the window for smoothing
     */
    public void smooth(double[] data, int windowSize) {
        if (data == null || data.length == 0 || windowSize <= 0) {
            return;
        }

        double[] smoothedData = new double[data.length];

        for (int i = 0; i < data.length; i++) {
            int start = Math.max(0, i - windowSize / 2);
            int end = Math.min(data.length - 1, i + windowSize / 2);
            double sum = 0.0;
            int count = 0;

            for (int j = start; j <= end; j++) {
                sum += data[j];
                count++;
            }

            smoothedData[i] = sum / count;
        }

        System.arraycopy(smoothedData, 0, data, 0, data.length);
    }
