    /**
     * Find the first whitespace character that's not inside a quote.
     * @param str  The string to search
     * @param start The position to start searching at
     * @return The position of the first whitespace character, or -1 if not found
     */
    public int findWrapPos(String str, int start) {
        boolean inQuote = false;
        int len = str.length();

        for (int i = start; i < len; i++) {
            char c = str.charAt(i);
            if (c == '"') {
                inQuote = !inQuote;
            } else if (!inQuote && Character.isWhitespace(c)) {
                return i;
            }
        }

        return -1; // No wrap position found
    }
