        StringBuilder unescapedString = new StringBuilder();

        // Iterate over the matches and unescape the string
        while (matcher.find()) {
            if (matcher.group(2) != null) {
                // Numeric character reference
                int charValue = Integer.parseInt(matcher.group(2));
                matcher.appendReplacement(unescapedString, String.valueOf((char) charValue));
