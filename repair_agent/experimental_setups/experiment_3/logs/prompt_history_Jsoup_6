        // Define the HTML escape regex pattern
        Pattern escapePattern = Pattern.compile("(&#(\\d+);|&([a-zA-Z]+);)");

        // Create a map for special HTML characters
        Map<String, String> specialChars = new HashMap<>();
        specialChars.put("quot", "\"");
