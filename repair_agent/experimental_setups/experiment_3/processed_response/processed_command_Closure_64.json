                                "    // Updated toSource method implementation for generating JavaScript source code\n",
                                "    public String toSource(Node n) {\n",
                                "        if (n == null) {\n",
                                "            return \"null\";\n",
                                "        }\n",
                                "        StringBuilder sb = new StringBuilder();\n",
                                "        toSourceHelper(n, sb, 0);\n",
                                "        return sb.toString();\n",
                                "    }\n",
                                "    private void toSourceHelper(Node n, StringBuilder sb, int indent) {\n",
                                "        for (int i = 0; i < indent; i++) {\n",
                                "            sb.append(\"  \"); // Add 2 spaces for each level of indentation\n",
                                "        }\n",
                                "        sb.append(n.getType().toString()); // Append the type of the node\n",
                                "        if (n.getSourceFileName() != null) {\n",
                                "            sb.append(\" [\").append(n.getSourceFileName()).append(\":\").append(n.getLineno()).append(\"]\"); // Append source file name and line number if available\n",
                                "        }\n",
                                "        if (n.getFirstChild() != null) {\n",
                                "            sb.append(\" {\\n\"); // Append opening curly brace if the node has children\n",
                                "            for (Node child = n.getFirstChild(); child != null; child = child.getNext()) {\n",
                                "                toSourceHelper(child, sb, indent + 1); // Recursively call toSourceHelper for each child with increased indentation\n",
                                "            }\n",
                                "            for (int i = 0; i < indent; i++) {\n",
                                "                sb.append(\"  \"); // Add indentation for the closing curly brace to align with the opening brace\n",
                                "            }\n",
                                "            sb.append(\"}\");\n",
                                "        }\n",
                                "        sb.append(\"\\n\"); // Add newline after processing the node\n",
                                "    }\n"
                            ]
                        }
                    ]
                }
            ]
        }
