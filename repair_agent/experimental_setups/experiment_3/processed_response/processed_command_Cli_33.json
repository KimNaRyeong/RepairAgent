                            "modified_line": "public void renderWrappedText(String text, int maxLength) {\n    int index = 0;\n    while (index < text.length()) {\n        int endIndex = Math.min(index + maxLength, text.length());\n        System.out.println(text.substring(index, endIndex));\n        index = endIndex;\n    }\n}"
