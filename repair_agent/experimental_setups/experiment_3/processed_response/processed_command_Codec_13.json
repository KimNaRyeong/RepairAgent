                            "line_number": 22,
                            "modified_line": "public boolean isDoubleMetaphoneEqual(String str1, String str2) {\n    // Encode the first string using Double Metaphone\n    String encodedStr1 = org.apache.commons.codec.language.DoubleMetaphone.doubleMetaphone(str1);\n    // Encode the second string using Double Metaphone\n    String encodedStr2 = org.apache.commons.codec.language.DoubleMetaphone.doubleMetaphone(str2);\n    // Compare the Double Metaphone encodings for equality\n    return encodedStr1 != null && encodedStr2 != null && encodedStr1.equals(encodedStr2);\n}"
                        }
