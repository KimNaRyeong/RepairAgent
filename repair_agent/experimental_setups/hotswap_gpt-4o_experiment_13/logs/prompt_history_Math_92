    public double binomialCoefficientDouble(int n, int k) {
        if (k < 0 || k > n) {
            return 0.0;
        }
        
        if (k == 0 || k == n) {
            return 1.0;
        }
        
        double result = 1.0;
        
        for (int i = 1; i <= k; i++) {
            result = result * (n - i + 1) / i;
        }
        
        return result;
    }
