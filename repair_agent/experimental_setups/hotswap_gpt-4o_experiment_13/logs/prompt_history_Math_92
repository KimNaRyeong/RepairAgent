    public static long binomialCoefficient(int n, int k) {
        if (k < 0 || k > n) {
            return 0;
        }
        
        if (k == 0 || k == n) {
            return 1;
        }
        
        k = Math.min(k, n - k); // Optimize for smaller k
        
