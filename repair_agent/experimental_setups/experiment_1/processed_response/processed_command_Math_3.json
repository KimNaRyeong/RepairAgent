                                "    /**",
                                "     * Computes the linear combination of two arrays.",
                                "     *",
                                "     * @param a the array to be multiplied",
                                "     * @param alpha the scalar multiplier for the first array",
                                "     * @param b the second array to be multiplied",
                                "     * @param beta the scalar multiplier for the second array",
                                "     * @return the result of the linear combination",
                                "     * @throws IllegalArgumentException if the arrays don't have the same length",
                                "     */",
                                "    public static double[] linearCombination(double[] a, double alpha, double[] b, double beta) {",
                                "        if (a.length != b.length) {",
                                "            throw new IllegalArgumentException(\"Arrays must have the same length\");",
                                "        }",
                                "",
                                "        double[] result = new double[a.length];",
                                "        for (int i = 0; i < a.length; i++) {",
                                "            result[i] = alpha * a[i] + beta * b[i];",
                                "        }",
                                "",
                                "        return result;",
                                "    }"
                            ]
                        }
                    ]
                }
            ]
        }
