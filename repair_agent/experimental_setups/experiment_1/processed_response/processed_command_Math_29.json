                    "modifications": [
                        {
                            "line_number": 359,
                            "modified_line": "public OpenMapRealVector ebeDivide(RealVector v) {\n checkVectorDimensions(v.getDimension());\n OpenMapRealVector res = new OpenMapRealVector(this);\n Iterator iter = entries.iterator();\n while (iter.hasNext()) {\n iter.advance();\n if (Double.isNaN(iter.value()) || Double.isNaN(v.getEntry(iter.key())) || Double.isInfinite(iter.value()) || Double.isInfinite(v.getEntry(iter.key())) || v.getEntry(iter.key()) == 0.0) {\n res.setEntry(iter.key(), Double.NaN);\n } else {\n res.setEntry(iter.key(), iter.value() / v.getEntry(iter.key()));\n }\n }\n return res;\n }"
                        },
                        {
                            "line_number": 365,
                            "modified_line": "public OpenMapRealVector ebeMultiply(RealVector v) {\n checkVectorDimensions(v.getDimension());\n OpenMapRealVector res = new OpenMapRealVector(this);\n Iterator iter = entries.iterator();\n while (iter.hasNext()) {\n iter.advance();\n if (Double.isNaN(iter.value()) || Double.isNaN(v.getEntry(iter.key())) || Double.isInfinite(iter.value()) || Double.isInfinite(v.getEntry(iter.key())) || v.getEntry(iter.key()) == 0.0) {\n res.setEntry(iter.key(), Double.NaN);\n } else {\n res.setEntry(iter.key(), iter.value() * v.getEntry(iter.key()));\n }\n }\n return res;\n }"
                        }
                    ]
                }
            ]
        }
