                                "// Method to check if a reference can be inlined directly",
                                "public boolean canInlineReferenceDirectly(Node node) {",
                                "    // Check if the node is a variable or property reference",
                                "    if (node.isName() || node.isGetProp()) {",
                                "        return true;",
                                "    }",
                                "    // Check if the node is a call to a simple function",
                                "    if (node.isCall() && node.getFirstChild().isName()) {",
                                "        return true;",
                                "    }",
                                "    // Check if the node is a simple object literal",
                                "    if (node.isObjectLit()) {",
                                "        return true;",
                                "    }",
