                    "insertions": [
                        {
                            "line_number": 156,
                            "new_lines": [
                                "    /**",
                                "     * Returns the index of the row to use as pivot.",
                                "     * Pivot row is the row with the largest absolute value in the column of the current pivot element.",
                                "     *",
                                "     * @param matrix The matrix being worked on",
                                "     * @param col    The column of the current pivot element",
                                "     * @return The index of the pivot row",
                                "     */",
                                "    public int getPivotRow(double[][] matrix, int col) {",
                                "        int pivotRow = col;",
                                "        double maxVal = Math.abs(matrix[col][col]);",
                                "",
                                "        for (int i = col + 1; i < matrix.length; i++) {",
                                "            double currentVal = Math.abs(matrix[i][col]);",
                                "            if (currentVal > maxVal) {",
                                "                maxVal = currentVal;",
                                "                pivotRow = i;",
                                "            }",
                                "        }",
                                "",
                                "        return pivotRow;",
                                "    }"
                            ]
                        }
                    ]
                }
            ]
        }
