                    "insertions": [
                        {
                            "line_number": 156,
                            "new_lines": [
                                "    /**",
                                "     * Returns the index of the pivot column in the input matrix.",
                                "     * The pivot column is the leftmost column containing a negative value in the last row.",
                                "     *",
                                "     * @param matrix The input matrix",
                                "     * @return The index of the pivot column, or -1 if no pivot column is found",
                                "     */",
                                "    public int getPivotColumn(double[][] matrix) {",
                                "        int lastRow = matrix.length - 1;",
                                "        for (int j = 0; j < matrix[0].length; j++) {",
                                "            if (matrix[lastRow][j] < 0) {",
                                "                return j;",
                                "            }",
                                "        }",
                                "        return -1; // No pivot column found",
                                "    }"
                            ]
                        }
                    ]
                }
            ]
        }
