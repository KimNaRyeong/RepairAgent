public void removeUnreferencedFunctionArgs(AbstractCompiler compiler, Node fn) {
    Node param = fn.getFirstChild().getNext();
    Node arg = fn.getLastChild().getFirstChild();
    
    while (param != null && arg != null) {
        if (!isParamReferenced(compiler, param, fn)) {
            Node nextParam = param.getNext();
            Node nextArg = arg.getNext();
            fn.removeChild(param);
            fn.getLastChild().removeChild(arg);
            param = nextParam;
            arg = nextArg;
        } else {
            param = param.getNext();
            arg = arg.getNext();
        }
    }
}

private boolean isParamReferenced(AbstractCompiler compiler, Node param, Node fn) {
    String paramName = param.getString();
    Node parent = param.getParent();

    NodeTraversal.Callback checkReferences =
        new NodeTraversal.Callback() {
            @Override
            public boolean shouldTraverse(NodeTraversal t, Node n, Node parent) {
                return true;
            }

            @Override
            public void visit(NodeTraversal t, Node node, Node parent) {
                if (node.isName() && node.getString().equals(paramName) && parent != param && parent != fn) {
                    compiler.report(t.makeError(node, "Unreferenced function parameter"));
                }
            }
        };

    NodeTraversal.traverse(compiler, parent, checkReferences);
    
    // If the parameter was not referenced, the error would have been reported
    return compiler.getErrorCount() == 0;
}
