/**
 * Compute the arc tangent of y/x, with a range of -pi to pi,
 * even if x = 0. The signs of both parameters are used to determine the
 * quadrant of the result. The range of the result is -pi to pi.
 *
 * @param y ordinate coordinate
 * @param x abscissa coordinate
 * @return the arc tangent of y/x
 */
public static double atan2(double y, double x) {
    if (x == 0.0) {
        if (y > 0.0) {
            return Math.PI / 2.0;
        }
        if (y == 0.0) {
            return 0.0; // return 0.0 if (x,y) is (0,0)
        }
        return -Math.PI / 2.0;
    }

    final double z = Math.atan(y / x);

    // Correct the angle if it is in quadrant II or III
    if (x < 0.0) {
        return Math.copySign(Math.PI - Math.abs(z), y);
    }

    return z;
}
