        this.inlineObjectLiterals = inlineObjectLiterals;
    }

    /**
     * Checks if the given node is an object that can be inlined.
     * An object is considered inlineable if it has only string keys and literal (non-computed) values.
     *
     * @param node The node to check if it's an inlineable object.
