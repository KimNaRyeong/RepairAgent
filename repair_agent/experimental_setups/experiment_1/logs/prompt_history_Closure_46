public class TypeUtils {
    
    // Method to get the least common supertype of two classes
    public static Class<?> getLeastSupertype(Class<?> class1, Class<?> class2) {
        // Get all superclasses of class1
        Set<Class<?>> superclasses1 = getSuperclasses(class1);

        // Get all superclasses of class2
        Set<Class<?>> superclasses2 = getSuperclasses(class2);

        // Find the first common superclass from the sets
        for (Class<?> superclass : superclasses1) {
            if (superclasses2.contains(superclass)) {
                return superclass;
            }
        }

        // If no common superclass found, return Object class
        return Object.class;
    }

    // Helper method to get all superclasses of a class
    private static Set<Class<?>> getSuperclasses(Class<?> clazz) {
        Set<Class<?>> superclasses = new HashSet<>();
        Class<?> superclass = clazz.getSuperclass();
        while (superclass != null) {
            superclasses.add(superclass);
            superclass = superclass.getSuperclass();
        }
