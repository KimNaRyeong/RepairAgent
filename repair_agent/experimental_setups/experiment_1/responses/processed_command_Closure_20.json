              "// Checks whether the given function call is a simple call and if so, folds it.",
              "void tryFoldSimpleFunctionCall(Node callNode) {",
              "  // Check if the function call has only one child",
              "  if (callNode.getChildCount() == 1) {",
              "    Node functionNode = callNode.getFirstChild();",
              "",
              "    // Check if the child of the function call is a name",
              "    if (functionNode.isName()) {",
              "      String functionName = functionNode.getString();",
              "",
              "      // Check if the name of the function is \"String\"",
              "      if (\"String\".equals(functionName)) {",
              "        Node argument = functionNode.getNext();",
              "",
              "        // Check if the argument of the function is a string",
              "        if (argument.isString()) {",
              "          String value = argument.getString();",
              "          String result = \"\" + value;",
              "",
              "          // Replace the function call with the result",
              "          callNode.getParent().replaceChild(callNode, IR.string(result));",
              "        }",
              "      }",
              "    }",
              "  }",
              "}"
            ]
          }
        ]
      }
    ]
  }
}
