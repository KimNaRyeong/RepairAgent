          {
            "line_number": 344,
            "new_lines": [
              "    /**",
              "     * Build a rotation that transforms a pair of orthogonal vectors into another pair of orthogonal vectors.",
              "     * The two vectors do not have to be unit vectors.",
              "     *",
              "     * @param u1 first vector of the original frame",
              "     * @param u2 second vector of the original frame",
              "     * @param v1 first vector of the target frame",
              "     * @param v2 second vector of the target frame",
              "     * @throws MathArithmeticException if the input vectors are collinear",
              "     */",
              "    public Rotation(Vector3D u1, Vector3D u2, Vector3D v1, Vector3D v2) {",
              "        // Check that the u vectors are orthogonal",
              "        double normU1 = u1.getNorm();",
              "        if (normU1 == 0) {",
              "            throw new MathArithmeticException(LocalizedFormats.ZERO_NORM, u1);",
              "        }",
              "        double normU2 = u2.getNorm();",
              "        if (normU2 == 0) {",
              "            throw new MathArithmeticException(LocalizedFormats.ZERO_NORM, u2);",
              "        }",
              "        if (Math.abs(u1.dotProduct(u2) / (normU1 * normU2)) > 1 - 1.0e-12) {",
              "            throw new MathArithmeticException(LocalizedFormats.ZERO_NORM, u1, u2);",
              "        }",
              "",
              "        // Check that the v vectors are orthogonal",
              "        double normV1 = v1.getNorm();",
              "        if (normV1 == 0) {",
              "            throw new MathArithmeticException(LocalizedFormats.ZERO_NORM, v1);",
              "        }",
              "        double normV2 = v2.getNorm();",
              "        if (normV2 == 0) {",
              "            throw new MathArithmeticException(LocalizedFormats.ZERO_NORM, v2);",
              "        }",
              "        if (Math.abs(v1.dotProduct(v2) / (normV1 * normV2)) > 1 - 1.0e-12) {",
              "            throw new MathArithmeticException(LocalizedFormats.ZERO_NORM, v1, v2);",
              "        }",
              "",
              "        // check that the vectors are consistent",
              "        if (u1.crossProduct(u2).dotProduct(v1.crossProduct(v2)) < 0) {",
              "            throw new MathArithmeticException(LocalizedFormats.COLLINIAR_VECTORS, u1, u2, v1, v2);",
              "        }",
              "",
              "        // build the rotation",
              "        Vector3D u3 = u1.crossProduct(u2);",
              "        Vector3D v3 = v1.crossProduct(v2);",
              "        double[][] m = new double[3][3];",
              "        m[0][0] = u1.getX(); m[0][1] = u2.getX(); m[0][2] = u3.getX();",
              "        m[1][0] = u1.getY(); m[1][1] = u2.getY(); m[1][2] = u3.getY();",
              "        m[2][0] = u1.getZ(); m[2][1] = u2.getZ(); m[2][2] = u3.getZ();",
              "        RealMatrix rotation = new Array2DRowRealMatrix(m);",
              "        RealMatrix target = MatrixUtils.createRealMatrix(3, 3);",
              "        target.setColumnVector(0, v1);",
              "        target.setColumnVector(1, v2);",
              "        target.setColumnVector(2, v3);",
              "        RealMatrix combined = target.multiply(rotation.transpose());",
              "        this.q = new Quaternion(combined);",
              "    }"
            ]
          }
        ]
      }
    ]
  }
