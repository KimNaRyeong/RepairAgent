          {
            "line_number": 366,
            "new_lines": [
              "    // Fixing potential issue with local variables and scopes",
              "    public String functionSource(DebuggableScript function) {",
              "        String source = function.getSource().replace(\"\\r\\n\", \"\\n\");",
              "        StringBuilder sb = new StringBuilder();",
              "        DebuggableScript parent = function.getParent();",
              "        if (parent != null) {",
              "            int index = function.getFunctionIndex();",
              "            if (index >= 0) {",
              "                sb.append(function.getEncodedSourceStart()).append(\"\\n\");",
              "                int line = function.getFunction(index).getLineno();",
              "                int lineEnd = function.getFunction(index).getEndLineno();",
              "                if (lineEnd == -1) {",
              "                    lineEnd = line;",
              "                }",
              "                String[] lines = source.split(\"\\n\", -1);",
              "                for (int i = line - 1; i < lineEnd; i++) {",
              "                    sb.append(lines[i]);",
              "                    if (i < lineEnd - 1) {",
              "                        sb.append(\"\\n\");",
              "                    }",
              "                }",
              "            }",
              "        }",
              "        return sb.toString();",
              "    }"
            ]
          }
        ]
      }
    ]
  }
}
