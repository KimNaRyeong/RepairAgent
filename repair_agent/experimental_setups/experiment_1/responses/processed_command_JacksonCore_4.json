            "line_number": 582,
            "new_lines": [
              "    private void expandCurrentSegment(int delta) {",
              "        // Check if the current segment is null or empty",
              "        if (_currentSegment == null) {",
              "            _currentSegment = findBuffer(MIN_SEGMENT_LEN);",
              "        } else {",
              "            // Calculate the new size of the current segment",
              "            int newSize = _currentSize + delta;",
              "            if (newSize > _currentSegment.length) {",
              "                // If the new size exceeds the current segment length, allocate a new buffer",
              "                _currentSegment = findBuffer(Math.max(newSize, (int) (_currentSize * 1.5)));",
              "            }",
              "        }",
              "    }",
              "",
              "    private char[] findBuffer(int minimalSize) {",
              "        if (_allocator != null) {",
              "            // If a buffer allocator is available, use it to allocate a buffer",
              "            return _allocator.allocCharBuffer(BufferRecycler.BUFFER_STRING, minimalSize);",
              "        }",
              "        // Otherwise, allocate a new buffer with the specified size",
              "        return new char[Math.max(minimalSize, MIN_SEGMENT_LEN)];",
              "    }"
            ]
          }
        ],
        "deletions": [
          580,
          586
        ]
      }
    ]
  }
