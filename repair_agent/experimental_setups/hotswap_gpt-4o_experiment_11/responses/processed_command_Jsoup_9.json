          },
          {
            "line_number": 38,
            "modified_line": "    public static String unescape(String html) {\n        Map<String, String> escapeMap = new HashMap<>();\n        escapeMap.put(\"&quot;\", \"\\\"\");\n        escapeMap.put(\"&amp;\", \"&\");\n        escapeMap.put(\"&lt;\", \"<\");\n        escapeMap.put(\"&gt;\", \">\");\n        escapeMap.put(\"&nbsp;\", \"\\u00A0\");\n\n        for (Map.Entry<String, String> entry : escapeMap.entrySet()) {\n            html = html.replaceAll(entry.getKey(), entry.getValue());\n        }\n\n        Matcher matcher = Pattern.compile(\"&#(\\\\d+);\").matcher(html);\n        StringBuffer sb = new StringBuffer();\n        while (matcher.find()) {\n            int cp = Integer.parseInt(matcher.group(1));\n            matcher.appendReplacement(sb, Matcher.quoteReplacement(Character.toString((char) cp)));\n        }\n        matcher.appendTail(sb);\n\n        return sb.toString();\n    }"
          }
        ]
      }
    ]
  }
