        "modifications": [
          {
            "line_number": 457,
            "modified_line": "    public JsonToken _nextToken2() throws IOException {\n        // First, need to handle the case of 'virtual' START_OBJECT/ARRAY\n        TokenFilterContext ctxt = _exposedContext;\n        if (ctxt != null) {\n            // Most common case: pointing to the first token of a container\n            if (!_allowMultipleMatches && _currToken != null) {\n                return (_currToken = ctxt.nextTokenToRead());\n            }\n            while (true) {\n                JsonToken t = ctxt.nextTokenToRead();\n                if (t != null) {\n                    return (_currToken = t);\n                }\n                // Need to close the context? If so, that's the next thing\n                _exposedContext = ctxt = ctxt.close();\n                if (ctxt == null) { // closed the root context, nothing more to do\n                    return (_currToken = null);\n                }\n            }\n        }\n        // Otherwise just need to fetch a next token\n        if (_closed) {\n            return null;\n        }\n        JsonToken t = delegate.nextToken();\n        if (t == null) {\n            _currToken = t;\n            return t;\n        }\n        switch (t.id()) {\n        case ID_START_OBJECT:\n        case ID_START_ARRAY:\n            // Need to create a wrapping context\n            ctxt = _headContext.createChildArrayContext(_filter);\n            break;\n        case ID_END_OBJECT:\n        case ID_END_ARRAY:\n            // Need to close\n            ctxt = _headContext.closeArray();\n            if (ctxt == null) {\n                _exposedContext = _headContext;\n            }\n            break;\n        default:\n            ctxt = _headContext;\n            break;\n        }\n        return (_currToken = ctxt.nextTokenToRead());\n    }"
          }
        ]
      }
    ]
  }
}
