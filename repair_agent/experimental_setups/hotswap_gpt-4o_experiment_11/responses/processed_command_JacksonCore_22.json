    "project_name": "JacksonCore",
    "bug_index": "22",
    "changes_dicts": [
      {
        "file_name": "com/fasterxml/jackson/core/filter/FilteringParserDelegate.java",
        "modifications": [
          {
            "line_number": 457,
            "modified_line": "    @Override\n    public JsonToken nextToken() throws IOException {\n        // First, check if the parser is closed, and if so, just return null\n        if (_closed) {\n            return null;\n        }\n        \n        // If we have a currently active token, need to expose that first\n        if (_currToken == null) {\n            // No token; need to get the next available token\n            _currToken = _delegate.nextToken();\n            if (_currToken == null) {\n                // EOF, nothing more to do\n                return (_currToken);\n            }\n        }\n\n        // Now, we have a current token; let's filter it and return the next token\n        _currToken = _headContext.nextTokenToRead();\n        if (_currToken != null) {\n            return _currToken;\n        }\n\n        // If we get here, it means that we have advanced and need to check next token\n        do {\n            JsonToken t = _delegate.nextToken();\n            if (t == null) {\n                // No more tokens from delegate, we are done\n                return (_currToken = t);\n            }\n            TokenFilterState state = _headContext.checkValue(t);\n            if (state == TokenFilterState.END_ARRAY || state == TokenFilterState.END_OBJECT) {\n                if (_includePath) {\n                    _headContext = _headContext.closeForParent(t);\n                    _currToken = t;\n                    return t;\n                }\n            } else if (state != TokenFilterState.NOT_AVAILABLE) {\n                if (state == TokenFilterState.INCLUDE_AND_PATH) {\n                    _currToken = t;\n                    return t;\n                }\n                // Other states need more work\n                TokenFilter f = _headContext.checkProperty();\n                if (f == TokenFilter.INCLUDE_ALL) {\n                    _currToken = t;\n                    return t;\n                }\n                if (f == null) {\n                    throw _constructError(\"Property '\" + _headContext.getCurrentName() + \"' was filtered out\");\n                }\n                f = f.filterStartObject();\n                _itemFilter = f;\n                if (f == TokenFilter.INCLUDE_ALL) { // complete inclusion, just return\n                    return (_currToken = t);\n                }\n                _headContext = _headContext.createChildObjectContext(f);\n                _currToken = t;\n                return t;\n            }\n            // Otherwise, loop to find next token\n        } while (true);\n    }"
          }
        ]
      }
    ]
  }
}
