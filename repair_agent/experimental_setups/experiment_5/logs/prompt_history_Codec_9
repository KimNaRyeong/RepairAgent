    public int getEncodeLength(String str) {
        if (str == null || str.isEmpty()) {
            return 0;
        }

        int encodedLength = 0;
        char currentChar = str.charAt(0);
        int currentCharCount = 1;

        for (int i = 1; i < str.length(); i++) {
            char nextChar = str.charAt(i);
            if (nextChar == currentChar) {
