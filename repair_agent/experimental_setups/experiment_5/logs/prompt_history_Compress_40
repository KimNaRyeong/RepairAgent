     * @param inputStream the input stream to read from
     * @param numBits the number of bits to read
     * @return the bits read as a long value
     * @throws IOException if an I/O error occurs
     */
    public void readBits(InputStream inputStream, int numBits) throws IOException {
        // Initialize variables
        long result = 0;
        int remainingBits = numBits;
        int currentByte;
        int bitsRead = 0;

        while (remainingBits > 0) {
            // Check if we need to read more bytes
            if (bitsRead % 8 == 0) {
                currentByte = inputStream.read();
                if (currentByte == -1) {
                    throw new EOFException("End of stream reached before reading all bits");
                }
            }

            // Calculate the number of bits to read from the current byte
            int bitsToRead = Math.min(remainingBits, 8 - (bitsRead % 8));

            // Extract the bits from the current byte and update the result
            result = (result << bitsToRead) | ((currentByte >> (8 - (bitsRead % 8) - bitsToRead)) & ((1 << bitsToRead) - 1));

            // Update counters and shift bits
            remainingBits -= bitsToRead;
            bitsRead += bitsToRead;
        }

        return result;
    }
