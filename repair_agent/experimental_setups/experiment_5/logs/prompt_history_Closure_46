    // Method to get the least supertype of a set of types
    public static Class<?> getLeastSupertype(Set<Class<?>> types) {
        // Initialize the least supertype as Object class
        Class<?> leastSupertype = Object.class;
        
        // Iterate through each type in the set
        for (Class<?> type : types) {
            // Check if the current type is assignable from the least supertype
            // If true, update the least supertype to be the current type
            if (leastSupertype.isAssignableFrom(type)) {
                leastSupertype = type;
            } else {
                // Check if the least supertype is assignable from the current type
                // If true, no need to update the least supertype
                if (!type.isAssignableFrom(leastSupertype)) {
                    // If neither of the above conditions are met, set the least supertype to be Object class
                    leastSupertype = Object.class;
                    break;
                }
            }
        }
        
        return leastSupertype;
