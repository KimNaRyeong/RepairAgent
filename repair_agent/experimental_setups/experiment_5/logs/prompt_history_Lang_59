    /**
     * Appends the specified string to the end of the input string, padding the output to a fixed width by adding spaces on the right.
     * If the input string is already at or exceeds the fixed width, it is returned as is.
     * 
     * @param inputString the input string to append to
     * @param appendString the string to append
     * @param fixedWidth the total width of the output string after padding
     * @return the padded string
     */
    public static String appendFixedWidthPadRight(String inputString, String appendString, int fixedWidth) {
        if (inputString.length() >= fixedWidth) {
            return inputString;
        }

        StringBuilder paddedString = new StringBuilder(inputString);
        int spacesToAdd = fixedWidth - inputString.length();

        for (int i = 0; i < spacesToAdd; i++) {
            paddedString.append(" ");
        }

        paddedString.append(appendString);

        return paddedString.toString();
    }
