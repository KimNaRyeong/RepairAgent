    /**
     * Appends the specified character to the end of the input string until the resulting string reaches the given width.
     * If the input string is already equal to or longer than the specified width, it is returned unmodified.
     *
     * @param inputString The input string to pad.
     * @param width       The desired width of the resulting string.
     * @param padChar     The character to append to the input string.
     * @return The padded string.
     */
    public static String appendFixedWidthPadRight(String inputString, int width, char padChar) {
        if (inputString.length() >= width) {
            return inputString;
        }
        
        StringBuilder paddedString = new StringBuilder(inputString);
        int paddingLength = width - inputString.length();
        for (int i = 0; i < paddingLength; i++) {
