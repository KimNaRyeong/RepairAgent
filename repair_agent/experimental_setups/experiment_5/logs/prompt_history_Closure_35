import java.util.Set;

public class SupertypeUtils {

    /**
     * Returns the least common supertype of the given set of classes.
     *
     * @param classes set of classes to find the least common supertype for
     * @return the least common supertype
     */
    public static Class<?> getLeastSupertype(Set<Class<?>> classes) {
        if (classes == null || classes.isEmpty()) {
            throw new IllegalArgumentException("Input set of classes is null or empty");
        }

        Class<?> leastSupertype = classes.iterator().next();

        for (Class<?> clazz : classes) {
            leastSupertype = findLeastCommonSuperclass(leastSupertype, clazz);
        }

        return leastSupertype;
    }

    private static Class<?> findLeastCommonSuperclass(Class<?> class1, Class<?> class2) {
        while (!class1.isAssignableFrom(class2)) {
            class1 = class1.getSuperclass();
        }
        return class1;
    }
}
