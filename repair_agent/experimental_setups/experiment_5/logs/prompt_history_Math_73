    public boolean verifyBracketing(String input) {
        if (input == null || input.isEmpty()) {
            return true; // Empty string is considered to have correct bracketing
        }

        Stack<Character> stack = new Stack<>();
        for (char c : input.toCharArray()) {
            if (c == '(' || c == '[' || c == '{') {
                stack.push(c);
            } else if (c == ')' || c == ']' || c == '}') {
                if (stack.isEmpty()) {
                    return false; // Closing bracket with no matching opening bracket
                }
                char openingBracket = stack.pop();
                if ((c == ')' && openingBracket != '(') || (c == ']' && openingBracket != '[') || (c == '}' && openingBracket != '{')) {
                    return false; // Mismatched brackets
                }
            }
        }

        return stack.isEmpty(); // Return true if stack is empty (all brackets matched)
