public void traverseObjectLiteral(String objectLiteral, BiConsumer<String, String> callback) {
    // Regular expression to match key-value pairs in object literals
    Pattern pattern = Pattern.compile("\"(.*?)\":\\s*\"(.*?)\",?");
    
    // Create a matcher for the input object literal
    Matcher matcher = pattern.matcher(objectLiteral);
    
    // Find all key-value pairs and invoke the callback for each pair
    while (matcher.find()) {
        String key = matcher.group(1);
        String value = matcher.group(2);
        
        // Remove escape characters from key and value
        key = key.replaceAll("\\\\", "");
        value = value.replaceAll("\\\\", "");
        
        callback.accept(key, value);
    }
}
