    // Method to find aliases in a given list of strings
    public void findAliases(List<String> names) {
        Map<String, List<String>> aliasMap = new HashMap<>();

        for (String name : names) {
            String alias = name.substring(0, 1); // Extract the first character as alias
            if (aliasMap.containsKey(alias)) {
                aliasMap.get(alias).add(name); // Add name to existing alias list
