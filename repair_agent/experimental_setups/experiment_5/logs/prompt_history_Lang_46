public class StringUtils {
    
    /**
     * Escapes special characters in a Java-style string.
     * 
     * @param input the string to escape
     * @return the escaped string
     */
    public static String escapeJavaStyleString(String input) {
        if (input == null) {
            return null;
        }

        StringBuilder output = new StringBuilder();
        for (int i = 0; i < input.length(); i++) {
            char ch = input.charAt(i);
            switch (ch) {
                case '\n':
                    output.append("\\n");
                    break;
                case '\r':
                    output.append("\\r");
                    break;
                case '\t':
                    output.append("\\t");
                    break;
                case '\b':
                    output.append("\\b");
                    break;
                case '\f':
                    output.append("\\f");
                    break;
                case '\"':
                    output.append("\\\"");
                    break;
                case '\'':
                    output.append("\\'");
                    break;
                case '\\':
                    output.append("\\\\");
                    break;
                default:
                    if (ch < 32 || ch > 126) {
                        output.append("\\u").append(String.format("%04x", (int) ch));
                    } else {
                        output.append(ch);
                    }
            }
        }
        return output.toString();
    }
}
