          {
            "line_number": 379,
            "modified_line": "public void removeUnreferencedFunctionArgs(Node root) {\n    NodeTraversal.traverseEs6(compiler, root, new NodeTraversal.Callback() {\n        @Override\n        public boolean shouldTraverse(NodeTraversal nodeTraversal, Node n, Node parent) {\n            return true;\n        }\n\n        @Override\n        public void visit(NodeTraversal nodeTraversal, Node n, Node parent) {\n            if (n.isParamList()) {\n                Node fn = parent;\n                Set<String> referencedArgs = new HashSet<>();\n                NodeTraversal.traverseEs6(compiler, fn, new NodeTraversal.Callback() {\n                    @Override\n                    public boolean shouldTraverse(NodeTraversal nodeTraversal, Node n, Node parent) {\n                        return n != fn;\n                    }\n\n                    @Override\n                    public void visit(NodeTraversal nodeTraversal, Node n, Node parent) {\n                        if (n.isName() && n.isParam()) {\n                            referencedArgs.add(n.getString());\n                        }\n                    }\n                });\n\n                for (Node param : n.children()) {\n                    if (!referencedArgs.contains(param.getString())) {\n                        n.removeChild(param);\n                    }\n                }\n            }\n        }\n    });\n}"
          }
        ]
      }
    ]
  }
}
