              "public void decode(String encodedString) {",
              "StringBuilder decodedString = new StringBuilder();",
              "for (int i = 0; i < encodedString.length(); i++) {",
              "char currentChar = encodedString.charAt(i);",
              "if (!Character.isDigit(currentChar)) {",
              "decodedString.append(currentChar);",
              "} else {",
              "int count = Character.getNumericValue(currentChar);",
              "for (int j = 0; j < count; j++) {",
              "decodedString.append(encodedString.charAt(i - 1));",
              "}",
              "}",
              "}",
