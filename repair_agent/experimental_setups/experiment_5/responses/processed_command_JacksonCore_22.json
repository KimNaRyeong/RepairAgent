              "    protected JsonToken _nextTokenWithBuffering() throws IOException",
              "    {",
              "        while (true) {",
              "            // First: has current context of tokens been fully read?",
              "            if (_exposedContext != null) {",
              "                JsonToken t = _nextTokenInContext();",
              "                if (t != null) {",
              "                    return t;",
              "                }",
              "                // If so, need to consider closing the context",
              "                _exposedContext = _exposedContext.closeLoop(_headContext);",
              "                if (_exposedContext == null) { // done with full context?",
              "                    _currToken = null;",
              "                    return null;",
              "                }",
              "                // Otherwise move to the next token in the new context",
              "                _currToken = _headContext.nextTokenToRead();",
              "                continue;",
              "            }",
              "            // If not, need to fetch the next token",
              "            JsonToken t = _delegate.nextToken();",
              "            if (t == null) {",
              "                // Also, if EOF, might need to close any open contexts",
              "                _currToken = t;",
              "                TokenFilterContext ctxt = _headContext;",
              "                if (ctxt != null && ctxt.isStartHandled()) {",
              "                    if (!_allowMultipleMatches) {",
              "                        _headContext = ctxt.closeForPass();",
              "                        _exposedContext = _headContext;",
              "                    }",
              "                    return _nextTokenWithBuffering();",
              "                }",
              "                // If not, return null to indicate end",
              "                return null;",
              "            }",
              "            // Otherwise, filter out non-included values, if necessary",
              "            switch (_headContext.checkValue(_exposedContext, t)) {",
              "            case ALLOW_IF_MATCH:",
              "                if (_nextTokenMatch) {",
              "                    _currToken = t;",
              "                    return t;",
              "                }",
              "                continue;",
              "            case INCLUDE_ALL:",
              "                _currToken = t;",
              "                return t;",
              "            }",
              "        }",
              "    }"
            ]
          }
        ],
        "deletions": [],
        "modifications": []
      }
    ]
  }
