              "    protected JsonToken _nextTokenWithBuffering() throws IOException",
              "    {",
              "        // Let's keep track of the number of open containers",
              "        int open = 1;",
              "",
              "        // Starting with the current token, we iterate through the tokens until we find a matching end",
              "        while (open > 0) {",
              "            JsonToken t = _delegate.nextToken();",
              "            if (t == null) {",
              "                // Should never occur...",
              "                _handleEOF();",
              "                return (_currToken = null);",
              "            }",
              "            switch (t) {",
              "                case START_ARRAY:",
              "                case START_OBJECT:",
              "                    open++;",
              "                    break;",
              "                case END_ARRAY:",
              "                case END_OBJECT:",
              "                    open--;",
              "                    break;",
              "                default:",
              "                    break;",
              "            }",
              "        }",
              "",
              "        // Finally, return the last token encountered",
              "        return (_currToken = _delegate.getCurrentToken());",
              "    }"
            ]
          }
        ],
        "deletions": [],
        "modifications": []
      }
    ]
  }
