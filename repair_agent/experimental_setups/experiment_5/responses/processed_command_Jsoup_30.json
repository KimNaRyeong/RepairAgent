{
  "command_name": "write_fix",
  "arguments": {
    "project_name": "Jsoup",
    "bug_index": "30",
    "changes_dicts": [
      {
        "file_name": "org/jsoup/safety/Cleaner.java",
        "insertions": [
          {
            "line_number": 70,
            "new_lines": [
              "    public void copySafeNodes(Document source, Document dest) {",
              "        Validate.notNull(source);",
              "        Validate.notNull(dest);",
              "",
              "        List<Node> sourceNodes = source.body().childNodes();",
              "        for (Node sourceNode : sourceNodes) {",
              "            Node cleanedNode = cleanNode(sourceNode);",
              "            if (cleanedNode != null) {",
              "                dest.body().appendChild(cleanedNode);",
              "            }",
              "        }",
              "    }",
              "",
