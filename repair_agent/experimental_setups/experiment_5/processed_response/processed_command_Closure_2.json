                        {
                            "line_number": 1572,
                            "new_lines": [
                                "// Check if the given interface has conflicting properties with the base class",
                                "public void checkInterfaceConflictProperties(Node classNode, Node interfaceNode) {",
                                "Set<String> classProperties = new HashSet<>();",
                                "Node classMembers = NodeUtil.getClassMembers(classNode);",
                                "",
                                "// Get all properties of the base class",
                                "for (Node member = classMembers.getFirstChild(); member != null; member = member.getNext()) {",
                                "if (member.isMemberFunctionDef()) {",
                                "classProperties.add(member.getString());",
                                "}",
                                "}",
                                "",
                                "// Check if any property in the interface conflicts with the base class properties",
                                "Node interfaceMembers = NodeUtil.getClassMembers(interfaceNode);",
                                "for (Node member = interfaceMembers.getFirstChild(); member != null; member = member.getNext()) {",
                                "if (member.isMemberFunctionDef() && classProperties.contains(member.getString())) {",
                                "report(interfaceNode, \"Interface has conflicting property with the base class: \" + member.getString());",
                                "}",
                                "}",
                                "}"
                            ]
                        }
                    ]
                }
            ]
        }
