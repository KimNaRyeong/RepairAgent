                            "line_number": 219,
                            "new_lines": [
                                "    /**",
                                "     * Checks if a variable of type fromType can be assigned to a variable of type toType.",
                                "     * ",
                                "     * @param fromType The type of the variable to assign from",
                                "     * @param toType The type of the variable to assign to",
                                "     * @return true if fromType can be assigned to toType, false otherwise",
                                "     */",
                                "    public boolean isAssignable(Class<?> fromType, Class<?> toType) {",
                                "        if (fromType == null || toType == null) {",
                                "            return false;",
                                "        }",
                                "        ",
                                "        // If both types are the same, return true",
                                "        if (fromType.equals(toType)) {",
                                "            return true;",
                                "        }",
                                "        ",
                                "        // Check if fromType is assignable to toType",
                                "        if (toType.isAssignableFrom(fromType)) {",
                                "            return true;",
                                "        }",
                                "        ",
                                "        // Check for primitive types compatibility",
                                "        if (fromType.isPrimitive()) {",
                                "            if (fromType == int.class && (toType == Integer.class || toType == Number.class)) {",
                                "                return true;",
                                "            }",
                                "            if (fromType == long.class && (toType == Long.class || toType == Number.class)) {",
                                "                return true;",
                                "            }",
                                "            if (fromType == double.class && (toType == Double.class || toType == Number.class)) {",
                                "                return true;",
                                "            }",
                                "            if (fromType == float.class && (toType == Float.class || toType == Number.class)) {",
                                "                return true;",
                                "            }",
                                "            if (fromType == short.class && toType == Short.class) {",
                                "                return true;",
                                "            }",
                                "            if (fromType == byte.class && toType == Byte.class) {",
                                "                return true;",
                                "            }",
                                "            if (fromType == char.class && toType == Character.class) {",
                                "                return true;",
                                "            }",
                                "            if (fromType == boolean.class && toType == Boolean.class) {",
                                "                return true;",
                                "            }",
                                "        }",
                                "        ",
                                "        return false;",
                                "    }"
                            ]
                        }
