                {
                    "file_name": "src/main/java/com/fasterxml/jackson/core/io/NumberInput.java",
                    "modifications": [
                        {
                            "line_number": 296,
                            "modified_line": "public static BigDecimal parseBigDecimal(char[] digitChars, int offset, int len)\n    {\n        int scale = 0;\n        int end = offset + len;\n        int point = -1;\n        for (int i = offset; i < end; ++i) {\n            if (digitChars[i] == '.') {\n                point = i;\n            } else {\n                scale++;\n            }\n        }\n        if (point != -1) {\n            scale = scale - (end - point - 1);\n        }\n        return new BigDecimal(new String(digitChars, offset, len)).scaleByPowerOfTen(-scale);\n    }"
                        }
                    ]
                }
            ]
        }
