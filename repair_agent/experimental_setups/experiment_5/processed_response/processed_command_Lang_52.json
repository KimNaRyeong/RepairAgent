                                "    public static String escapeJavaStyleString(String input) {",
                                "        if (input == null) {",
                                "            return null;",
                                "        }",
                                "",
                                "        StringBuilder result = new StringBuilder();",
                                "        for (int i = 0; i < input.length(); i++) {",
                                "            char ch = input.charAt(i);",
                                "            switch (ch) {",
                                "                case '\"':",
                                "                    result.append(\"\\\\\\\"\");",
                                "                    break;",
                                "                case '\\\\':",
                                "                    result.append(\"\\\\\\\\\");",
                                "                    break;",
                                "                case '\\n':",
                                "                    result.append(\"\\\\n\");",
                                "                    break;",
                                "                case '\\r':",
                                "                    result.append(\"\\\\r\");",
                                "                    break;",
                                "                case '\\t':",
                                "                    result.append(\"\\\\t\");",
                                "                    break;",
                                "                case '\\b':",
                                "                    result.append(\"\\\\b\");",
                                "                    break;",
                                "                case '\\f':",
                                "                    result.append(\"\\\\f\");",
                                "                    break;",
                                "                default:",
                                "                    if (ch < ' ' || ch > '~') {",
                                "                        // Unicode representation",
                                "                        String hex = Integer.toHexString(ch);",
                                "                        result.append(\"\\\\u\");",
                                "                        for (int j = 0; j < 4 - hex.length(); j++) {",
                                "                            result.append('0');",
                                "                        }",
                                "                        result.append(hex);",
                                "                    } else {",
                                "                        result.append(ch);",
                                "                    }",
                                "            }",
                                "        }",
                                "        return result.toString();",
                                "    }"
                            ]
                        }
