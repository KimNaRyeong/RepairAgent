            "modified_line": "    public void preserveWhitespace() {\n        NodeTraversor traversor = new NodeTraversor(new NodeVisitor() {\n            @Override\n            public void head(org.jsoup.nodes.Node node, int depth) {\n                if (node instanceof TextNode) {\n                    TextNode textNode = (TextNode) node;\n                    String text = textNode.getWholeText();\n                    // Replace consecutive whitespaces with a placeholder to preserve them\n                    String preservedText = text.replaceAll(\" {2,}\", \" <ws> \");\n                    textNode.text(preservedText);\n                }\n            }\n\n            @Override\n            public void tail(org.jsoup.nodes.Node node, int depth) {\n                // Do nothing on the tail visit\n            }\n        });\n        traversor.traverse(document);\n    }"
