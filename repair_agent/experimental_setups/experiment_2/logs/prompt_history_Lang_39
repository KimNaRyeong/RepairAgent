import java.util.HashMap;
import java.util.Map;

public class StringUtils {
    
    public static String replaceEach(String text, String[] searchList, String[] replacementList) {
        if (text == null || text.isEmpty() || searchList == null || searchList.length == 0 || replacementList == null || replacementList.length == 0) {
            return text;
        }

        int searchLength = searchList.length;
        int replacementLength = replacementList.length;

        if (searchLength != replacementLength) {
            throw new IllegalArgumentException("Search and Replace array lengths don't match: " + searchLength + " vs " + replacementLength);
        }

        Map<String, String> replaceMap = new HashMap<>();
        for (int i = 0; i < searchLength; i++) {
            replaceMap.put(searchList[i], replacementList[i]);
        }

        StringBuilder result = new StringBuilder();
        StringBuilder searchStr = new StringBuilder(text);
        int searchListIndex = 0;
        int pos = 0;
        int searchLen = searchList[searchListIndex].length();
        int textLength = text.length();
        boolean overlap = false;

        while (pos < textLength) {
            if (searchListIndex >= searchLength) {
                searchListIndex = 0; // restart from the first search term
                if (overlap) {
                    searchStr.delete(0, searchLen);
                    overlap = false;
                }
            }

            String search = searchList[searchListIndex];
            String replace = replaceMap.get(search);
            int start = searchStr.indexOf(search, pos);
            if (start == -1) {
                // no more matches
                result.append(searchStr.substring(pos));
                break;
            }
            int end = start + searchLen;
            result.append(searchStr.substring(pos, start));
            result.append(replace);
            pos = end;

            searchListIndex++;
            overlap = true;
        }

        return result.toString();
    }
}
