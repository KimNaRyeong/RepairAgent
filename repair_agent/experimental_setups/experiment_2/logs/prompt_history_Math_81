    /**
     * Compute the Gershgorin circles for a given matrix.
     * A Gershgorin circle is a circle in the complex plane defined by
     * |z - a_ii| <= sum_j(|a_ij|), where a_ii is the diagonal element
     * at row i and column i, and a_ij are the off-diagonal elements at
     * row i and column j.
     *
     * @param matrix the matrix for which to compute the Gershgorin circles
     * @return an array of GershgorinCircle objects representing the circles
     */
    public static GershgorinCircle[] computeGershgorinCircles(double[][] matrix) {
        int n = matrix.length;
        GershgorinCircle[] circles = new GershgorinCircle[n];
        
        for (int i = 0; i < n; i++) {
            double radius = 0.0;
            double centerX = matrix[i][i];
            
            for (int j = 0; j < n; j++) {
                if (j != i) {
                    radius += Math.abs(matrix[i][j]);
                }
            }
            
            circles[i] = new GershgorinCircle(centerX, radius);
        }
        
        return circles;
    }
