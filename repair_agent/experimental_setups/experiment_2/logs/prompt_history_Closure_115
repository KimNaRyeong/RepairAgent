public boolean canInlineReferenceDirectly(Node callNode, Node fnNode) {
    // Check if the function node has a PARAM_LIST child
    if (!fnNode.hasChildren() || fnNode.getFirstChild().getType() != Token.PARAM_LIST) {
        return false;
    }

    // Check if the call node has the same number of children as the parameters of the function node
    int numParams = fnNode.getFirstChild().getChildCount();
    int numArgs = callNode.getChildCount();
    if (numParams != numArgs) {
        return false;
    }

    // Check if the call node has the same type as the function node
    if (fnNode.getType() != callNode.getType()) {
        return false;
    }

    // Check if the call node has the same name as the function node
    if (!fnNode.matchesQualifiedName(callNode.getQualifiedName())) {
        return false;
    }

    return true;
}
