    public boolean isValidLocaleFormat(String locale) {
        if (locale == null || locale.isEmpty()) {
            return false; // Empty string or null is not a valid locale format
        }

        String[] parts = locale.split("_");

        // Check if the language code is present and consists of only lowercase letters
        if (parts.length < 1 || !parts[0].matches("^[a-z]+$")) {
