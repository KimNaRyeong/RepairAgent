package org.apache.commons.compress.utils;

import java.io.IOException;
import java.io.InputStream;

public class BitInputStream extends InputStream {
    
    // Variables to keep track of current bit position and buffer
    private long bitBuffer = 0;
    private int bitBufferLength = 0;
    
    // Constructor
    public BitInputStream(InputStream in) {
        super(in);
    }
    
    // Method to read a specific number of bits from the input stream
    public long readBits(int numBits) throws IOException {
        long result = 0;
        
        while (numBits > 0) {
            // If the buffer is empty, read a byte from the input stream
            if (bitBufferLength == 0) {
                int nextByte = in.read();
                if (nextByte == -1) {
                    throw new IOException("Unexpected end of input");
                }
                bitBuffer = nextByte & 0xFF; // Mask to convert to unsigned byte
                bitBufferLength = 8;
            }
            
            // Calculate how many bits to read from the current buffer
            int bitsToRead = Math.min(numBits, bitBufferLength);
            
            // Shift the result to the left and append the bits read from the buffer
            result = (result << bitsToRead) | ((bitBuffer >> (bitBufferLength - bitsToRead)) & ((1 << bitsToRead) - 1));
            
            // Update the number of bits remaining to read and the buffer length
            numBits -= bitsToRead;
            bitBufferLength -= bitsToRead;
        }
        
        return result;
    }
}
