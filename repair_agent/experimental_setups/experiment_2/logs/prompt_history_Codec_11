import java.io.UnsupportedEncodingException;

public class QuotedPrintable {
    
    /**
     * Encodes a given string into Quoted-Printable format.
     * 
     * @param text the text to be encoded
     * @param charsetName the name of the character encoding to be used
     * @return the Quoted-Printable encoded string
     * @throws UnsupportedEncodingException if the specified encoding is not supported
     */
    public static String encodeQuotedPrintable(String text, String charsetName) throws UnsupportedEncodingException {
        if (text == null) {
            return null;
        }
        
        byte[] bytes = text.getBytes(charsetName);
        StringBuilder result = new StringBuilder(bytes.length * 3);
        
        for (byte b : bytes) {
            result.append('=');
            result.append(String.format("%02X", b));
        }
        
        return result.toString();
    }
}
