    public static String encodeQuotedPrintable(String text) {
        if (text == null) {
            return null;
        }

        StringBuilder encodedText = new StringBuilder();
        for (char c : text.toCharArray()) {
            if (c == '\r') {
                // Skip carriage returns
                continue;
            } else if (c == '\n') {
                // Encode line breaks
                encodedText.append("=\n");
            } else if (c == ' ' || (c >= '!' && c <= '~')) {
                // Characters that do not need encoding or need only limited encoding
                encodedText.append(c);
            } else {
                // Encode using the Quoted-Printable scheme
                encodedText.append('=').append(String.format("%02X", (int) c));
