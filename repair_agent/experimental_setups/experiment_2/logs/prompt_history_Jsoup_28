    public static String unescape(String text) {
        // Define the pattern for finding HTML entities using regex
        Pattern pattern = Pattern.compile("&(\\w+?);");
        
        // Create a matcher with the input text
        Matcher matcher = pattern.matcher(text);
        
        // Create a StringBuilder to store the unescaped text
        StringBuilder result = new StringBuilder();
        
        // Loop through the matches and replace HTML entities with their corresponding characters
        while (matcher.find()) {
            String entity = matcher.group(1);
            String replacement;
            // Check if the entity is a known HTML entity and replace it
            if (Entities.isBaseNamedEntity(entity)) {
                replacement = Entities.getCharacterByName(entity).toString();
            } else {
                // If the entity is not known, keep it as is
                replacement = "&" + entity + ";";
            }
            matcher.appendReplacement(result, Matcher.quoteReplacement(replacement));
        }
        
        // Append the remaining part of the input text after the last match
        matcher.appendTail(result);
        
        // Return the unescaped text as a string
        return result.toString();
    }
