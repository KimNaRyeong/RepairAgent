public void detectImplicitPrototypeCycle(Node node) {
    Set<Node> visited = new HashSet<>();
    Stack<Node> stack = new Stack<>();
    stack.push(node);

    while (!stack.isEmpty()) {
        Node current = stack.pop();
        visited.add(current);

        for (Node neighbor : current.getNeighbors()) {
            if (!visited.contains(neighbor)) {
                stack.push(neighbor);
            } else {
                if (neighbor.equals(node)) {
                    throw new RuntimeException("Implicit prototype cycle detected!");
                }
            }
        }
    }
}
