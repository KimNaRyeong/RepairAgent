    /**
     * Chooses initial centers for the KMeans clustering algorithm.
     *
     * @param data the data points to be clustered
     * @param k the number of clusters
     * @return an array of initial centers
     */
    public void chooseInitialCenters(double[][] data, int k) {
        Random random = new Random();
        int[] chosenIndices = new int[k];
        double[][] centers = new double[k][data[0].length];
        
        // Choose random indices for initial centers
        for (int i = 0; i < k; i++) {
            int randomIndex = random.nextInt(data.length);
            while (Arrays.asList(chosenIndices).contains(randomIndex)) {
                randomIndex = random.nextInt(data.length);
            }
            chosenIndices[i] = randomIndex;
            centers[i] = data[randomIndex];
        }
        
