public class ContextualRenameInverter {
    
    // Method to invert a map of contextual rename operations
    public void invertContextualRename(Map<String, String> contextualRename) {
        // Create a new map to store the inverted rename operations
        Map<String, String> invertedContextualRename = new HashMap<>();
        
        // Iterate over the entries in the original map
        for (Map.Entry<String, String> entry : contextualRename.entrySet()) {
            // Swap the key and value in each entry to invert the rename operation
            invertedContextualRename.put(entry.getValue(), entry.getKey());
        }
        
        // Replace the original map with the inverted rename operations
        contextualRename.clear();
        contextualRename.putAll(invertedContextualRename);
    }
}
