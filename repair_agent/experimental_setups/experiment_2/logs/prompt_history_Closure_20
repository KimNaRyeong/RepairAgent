public void tryFoldSimpleFunctionCall(Node callNode) {
    // Check if the callNode is a CALL node
    if (callNode.getToken() != Token.CALL) {
        return;
    }

    // Get the function name node
    Node target = callNode.getFirstChild();
    
    // Check if the function name node is a NAME node
    if (target.getToken() != Token.NAME) {
        return;
    }

    // Get the function name
    String functionName = target.getString();
    
    // Check if the function name is "Math.sqrt"
    if (!functionName.equals("Math.sqrt")) {
        return;
    }

    // Get the argument node
    Node argument = target.getNext();
    
    // Check if the argument node exists
    if (argument == null) {
        return;
    }

    // Check if the argument node is a NUMBER node
    if (argument.getToken() != Token.NUMBER) {
        return;
    }

    // Get the argument value
    double argValue = argument.getDouble();

    // Calculate the square root of the argument value
    double result = Math.sqrt(argValue);

    // Replace the function call node with the result
    callNode.getParent().replaceChild(callNode, Node.newNumber(result));
}
