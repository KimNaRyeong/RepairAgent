public class AliasFinder {
    // Method to find aliases in a given list of strings
    public void findAliases(String[] strings) {
        // Map to store unique characters found in the strings along with their indices
        Map<Character, Set<Integer>> charIndices = new HashMap<>();

        // Iterate through each string in the input array
        for (int i = 0; i < strings.length; i++) {
            String currentString = strings[i];
            // Iterate through each character in the current string
            for (int j = 0; j < currentString.length(); j++) {
                char currentChar = currentString.charAt(j);
                // If the character is already present in the map, add the index to the existing set
                if (charIndices.containsKey(currentChar)) {
                    charIndices.get(currentChar).add(i);
                } else {
                    // If the character is not present in the map, create a new set with the index
                    Set<Integer> indices = new HashSet<>();
                    indices.add(i);
                    charIndices.put(currentChar, indices);
                }
            }
        }

        // Print out the characters that have aliases (appear in more than one string)
        for (Map.Entry<Character, Set<Integer>> entry : charIndices.entrySet()) {
            if (entry.getValue().size() > 1) {
                System.out.println("Character '" + entry.getKey() + "' has aliases in strings: " + entry.getValue());
