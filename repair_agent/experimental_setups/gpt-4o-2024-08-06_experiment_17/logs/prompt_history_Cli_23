    /**
     * Find the wrap position in the given input line.
     * @param text The input line to find the wrap position in.
     * @param startPos The starting position to search for wrap position from.
     * @param columnWidth The width of the column to wrap at.
     * @return The wrap position in the input line.
     */
    public int findWrapPos(String text, int startPos, int columnWidth) {
        // If the position is less than or equal to the column width, just return the column width
        if (startPos <= columnWidth) {
            return columnWidth;
        }
        
        // Find the last space within the column width to wrap at
        int pos = columnWidth;
        while (pos >= startPos) {
            if (Character.isWhitespace(text.charAt(pos))) {
                return pos;
            }
            pos--;
        }
        
        // If no space found, just return the column width
        return columnWidth;
    }
