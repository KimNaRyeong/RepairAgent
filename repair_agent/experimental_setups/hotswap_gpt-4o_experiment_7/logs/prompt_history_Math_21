import org.apache.commons.math3.linear.RealMatrix;

public class RectangularCholeskyDecomposition {

    private final RealMatrix l;
    private final double tolerance;

    public RectangularCholeskyDecomposition(RealMatrix matrix, double tolerance) {
        if (!matrix.isSquare()) {
            throw new IllegalArgumentException("Matrix is not square");
        }

        int m = matrix.getRowDimension();
        int n = matrix.getColumnDimension();

        if (m < n) {
            throw new IllegalArgumentException("Matrix is not rectangular");
        }

        this.tolerance = tolerance;
        this.l = matrix.copy();

        for (int i = 0; i < n; i++) {
            double l_ii = this.l.getEntry(i, i);
            if (l_ii <= 0.0) {
                throw new IllegalArgumentException("Matrix is not positive definite");
            }
            this.l.setEntry(i, i, Math.sqrt(l_ii));
            for (int j = i + 1; j < m; j++) {
                this.l.setEntry(j, i, this.l.getEntry(j, i) / this.l.getEntry(i, i));
            }
            for (int j = i + 1; j < n; j++) {
                for (int k = j; k < n; k++) {
                    double l_ji = this.l.getEntry(j, i);
                    double l_ki = this.l.getEntry(k, i);
                    double l_jk = this.l.getEntry(j, k) - l_ji * l_ki;
                    this.l.setEntry(k, j, l_jk / this.l.getEntry(j, j));
                }
            }
        }
    }

}
