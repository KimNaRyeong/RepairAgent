import org.apache.commons.math3.linear.RealMatrix;

public class RectangularCholeskyDecomposition {
    private final RealMatrix root;
    private final double norm;

    // Constructor to perform the rectangular Cholesky decomposition
    public RectangularCholeskyDecomposition(RealMatrix matrix, double small) {
        if (!matrix.isSquare()) {
            throw new IllegalArgumentException("Matrix is not square");
        }

        int m = matrix.getRowDimension();
        int n = matrix.getColumnDimension();

        double[][] rawData = matrix.getData();
        double[][] rootData = new double[m][n];
        double[] d = new double[Math.min(m, n)];

        for (int j = 0; j < n; j++) {
            for (int i = 0; i < m; i++) {
                double sum = rawData[i][j];
                for (int k = 0; k < j; k++) {
                    sum -= rootData[i][k] * rootData[k][j];
                }
                if (i < j) {
                    rootData[i][j] = sum / rootData[i][i];
                } else if (i == j) {
                    if (sum <= small) {
                        throw new IllegalArgumentException("Matrix is not positive definite");
                    }
                    d[i] = Math.sqrt(sum);
                    rootData[i][j] = d[i];
                } else {
                    rootData[i][j] = 0.0;
                }
            }
        }

        this.root = matrix.copy();
        this.root.setData(rootData);
        this.norm = computeNorm(d);
    }

    // Helper method to compute the norm of the diagonal elements
    private double computeNorm(double[] diagonal) {
        double sum = 0.0;
        for (double d : diagonal) {
            sum += d * d;
        }
        return Math.sqrt(sum);
    }
}
