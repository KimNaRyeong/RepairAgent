    public static String unescape(String input) {
        Map<String, String> escapeMap = new HashMap<>();
        escapeMap.put("lt", "<");
        escapeMap.put("gt", ">");
        escapeMap.put("amp", "&");
        escapeMap.put("quot", "\"");
        escapeMap.put("apos", "'");
        
        String regex = "&(#?)([a-zA-Z0-9]+);";
        Pattern pattern = Pattern.compile(regex);
