    /**
     * Unescape an HTML entity.
     *
     * @param string String containing HTML entity to unescape
     * @return String with HTML entity unescaped
     */
    public static String unescape(String string) {
        // Matcher to find HTML entities
        Matcher matcher = pattern.matcher(string);

        // StringBuilder to store unescaped string
        StringBuilder sb = new StringBuilder();

        // Loop through the string and replace HTML entities with corresponding characters
        while (matcher.find()) {
            String match = matcher.group(2);
            char replacement;
            if (match.charAt(0) == '#') {
                // Numeric entity
                String num = match.substring(1);
                if (num.startsWith("x")) {
                    // Hexadecimal
                    replacement = (char) Integer.parseInt(num.substring(1), 16);
                } else {
