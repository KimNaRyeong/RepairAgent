                }
            } else {
                // Named entity
                replacement = escapeMap.getOrDefault(match, (char) 0);
            }
            matcher.appendReplacement(sb, String.valueOf(replacement));
        }
        matcher.appendTail(sb);

        return sb.toString();
    }
