    "changes_dicts": [
      {
        "file_name": "org/jsoup/select/QueryParser.java",
        "insertions": [
          {
            "line_number": 67,
            "new_lines": [
              "private Evaluator parseOr() {",
              "    Evaluator left = parseAnd();",
              "    while (tq.matchesAny(\",\")) {",
              "        tq.consume(); // consume the \",\"",
              "        Evaluator right = parseAnd();",
              "        left = new CombiningEvaluator.Or(left, right);",
              "    }",
              "    return left;",
              "}",
              "",
              "private Evaluator parseAnd() {",
              "    Evaluator left = parseCondition();",
              "    while (!tq.isEmpty() && !tq.matchesAny(combinators)) {",
              "        Evaluator right = parseCondition();",
              "        left = new CombiningEvaluator.And(left, right);",
              "    }",
              "    return left;",
              "}",
              "",
              "private Evaluator parseCondition() {",
              "    if (tq.matchChomp(\"not\")) {",
              "        return new StructuralEvaluator.Not(parseCondition());",
              "    } else if (tq.matchChomp(\":lt\")) {",
              "        return new StructuralEvaluator.IndexLessThan(consumeIndex());",
              "    } else if (tq.matchChomp(\":gt\")) {",
