              "private Evaluator parseSingle() {",
              "    if (tq.matchChomp(\"*\")) {",
              "        return new Evaluator.AllElements();",
              "    } else if (tq.matchChomp(\"#\")) {",
              "        return new Evaluator.Id(tq.consumeTo(\" >\"));",
              "    } else if (tq.matchChomp(\".\")) {",
              "        return new Evaluator.Class(tq.consumeTo(\" >\"));",
              "    } else if (tq.matchesWord()) {",
              "        return new Evaluator.Tag(tq.consumeTo(\" >\"));",
              "    } else if (tq.matches(\"(\")) {",
              "        tq.consume();",
              "        Evaluator eval = parse();",
              "        tq.matchChomp(\")\");",
              "        return eval;",
              "    } else {",
              "        throw new Selector.SelectorParseException(\"Could not parse query '%s': unexpected token at '%s'\", query, tq.remainder());",
              "    }",
              "}"
            ]
          }
        ],
        "deletions": [],
        "modifications": [
