            "line_number": 726,
            "new_lines": [
              "    public void renderWrappedText(String text, int width) {",
              "        StringBuilder sb = new StringBuilder();",
              "        int start = 0;",
              "        int end = 0;",
              "",
              "        while (end < text.length()) {",
              "            end = start + width;",
              "            if (end >= text.length()) {",
              "                end = text.length();",
              "            } else {",
              "                while (end > start && !Character.isWhitespace(text.charAt(end))) {",
              "                    end--;",
              "                }",
              "                if (end == start) {",
              "                    end = start + width;",
              "                }",
              "            }",
              "",
              "            sb.append(text, start, end).append(\"\\n\");",
              "            start = end + 1;",
              "        }",
              "",
              "        System.out.println(sb.toString());",
              "    }"
            ]
          }
        ],
