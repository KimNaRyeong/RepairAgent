          {
            "line_number": 937,
            "new_lines": [
              "    public static int findWrapPos(String text, int pos, int width) {",
              "        int currentPos = Math.min(pos + width, text.length());",
              "        int wrapPos = currentPos;",
              "        while (wrapPos > pos && !Character.isWhitespace(text.charAt(wrapPos))) {",
              "            wrapPos--;",
              "        }",
              "        if (wrapPos == pos) {",
              "            return currentPos;",
              "        }",
              "        return wrapPos + 1;",
              "    }"
            ]
          }
        ]
      }
    ]
  }
}
